#!/usr/bin/env python3
"""away-merge: the only way a project coordinator merges into its away branch (away-improve mode; design:
docs/superpowers/specs/2026-11-23-away-improve-design.md).

  away-merge --project NAME --pr N --item "<title>" [--local-suite-ok LOG] [--metric "<text>"]
  away-merge --maintenance --project NAME --pr N --item "<title>" [--metric "<text>"]

Merges PR N into the project's active away/<date> branch as a merge commit titled `away: <item>` (never squashed), whose
message body is `Pull request #N` and the item's log entry, copied from the PR's body, and prints the merge commit; a PR that is
still a draft is marked ready first (GitHub refuses to merge a draft), never the summary PR; it also records the merge (what --max-items counts),
closes the project's cycle into the ledger (`lane-improve cycle`: item, PR, merge sha, review rounds, and --metric, a short
measured change such as "tests 412 -> 431") and refreshes the draft summary PR. It refuses,
merging nothing, with one line per failed check, unless all of these hold:
  improve    improve mode is on for NAME (core/improve.py), which names the project's away branch; or it is draining
             (`lane-improve off` or the end time, until `lane-improve drained NAME`): the running lane's last PR still merges
  base       the PR's base is exactly that branch: never main, develop or another project's away branch
  open       the PR is open
  review     a comment on the PR, by the gh login running this script, says `Review: passed <head sha>` for the PR's
             current head commit (the coordinator writes it after the reviewer's clean round; the PR body never
             counts). A push after the review needs a new review. That a lane never writes it or runs away-merge is a
             rule of the skill, not something one gh identity can enforce.
  entry      the PR's body has the log entry, one section per heading: What, Why, Builds on, Existing work checked, How to try
             it, How to drop it, Tests (any heading level, none empty). The refusal is one line naming what is missing.
             The entry is what goes into the merge commit message and, from there, into the summary PR (core/improve.py)
  ci         every check on the PR passed, or --local-suite-ok is the path of the log of the full suite run through
             lane-heavy, whose last line shows a pass (OK, N passed; any other string, a missing or empty file or a
             failing end is refused). Use it only when CI itself is failing or unavailable for reasons outside the
             change; the log's last line is printed, and the PR body's Tests section must say so
  secrets    the diff is clean: gitleaks when the project has a .gitleaks.toml (no gitleaks to run it is a refusal),
             otherwise a built-in scan of the added lines (every one, `++` lines too) for keys, tokens, home paths,
             private addresses and credentials file names
  names      the public-repo rule, for a public repo only (`gh repo view`; a private repo is not checked and the merge
             says so; one whose visibility cannot be read is a refusal): the added lines and the path of every added or renamed-to file hold no
             hostname or user name of this machine, no name of another project whose repo is private (a public
             project's name is no secret; the project's own name is allowed; a project whose visibility cannot be read
             counts as private) and no name from the private-names file outside the repo (core/privatenames.py). Runs
             with or without a .gitleaks.toml. A hit says its kind, file and line, never the name; a names file that
             cannot be read, or no name to check at all, is a refusal; a merge prints what the scan checked
  caps       the project has not wrapped up at a cap (`lane-improve drained` while the mode is on: nothing more merges), --max-items
             is not yet reached (the Nth merge is the last), and the period's record (improve-period.json) can be read (a lost
             or unreadable one refuses every merge: `lane-improve on --continue` makes it again; while draining,
             `lane-improve drained`, then `on --continue`)
  deny       the PR touches none of improve.json's deny_paths: every old and new path in the `diff --git` headers of
             the PR's diff is checked (gh's file list stops at 100 files and drops a rename's old name); a diff it
             cannot read paths from is a refusal
  gate       the owner's gate hooks (core/hooks.py: the machine's and the project's, from the checkout's settings
             store) pass for the PR at the head that was checked, after every check above passed; each is said with its
             exit code and last lines. None is a pass. A hook that fails, times out or changed since it was added refuses
After the merge the owner's after-merge hooks run with the PR, its head and the merge commit; one that fails only
warns (the merge stands).
The merge is `--match-head-commit <the head that was reviewed and scanned>`, and the head is read again after the diff,
so a push in between is refused. The project's checkout is its coordinator's, from machine.conf. gh is called read-only
except for the merge itself and, after it, the project's draft summary PR (away/<date> -> the integration branch): its body is
rebuilt from the branch's merge commits, keeping the coordinator's summary (a REST PATCH, `gh pr edit` only when that fails), and it is opened as a draft (`gh pr create --draft`) when it does not exist.
That PR is never merged by an agent; a failure there does not undo the merge (stderr says so, and names `lane-improve pr`).

--maintenance (the period's `lane-control ratchet on --maintenance [docs,tests]`; design:
docs/superpowers/specs/2026-11-27-ratchet-maintenance-merges-design.md) merges a maintenance item into the project's
integration branch instead, while the mode is on (never while draining or after its end): a PR whose every change the period's
kinds allow (core/maintenance.py: docs, the default, is content files under docs/ and the root README.md and CHANGELOG.md;
tests, only when named, is NEW test files under tests/), inside the project's own `maintenance_paths` when it has them (they
only narrow), and never an agent instruction, CI or tooling file, a symlink, submodule, executable, a binary other than a docs
image, or a name with a control character. Every check above holds, with the integration branch as the base and without
--local-suite-ok (CI must be green on the head); and also:
  maintenance  the mode is on (not draining) and takes maintenance merges, the project's maintenance_paths can be used, and
               every file GitHub lists for the compare <integration>...<head sha> (with its status: added, modified, ...) and
               every path in the diff is maintenance. A refusal here names the way the item goes to the away branch as today
               (`gh pr edit <n> --base away/<date>`, then away-merge without it)
  head         the PR's head is not an away/* branch (the summary PR), not the summary PR and not from a fork
  protection   the integration branch's protection (classic or a ruleset) requires no review the coordinator cannot give,
               and can be read
  take-in      the away branch holds every earlier maintenance merge (read from git, whatever the period, and from the record)
  changed      under the lock, the mode, the kinds, the deny paths and the project's branches are what the checks saw
The merge is titled `maintenance: <item>`, its message `Pull request #N`, `Ratchet-maintenance: <away branch>` and the entry.
Right after it the away branch takes the integration branch in: a merge commit of the maintenance merge into away/<date>,
pushed without force (never a rebase). A conflict, or a push that fails, is reported and forced through by nothing (exit 3);
the next maintenance merge waits until a lane has brought it in.
Exit: 0 merged; 1 refused or could not be checked; 2 usage; 3 merged into the integration branch, but the away branch did not
take it in (said on stderr).
"""
import argparse
import datetime as dt
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
import hooks  # noqa: E402
import improve  # noqa: E402
import maintenance  # noqa: E402
import protection  # noqa: E402
import machineconf  # noqa: E402
import privatenames  # noqa: E402
from textscan import (as_diff, HEADER, PRIVATE, Refuse, _unquote, added_lines, gh, is_public, name_check, names_scan,  # noqa: E402,F401
                      new_paths, scan_added, secret_scan)

AWAY_BRANCH = re.compile(r"away/\d{4}-\d{2}-\d{2}")
MARKER = re.compile(r"^\s*Review: passed ([0-9a-f]{40})\s*$", re.M)
GREEN = {"SUCCESS", "NEUTRAL", "SKIPPED"}


glob_re = maintenance.glob_re


def diff_paths(diff: str) -> "set | None":
    """Every old and new path named in the `diff --git` headers of a diff (a rename gives both); None when it has no
    header at all."""
    found = set()
    for m in HEADER.finditer(diff):
        old = _unquote(m.group(1)) if m.group(1) is not None else m.group(2)
        new = _unquote(m.group(3)) if m.group(3) is not None else m.group(4)
        found.update((old, new))
    for m in re.finditer(r"^rename (?:from|to) (.+)$", diff, re.M):
        found.add(_unquote(m.group(1)[1:-1]) if m.group(1).startswith('"') else m.group(1))
    return found or None


SUITE_PASS = re.compile(r"^OK\b|\bpassed\b|\b0 failures\b", re.I)
SUITE_FAIL = re.compile(r"\b(fail(ed|ures?)?|errors?)\b", re.I)


def suite_log_end(ref):
    """(last line, "") when `ref` is a log file of a suite run that ends passing; ("", why not) otherwise. --local-suite-ok
    used to take any string, so it bypassed red CI for free."""
    if not ref:
        return "", "--local-suite-ok needs the path of the suite's log"
    f = Path(ref)
    try:
        lines = [l.strip() for l in f.read_text(errors="replace").splitlines() if l.strip()] if f.is_file() else []
    except OSError:
        lines = []
    if not lines:
        return "", f"{ref} is not a readable, non-empty log file"
    last = lines[-1]
    if SUITE_FAIL.search(last) or not SUITE_PASS.search(last):
        return "", f"the log's last line does not show a passing run: {last[:80]}"
    return last[:120], ""


def ci_green(rollup: list) -> "str | None":
    """None when every check passed; else why not."""
    if not rollup:
        return "no checks are reported on the PR"
    if all(str(c.get("conclusion") or c.get("state") or "").upper() == "SKIPPED" for c in rollup):
        return "every check was skipped, none passed"
    bad = []
    for c in rollup:
        verdict = c.get("conclusion") or c.get("state") or c.get("status") or ""
        if str(verdict).upper() not in GREEN:
            bad.append(f"{c.get('name') or c.get('context') or 'a check'}: {str(verdict).lower() or 'not finished'}")
    return "; ".join(bad) or None


def run(a) -> int:
    item = " ".join(a.item.split())
    if not item:
        print("away-merge: --item needs a title", file=sys.stderr)
        return 2
    if a.metric is not None and len(a.metric) > improve.ITEM_LIMIT:
        print(f"away-merge: --metric is a short line (at most {improve.ITEM_LIMIT} characters)", file=sys.stderr)
        return 2
    maint = bool(a.maintenance)
    if maint and a.local_suite_ok is not None:
        print("away-merge: --maintenance merges into the integration branch, so CI must be green on the head: "
              "--local-suite-ok is for the away branch only", file=sys.stderr)
        return 2
    failed = []

    def refuse(check: str, why: str):
        failed.append(f"away-merge: refused ({check}): {why}")

    state, mode = improve.merge_state(a.project)
    checked = dict(state or {})  # the period as the checks saw it (settings_moved compares it under the lock)
    branch = None
    if state is None:
        refuse("improve", mode)
    else:
        branch = state["branches"].get(a.project)
        if not branch:
            refuse("improve", f"{a.project} has no away branch recorded in the improve file (a project set up after the "
                              f"mode started: tell the owner to run `lane-improve on --continue --project {a.project}`)")
        elif not AWAY_BRANCH.fullmatch(branch) or branch == state["integration"].get(a.project):
            refuse("improve", f"the branch recorded for {a.project} ({branch!r}) is not an away/<date> branch, or is its "
                              "integration branch: away-merge merges only into away branches, never into main or develop")
            branch = None
    target = branch  # where the PR goes: the away branch, or the integration branch for a maintenance merge
    integ = state["integration"].get(a.project, "") if state else ""
    if maint and branch:
        if mode != "on":  # M3: `off` and the end time stop writes to main; the drain is for the last PR into the away branch
            refuse("maintenance", f"improve mode is {mode} for {a.project} (`ratchet off` or its end time): maintenance merges "
                                  f"into the integration branch have stopped; the item goes to the away branch as any item: "
                                  f"`gh pr edit {a.pr} --base {branch}`, then away-merge without --maintenance")
            target = None
        elif state.get("maintenance") and (cap := cap_hit(state, a.project)):  # m2: a soft cap stops writes to main
            refuse("maintenance", f"a cap is reached for {a.project} ({cap}): maintenance merges into the integration branch "
                                  "stop at a cap (only the running lane's PR still lands, on the away branch); the item goes "
                                  f"to the away branch as any item: `gh pr edit {a.pr} --base {branch}`, then away-merge "
                                  "without --maintenance")
            target = None
        elif not state.get("maintenance"):
            refuse("maintenance", f"the period takes no maintenance merges (the owner switches them on with `lane-control ratchet "
                                  f"on --continue --maintenance`); the item goes to the away branch as any item: "
                                  f"`gh pr edit {a.pr} --base {branch}`, then away-merge without --maintenance")
            target = None
        elif not integ or AWAY_BRANCH.fullmatch(integ) or integ.startswith("away/"):
            refuse("maintenance", f"the integration branch recorded for {a.project} ({integ!r}) cannot take a maintenance merge")
            target = None
        else:
            target = integ
    try:
        cos = {c.name: c for c in machineconf.coordinators(machineconf.load())}
    except machineconf.ConfError as e:
        print(f"away-merge: refused: {e}", file=sys.stderr)
        return 1
    if a.project not in cos:
        print(f"away-merge: refused: {a.project} is not a coordinator in machine.conf "
              f"({', '.join(cos) or 'none'})", file=sys.stderr)
        return 1
    checkout = cos[a.project].checkout
    if not branch or not target:
        print("\n".join(failed), file=sys.stderr)
        return 1
    fallback = (f"; it goes to the away branch as any item: `gh pr edit {a.pr} --base {branch}`, then away-merge without "
                "--maintenance (whose own checks then apply)")
    try:
        pr = json.loads(gh(["pr", "view", str(a.pr), "--json", "baseRefName,headRefOid,state,body,isDraft,comments,statusCheckRollup,files"
                            + (",headRefName,isCrossRepository" if maint else "")], checkout))
        diff = gh(["pr", "diff", str(a.pr)], checkout)
        head_now = json.loads(gh(["pr", "view", str(a.pr), "--json", "headRefOid"], checkout)).get("headRefOid")
    except (Refuse, ValueError) as e:
        print(f"away-merge: refused: PR {a.pr} cannot be read ({e})", file=sys.stderr)
        return 1
    head = pr.get("headRefOid") or ""
    if not re.fullmatch(r"[0-9a-f]{40}", head):
        print(f"away-merge: refused: PR {a.pr} has no readable head commit", file=sys.stderr)
        return 1
    if head_now != head:
        refuse("head", f"PR {a.pr} was pushed to while it was being checked ({head[:7]} then {str(head_now)[:7]}); run again")
    if maint and pr.get("baseRefName") != target:
        refuse("base", f"PR {a.pr} goes into {pr.get('baseRefName')!r}, not {a.project}'s integration branch {target!r}: a "
                       "maintenance merge goes only there")
    elif not maint and pr.get("baseRefName") != branch:
        refuse("base", f"PR {a.pr} goes into {pr.get('baseRefName')!r}, not {a.project}'s away branch {branch!r}; "
                       "away-merge never merges anywhere else")
    if maint:
        head_ref = str(pr.get("headRefName") or "")
        if head_ref.startswith("away/") or a.pr == state.get("prs", {}).get(a.project):
            refuse("head", f"PR {a.pr} is from an away branch ({head_ref or 'the summary PR'}): the away branch reaches "
                           f"{target} only when the owner merges the summary PR")
        if pr.get("isCrossRepository") is not False:
            refuse("head", f"PR {a.pr} is from a fork (or that cannot be read): a maintenance merge takes only a lane's PR from "
                           "this repository")
    if str(pr.get("state", "")).upper() != "OPEN":
        refuse("open", f"PR {a.pr} is {str(pr.get('state')).lower()}, not open")
    try:
        login = gh(["api", "user", "-q", ".login"], checkout).strip()
    except Refuse:
        login = ""
    reviewed = bool(login) and any(
        (c.get("author") or {}).get("login") == login and head in MARKER.findall(c.get("body") or "")
        for c in pr.get("comments") or [])
    if not reviewed:
        refuse("review", f"no comment by {login or '(the gh login could not be read)'} says `Review: passed {head}` "
                         f"for PR {a.pr}'s current head (the coordinator writes it after the reviewer's clean round; "
                         "the PR body never counts; a push after the review needs a new one)")
    entry, absent, empty = improve.entry_problems(pr.get("body"))
    if absent or empty:
        refuse("entry", f"PR {a.pr}'s body has no log entry for: "
                        + "; ".join(x for x in (f"no such heading: {', '.join(absent)}" if absent else "",
                                                 f"empty, or still the template's placeholder: {', '.join(empty)}" if empty else "") if x)
                        + " (each is a `#` heading at the start of a line, with real text under it; see the away build brief)")
    elif reviewed:
        why_edited = edited_after_review(checkout, a.pr, pr.get("comments") or [], login, head)
        if why_edited:
            refuse("entry", why_edited)
    why = ci_green(pr.get("statusCheckRollup") or [])
    suite_line = ""
    if why:
        suite_line, bad = suite_log_end(a.local_suite_ok)
        if bad:
            refuse("ci", f"{why} (CI must be green; or, when CI itself is failing for reasons outside the change, "
                         f"pass --local-suite-ok <log of the full suite run through lane-heavy> and note it in the PR body's Tests section; {bad})")
    hit = secret_scan(checkout, diff)
    if hit:
        refuse("secrets", hit)
    hit, name_line = name_check(a.project, cos, diff)
    if hit:
        refuse("names", hit)
    # what away-merge itself publishes: the --item title (the merge subject) and the log entry (the merge message), which no
    # diff holds, go through the same scans before anything is merged
    published = as_diff({"item-title": item, "PR-body-entry": entry})
    hit = secret_scan(checkout, published)
    if hit:
        refuse("entry", f"{hit.replace('the diff adds', 'the --item title or the PR body entry adds')}")
    hit, _ = name_check(a.project, cos, published)
    if hit:
        refuse("entry", f"{hit.replace('the diff adds', 'the --item title or the PR body entry adds')}")
    paths = diff_paths(diff)
    if paths is None or (pr.get("files") and not paths):
        refuse("deny", "the PR's diff has no `diff --git` headers to read paths from, so the deny paths cannot be checked")
    else:
        for g, rx in [(g, glob_re(g)) for g in state["deny_paths"]]:
            for f in sorted(paths):
                if rx.fullmatch(f):
                    refuse("deny", f"{f} matches the owner's deny path {g}")
    pglobs = None
    if maint:
        pglobs = maintenance_checks(a, checkout, state, target, branch, head, diff, paths, refuse, fallback)
    if failed:
        print("\n".join(failed), file=sys.stderr)
        return 1
    if a.pr == state.get("prs", {}).get(a.project):
        print(f"away-merge: refused (summary): PR {a.pr} is {a.project}'s draft summary PR, which only the owner merges",
              file=sys.stderr)
        return 1
    facts = {"project": a.project, "project_root": str(checkout), "repo": str(checkout), "pr": a.pr, "head_sha": head}
    try:
        entries = hooks.X.effective(hooks.X.store_for(checkout))
        gates = hooks.X.hooks_for(entries, "gate")
        if gates:
            total = sum(int(e.get("timeout") or hooks.X.HOOK_TIMEOUT) for e in gates)
            print(f"away-merge: running {len(gates)} of the owner's gate hook(s) for PR {a.pr} at {head}, up to "
                  f"{total} s in all", flush=True)
        res = hooks.run(entries, "gate", facts)
    except hooks.X.ExtrasError as e:
        print(f"away-merge: refused (gate): the gate hooks cannot be read ({e})", file=sys.stderr)
        return 1
    for line in hooks.report(res):
        print(f"away-merge: gate: {line}")
    if hooks.failed(res):
        print(f"away-merge: refused (gate): {len(hooks.failed(res))} of {len(res)} of the owner's gate hooks did not "
              f"pass for PR {a.pr} at {head} (above): not green", file=sys.stderr)
        for line in hooks.way_past(res, "gate", ""):
            print(f"away-merge: {line} (away-merge has no --skip-hook: the owner decides)", file=sys.stderr)
        return 1
    # The cap is counted, the merge made and the merge recorded under one hold of the improve lock (lc-jpg): two merges at
    # once cannot both see the last free slot. The state is read again under the lock, so a cap reached while the checks
    # above ran refuses this merge.
    with improve._locked():
        state, mode = improve.merge_state(a.project)
        if state is None:
            print(f"away-merge: refused (improve): {mode}", file=sys.stderr)
            return 1
        # what the checks above relied on must still hold (the gates can run for minutes, and the owner may change the period)
        moved = settings_moved(checked, state, mode, a.project, maint)
        if maint and not moved:
            moved = maintenance_again(checkout, state, a.project, branch, target, pglobs)
        if moved:
            print("\n".join(f"away-merge: refused (changed): {c}" for c in moved), file=sys.stderr)
            return 1
        if res:  # the gates ran for minutes: the PR is read again, and merged only as it was gated
            changed = still_as_checked(checkout, a.pr, pr, target, login, head, ci_was_green=not why)
            if changed:
                print("\n".join(f"away-merge: refused (changed): {c}" for c in changed), file=sys.stderr)
                return 1
        sha = None
        if pr.get("isDraft"):
            try:
                gh(["pr", "ready", str(a.pr)], checkout)
            except Refuse as e:
                print(f"away-merge: refused (ready): PR {a.pr} is a draft and could not be marked ready ({e}); nothing merged",
                      file=sys.stderr)
                return 1
            print(f"away-merge: PR {a.pr} was a draft: marked it ready to merge")
        line = f"{maintenance.LINE}{branch}\n" if maint else ""
        message = f"Pull request #{a.pr}\n{line}\n{entry}".replace("\x1e", "").replace("\x1f", "").replace("\x00", "")
        # the message goes through a file, never argv (a long or non-ASCII entry would hit the argument size limit)
        with tempfile.NamedTemporaryFile("w", prefix="away-merge-msg-", suffix=".txt", delete=False, encoding="utf-8") as fh:
            fh.write(message)
        try:
            try:
                subject = f"{maintenance.SUBJECT}{item}" if maint else f"away: {item}"
                gh(["pr", "merge", str(a.pr), "--merge", "--subject", subject, "--body-file", fh.name, "--match-head-commit", head], checkout)
            finally:
                Path(fh.name).unlink(missing_ok=True)
        except Refuse as e:
            # gh can fail after GitHub merged (a timeout, a 5xx): look once, and count the merge when it happened
            try:
                seen = json.loads(gh(["pr", "view", str(a.pr), "--json", "state,mergeCommit"], checkout))
                merged = str(seen.get("state", "")).upper() == "MERGED"
                sha = ((seen.get("mergeCommit") or {}).get("oid") or "") if merged else None
            except (Refuse, ValueError, AttributeError):
                sha = None
            if sha is None:
                print(f"away-merge: the merge did not go through: {e}" + (
                    f" (PR {a.pr} was marked ready before and stays ready)" if pr.get("isDraft") else ""), file=sys.stderr)
                return 1
            print(f"away-merge: gh reported a failure ({e}) but PR {a.pr} is merged on GitHub; counting it", file=sys.stderr)
        if sha is None:
            try:
                sha = gh(["pr", "view", str(a.pr), "--json", "mergeCommit", "-q", ".mergeCommit.oid"], checkout).strip()
            except Refuse as e:  # merged, so it is counted; only its commit is unknown
                sha = ""
                print(f"away-merge: the merge commit could not be read ({e}); recording the merge without it", file=sys.stderr)
        print(f"away-merge: merged PR {a.pr} into {target} as {sha or '(commit unknown)'}: "
              f"{maintenance.SUBJECT if maint else 'away: '}{item}", flush=True)
        if name_line:
            print(f"away-merge: {name_line}")
        if why:
            print(f"away-merge: CI was not green ({why}); the full suite ran locally: {a.local_suite_ok} "
                  f"(ends: {suite_line})")
        extra, took = None, ("", "")
        if maint:  # the away branch takes the integration branch in at once, so it does not drift (a merge, never a rebase)
            try:
                took = maintenance.take_in(checkout, branch, target, sha or "", a.pr, head)
            except Exception as e:  # the merge happened: nothing after it may turn into a traceback
                took = ("failed", f"the take-in could not run ({e})")
            extra = {"kind": "maintenance", "taken_in": took[0] in ("merged", "up to date"),
                     "target": took[1] if took[0] == "up to date" else (sha or head),
                     "take_in": took[0] if took[0] in ("merged", "up to date") else f"{took[0]}: {took[1]}"}
            if took[0] == "merged":
                print(f"away-merge: {branch} took in {target} (a merge commit, {took[1][:12]}): it does not drift")
            elif took[0] == "up to date":
                print(f"away-merge: {branch} already holds {target} at {took[1][:12]}: nothing to take in")
            else:
                print(f"away-merge: {branch} did NOT take in {target} ({took[0]}: {took[1]}). Nothing was forced. The maintenance "
                      f"merge stands on {target}; the next maintenance merge is refused until {branch} has it: a lane merges "
                      f"origin/{target} into a branch cut from {branch}, resolves it, and its PR goes into {branch} through "
                      "away-merge. If away-merge refuses that PR (it holds every commit main gained, the owner's too, so a "
                      "deny path or a cap can stop it), tell the owner: they merge it themselves", file=sys.stderr)
        try:
            improve.record_merge(state, a.project, a.pr, item, sha, extra)
        except OSError as e:
            print(f"away-merge: the merge is done, but it could not be recorded for --max-items ({e.strerror or e})",
                  file=sys.stderr)
        try:
            improve.close_cycle(state, a.project, "merged", sha=sha, metric=a.metric or "", pr=a.pr, item=item)
        except OSError as e:
            print(f"away-merge: the merge is done, but its cycle was not closed in the ledger ({e.strerror or e}); run "
                  f"`lane-improve cycle {a.project} --phase idle`", file=sys.stderr)
    refresh_summary_pr(checkout, state, a.project)
    sys.stdout.flush()
    sys.stderr.flush()  # what the merge said is out before any hook runs: a stopped hook never hides the merge
    after_merge(entries, {**facts, "merge_sha": sha if re.fullmatch(r"[0-9a-f]{40}", sha or "") else ""})
    return 3 if maint and took[0] not in ("merged", "up to date") else 0


def settings_moved(checked: dict, now: dict, mode: str, project: str, maint: bool) -> list:
    """What changed in the period since the checks read it (m1): the deny paths, the project's branches, and for a maintenance
    merge the mode (draining stops it) and the maintenance kinds. [] when nothing did."""
    out = []
    if now.get("deny_paths") != checked.get("deny_paths"):
        out.append("the owner's deny paths changed while the checks ran; run again")
    for key in ("branches", "integration"):
        if (now.get(key) or {}).get(project) != (checked.get(key) or {}).get(project):
            out.append(f"the period's {key} for {project} changed while the checks ran; run again")
    if maint and mode != "on":
        out.append(f"improve mode is {mode} now: maintenance merges have stopped")
    elif maint and now.get("maintenance") != checked.get("maintenance"):
        out.append("the period's maintenance kinds changed while the checks ran; run again")
    return out


def maintenance_checks(a, checkout: Path, state: dict, integ: str, branch: str, head: str, diff: str, paths, refuse,
                       fallback: str) -> None:
    """The checks only a maintenance merge has (each refusal goes through `refuse`): the period's kinds and the project's
    maintenance_paths, every path at the head sha from GitHub and in the diff (with its status, mode and whether it is
    binary), the integration branch's protection and the away branch's take-in."""
    kinds = list(state.get("maintenance") or [])
    pglobs, _where, why = maintenance.globs_for(checkout)
    if why:
        refuse("maintenance", f"the project's maintenance paths cannot be used ({why})")
        return
    at_head, base, why = maintenance.compare_files(checkout, gh, integ, head)
    if at_head is None:
        refuse("maintenance", f"{why}, so the paths at the head cannot be checked")
    else:
        # m1: what the merge changes on main, not only what the PR changed since its base (git follows main's renames)
        if not maintenance.fetch(checkout, branch, integ):
            refuse("maintenance", f"origin's {integ} cannot be fetched, so what the merge changes on it cannot be checked")
        else:
            for p in maintenance.main_moved(checkout, integ, base, set(at_head) | (paths or set())):
                refuse("maintenance", p)
        files = dict(at_head)
        for x in paths or set():
            files.setdefault(x, "modified")  # a path only the diff names: never taken for a new file
        seen = paths or set()
        for p in maintenance.problems(files, kinds, pglobs, state["deny_paths"], maintenance.diff_modes(diff),
                                      maintenance.diff_binary(diff)):
            if "deny path" in p:  # the deny paths of the diff are refused above already
                if not any(p.startswith(f"{s} matches the owner's deny path ") for s in seen):
                    refuse("deny", p)
            else:
                refuse("maintenance", p + fallback)
    why = protection.review_needed(checkout, integ)
    if why:
        refuse("protection", f"{why}: a maintenance merge is refused" + fallback)
    why = maintenance.pending(checkout, branch, integ, improve.merges_of(state, a.project))
    if why:
        refuse("take-in", f"{why}: {WAIT}".format(integ=integ, branch=branch))
    return pglobs


WAIT = ("the next maintenance merge waits until it has (a lane merges origin/{integ} into a branch cut from {branch}, resolves "
        "it, and its PR goes into {branch} through away-merge)")


def cap_hit(state: dict, project: str) -> "str | None":
    """The cap reached for the project (`hours:5.0/1`, `weekly:70/70`, `items:...`), or None; a record that cannot be read is a
    hit too (the caps fail closed)."""
    try:
        return improve.caps(state, project)[1]
    except Exception as e:  # a period record or budget reading that breaks: no write to main on a guess
        return f"the caps cannot be read ({e})"


def maintenance_again(checkout: Path, state: dict, project: str, branch: str, integ: str, pglobs) -> list:
    """Under the lock, just before a maintenance merge (m3): what the checks read outside the period file, read again. The
    project's maintenance_paths, the branch protection and the take-in (another merge of the same project may have merged and
    conflicted while this one's gates ran). [] when all still hold."""
    out = []
    now, _where, why = maintenance.globs_for(checkout)
    if why or now != pglobs:
        out.append(f"the project's maintenance paths changed while the checks ran{f' ({why})' if why else ''}; run again")
    why = protection.review_needed(checkout, integ)
    if why:
        out.append(f"{why}: a maintenance merge is refused")
    why = maintenance.pending(checkout, branch, integ, improve.merges_of(state, project))
    if why:
        out.append(f"{why}: " + WAIT.format(integ=integ, branch=branch))
    return out


def still_as_checked(checkout: Path, number: int, before: dict, branch: str, login: str, head: str,
                     ci_was_green: bool) -> list:
    """What changed on the PR since it was checked (a gate can run for minutes): its base, head, state, review marker,
    body and, when CI was green, CI. [] when nothing did; a PR that cannot be read is a change too."""
    try:
        now = json.loads(gh(["pr", "view", str(number), "--json",
                             "baseRefName,headRefOid,state,body,isDraft,comments,statusCheckRollup,files"], checkout))
    except (Refuse, ValueError) as e:
        return [f"PR {number} cannot be read again after the gates ({e})"]
    out = []
    if now.get("baseRefName") != branch:
        out.append(f"PR {number} now goes into {now.get('baseRefName')!r}, not {branch!r}: away-merge never merges "
                   "anywhere else")
    if now.get("headRefOid") != head:
        out.append(f"PR {number}'s head moved during the gates ({head[:7]} then {str(now.get('headRefOid'))[:7]})")
    if str(now.get("state", "")).upper() != "OPEN":
        out.append(f"PR {number} is {str(now.get('state')).lower()} now, not open")
    if not any((c.get("author") or {}).get("login") == login and head in MARKER.findall(c.get("body") or "")
               for c in now.get("comments") or []):
        out.append(f"the `Review: passed {head}` comment is gone")
    if (now.get("body") or "") != (before.get("body") or ""):
        out.append(f"PR {number}'s body was edited during the gates: the entry is not the one checked")
    if ci_was_green:
        why = ci_green(now.get("statusCheckRollup") or [])
        if why:
            out.append(f"CI is not green any more ({why})")
    return out


def after_merge(entries: list, facts: dict) -> None:
    """The owner's after-merge hooks: said with their exit codes and last lines; one that fails only warns."""
    try:
        res = hooks.run(entries, "after-merge", facts)
    except Exception as e:  # the merge happened: nothing after it may turn into a refusal or a traceback
        print(f"away-merge: warning: the after-merge hooks did not run ({e})", file=sys.stderr)
        return
    for line in hooks.report(res):
        print(f"away-merge: after-merge: {line}")
    if hooks.failed(res):
        print(f"away-merge: warning: {len(hooks.failed(res))} after-merge hook(s) did not pass; the merge stands",
              file=sys.stderr)


def edited_after_review(checkout: Path, number: int, comments: list, login: str, head: str) -> "str | None":
    """Why the PR's body must not be trusted as reviewed, or None: GitHub's lastEditedAt of the PR is later than the newest
    `Review: passed <head>` comment (the body is part of what is merged and published, so an edit after the review is
    unreviewed text). A time that cannot be read is a reason too."""
    stamps = []
    for c in comments:
        if (c.get("author") or {}).get("login") == login and head in MARKER.findall(c.get("body") or ""):
            try:
                stamps.append(dt.datetime.fromisoformat(str(c.get("createdAt"))))
            except ValueError:
                pass
    try:
        out = json.loads(gh(["api", "graphql", "-F", "owner={owner}", "-F", "name={repo}", "-F", f"number={number}", "-f",
                             "query=query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name)"
                             "{pullRequest(number:$number){lastEditedAt}}}"], checkout))
        edited = out["data"]["repository"]["pullRequest"]["lastEditedAt"]
        when = dt.datetime.fromisoformat(edited) if edited else None
    except (Refuse, ValueError, KeyError, TypeError) as e:
        return f"PR {number}'s body may have been edited after the review, and the time of its last edit cannot be read ({e})"
    if when is None:
        return None
    if not stamps:
        return f"PR {number}'s body was edited ({edited}) and the time of the review comment cannot be read"
    if when > max(stamps):
        return (f"PR {number}'s body was edited at {edited}, after the `Review: passed` comment of {max(stamps).isoformat()}: "
                "the entry that would be published is not the one reviewed; the reviewer looks again and the coordinator "
                "writes a new `Review: passed <head sha>`")
    return None


def refresh_summary_pr(checkout: Path, state: dict, project: str) -> None:
    """After a merge: the draft summary PR (away/<date> -> the integration branch) gets its body rebuilt from the branch's
    merge commits (its summary kept), and is opened first when it does not exist. Never fails the merge, which has happened: a PR that cannot be refreshed
    is said on stderr with the command to run by hand."""
    try:
        n, url, what = improve.sync_and_record(checkout, state, project)
    except Exception as e:  # the merge happened: nothing after it may turn into a refusal or a traceback
        print(f"away-merge: the merge is done, but the summary PR was not refreshed ({e}); run `lane-improve pr {project}`",
              file=sys.stderr)
        return
    print(f"away-merge: summary PR #{n} {what}: {url}")


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="away-merge", description="merge a PR into the project's away branch")
    ap.add_argument("--project", required=True)
    ap.add_argument("--pr", required=True, type=int)
    ap.add_argument("--item", required=True)
    ap.add_argument("--local-suite-ok", metavar="RUN_REF")
    ap.add_argument("--maintenance", action="store_true",  # the kinds are the period's (`ratchet on --maintenance <kinds>`)
                    help="merge a maintenance item (docs, tests) into the integration branch (`ratchet on --maintenance`)")
    ap.add_argument("--metric", help="a short measured change for the ledger, such as 'tests 412 -> 431'")
    try:
        a = ap.parse_args(argv)
    except SystemExit as e:
        return 2 if e.code else 0
    return run(a)


if __name__ == "__main__":
    sys.exit(main())
