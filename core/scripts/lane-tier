#!/usr/bin/env bash
# lane-tier: look one tier up in a project's tier table before opening a lane.
#
#   lane-tier <table> <tier>     prints harness=<h> model=<m> permission=<p>
#   lane-tier --check <table>    prints "<tier> <harness> <model>" per row (- for no model); nothing else is decided
#   lane-tier --model <model>    exit 0 when the model may run, 4 when it is refused (an opencode/ or opencode-go/
#                                model, whatever the harness); project-setup asks this for its standing roles
#
# Exit: 0 the tier may be started; 2 usage, a bad table or an unknown tier; 3 the tier's harness is none (skip it, one
# tier up); 4 refused: an OpenCode tier (harness opencode, or an opencode/ or opencode-go/ model whatever the harness
# cell says) in a project that has not turned global-region models on. That is the project's own setting,
# `"global_region_models": true` in the settings.json beside its lanes.tsv (default off; anything but the JSON true,
# an unreadable file, a table that is not named lanes.tsv or has no settings.json beside it all count as off). Only
# an Orca coordinator starts such a lane (worker-start), never cotal_spawn, and never a standing role: --model
# refuses a hosted model whatever a project says (model-routing.md, "Sandbox per tier"). Columns other than tier,
# harness, model and permission are ignored (a table from before may still have a sandbox column). The check is what
# the orca-cotal-lanes skill runs before cotal_spawn; --check only lists the rows.
set -u

die() { echo "lane-tier: $*" >&2; exit 2; }

# Whether the project turned global-region models on: global_region_models is the JSON true in the settings.json beside
# its lanes.tsv. Anything else (no file, a bad one, another value, another table name, no python3) is off.
region_models_on() {
  [ "$(basename -- "$table")" = lanes.tsv ] || return 1
  [ -r "$(dirname -- "$table")/settings.json" ] || return 1
  python3 -I -c 'import json, sys; sys.exit(0 if json.load(open(sys.argv[1])).get("global_region_models") is True else 1)' \
    "$(dirname -- "$table")/settings.json" 2>/dev/null
}

if [ "${1:-}" = "--model" ]; then
  [ $# -eq 2 ] && [ -n "$2" ] || die "usage: lane-tier --model <model>"
  case $2 in
    opencode/*|opencode-go/*)
      cat >&2 <<MSG
lane-tier: refused: $2 is a hosted OpenCode model (opencode/ or opencode-go/). It runs only as a swift lane in a
project whose settings.json sets global_region_models, started there by that project's Orca coordinator; it never
runs as a standing role or through project-setup (model-routing.md, "Sandbox per tier").
MSG
      exit 4 ;;
  esac
  echo "model=$2 ok"
  exit 0
fi

check=""
if [ "${1:-}" = "--check" ]; then
  check=1
  [ $# -eq 2 ] || die "usage: lane-tier --check <table>"
  table=$2 tier=""
else
  [ $# -eq 2 ] || die "usage: lane-tier <table> <tier>"
  table=$1 tier=$2
fi
if [ ! -r "$table" ]; then
  case $table in */.cotal/lanes.tsv) die "cannot read the tier table $table: it moved to the project's settings store (~/.config/lane-control/projects/); run project-setup --refresh on the project, then restart this agent, so its persona names the new path" ;; esac
  die "cannot read the tier table $table"
fi

# Columns are found by name, so a project's table may order them its own way.
out=$(awk -F'\t' -v want="$tier" -v check="$check" '
  { sub(/\r$/, "") }
  /^#/ || /^[ \t]*$/ { next }
  !seen {
    seen = 1
    for (i = 1; i <= NF; i++) col[$i] = i
    if (!col["tier"] || !col["harness"] || !col["model"] || !col["permission"]) {
      print "the header needs tier, harness, model and permission columns"; bad = 1; exit
    }
    next
  }
  {
    h = $col["harness"]
    if ($col["tier"] == "" || h == "") { print "a row has an empty tier or harness cell"; bad = 1; exit }
    if ($col["tier"] ~ /[ \t]/ || h ~ /[ \t]/ || $col["model"] ~ /[ \t]/ || $col["permission"] ~ /[ \t]/) {
      print "tier " $col["tier"] ": a cell contains a space"; bad = 1; exit
    }
    if (check) print $col["tier"], h, ($col["model"] == "" ? "-" : $col["model"])
    else if ($col["tier"] == want) {
      print h "\037" $col["model"] "\037" $col["permission"]; found = 1; exit   # not a tab: read would merge empty cells
    }
  }
  END {
    if (bad) exit 2
    if (!seen) { print "the table has no header"; exit 2 }
    if (!check && !found) { print "no tier " want " in the table"; exit 2 }
  }
' "$table")
rc=$?
[ "$rc" -eq 0 ] || die "$table: $out"
if [ -n "$check" ]; then
  printf '%s\n' "$out"
  exit 0
fi

IFS=$'\037' read -r harness model permission <<<"$out"
if [ "$harness" = none ]; then
  echo "lane-tier: tier $tier has harness none: skip it and go one tier up" >&2
  exit 3
fi
opencode_tier=
[ "$harness" = opencode ] && opencode_tier=1
case $model in opencode/*|opencode-go/*) opencode_tier=1 ;; esac
if [ -n "$opencode_tier" ]; then
  if region_models_on; then
    echo "lane-tier: note: tier $tier is an OpenCode tier; this project's settings allow it. Only its Orca coordinator starts it (worker-start), never cotal_spawn." >&2
  else
    cat >&2 <<MSG
lane-tier: refused: tier $tier is an OpenCode tier (harness $harness, model $model).
A hosted global-region model runs only in a project whose settings.json sets global_region_models (default off; this
one has not), started by that project's Orca coordinator as an Orca worker; no other project runs one bare
(model-routing.md, "Sandbox per tier"). Do not start it with cotal_spawn: go one tier up, and tell the owner that
$table still has this row.
MSG
    exit 4
  fi
fi
printf 'harness=%s model=%s permission=%s\n' "$harness" "$model" "$permission"
