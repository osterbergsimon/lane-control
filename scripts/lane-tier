#!/usr/bin/env bash
# lane-tier: look one tier up in a project's tier table before opening a lane, and refuse the tiers that cannot run here.
#
#   lane-tier <table> <tier>     prints harness=<h> model=<m> permission=<p> sandbox=<s>
#   lane-tier --check <table>    prints "<tier> <harness> <sandbox> <model>" per row (- for no model); nothing else is decided
#
# Exit: 0 the tier may be started; 2 usage, a bad table or an unknown tier; 3 the tier's harness is none (skip it, one
# tier up); 4 refused: the tier needs the sandbox.
#
# The `sandbox` column is `required` or `none`. Global-region models are not trusted with the owner's machine, so a
# hosted OpenCode model is `required` (its serving region is unknown); an internal or offline gateway may be `none`
# (model-routing.md). A table with no column, or a row with an empty cell: `required` for an OpenCode tier, `none` for
# the rest.
#
# A `required` tier runs only inside scripts/opencode-sandbox.sh. Under Orca + Cotal that is scripts/opencode-seat, which
# the manager must run as its `opencode`: this check refuses a required tier (exit 4) unless it finds that for the
# running manager of the table's project, so a tier never starts bare before the manager has been restarted with it. It
# also refuses a required tier whose model the sandbox cannot run (only opencode/ and opencode-go/). Rove runs the
# sandbox as the whole engine, so Rove lanes do not come through this check. The check is what the orca-cotal-lanes
# skill runs before cotal_spawn; Cotal itself does not enforce it, and opencode-seat is the backstop at the launch.
set -u

die() { echo "lane-tier: $*" >&2; exit 2; }

check=""
if [ "${1:-}" = "--check" ]; then
  check=1
  [ $# -eq 2 ] || die "usage: lane-tier --check <table>"
  table=$2 tier=""
else
  [ $# -eq 2 ] || die "usage: lane-tier <table> <tier>"
  table=$1 tier=$2
fi
if [ ! -r "$table" ]; then
  case $table in */.cotal/lanes.tsv) die "cannot read the tier table $table: it moved to the project's settings store (~/.config/lane-control/projects/); restart this agent so its persona names the new path" ;; esac
  die "cannot read the tier table $table"
fi

# Columns are found by name, so a project's table may order them its own way.
out=$(awk -F'\t' -v want="$tier" -v check="$check" '
  { sub(/\r$/, "") }
  /^#/ || /^[ \t]*$/ { next }
  !seen {
    seen = 1
    for (i = 1; i <= NF; i++) col[$i] = i
    if (!col["tier"] || !col["harness"] || !col["model"] || !col["permission"]) {
      print "the header needs tier, harness, model and permission columns"; bad = 1; exit
    }
    next
  }
  {
    h = $col["harness"]
    if ($col["tier"] == "" || h == "") { print "a row has an empty tier or harness cell"; bad = 1; exit }
    if ($col["tier"] ~ /[ \t]/ || h ~ /[ \t]/ || $col["model"] ~ /[ \t]/ || $col["permission"] ~ /[ \t]/) {
      print "tier " $col["tier"] ": a cell contains a space"; bad = 1; exit
    }
    s = col["sandbox"] ? $col["sandbox"] : ""
    if (s == "") s = (h == "opencode") ? "required" : "none"
    if (s != "required" && s != "none") {
      print "tier " $col["tier"] ": sandbox must be required or none, not " s; bad = 1; exit
    }
    if (s == "none" && h == "opencode" && $col["model"] ~ /^opencode(-go)?\//) {
      print "tier " $col["tier"] ": " $col["model"] " is a hosted OpenCode model and cannot be sandbox none"; bad = 1; exit
    }
    if (check) print $col["tier"], h, s, ($col["model"] == "" ? "-" : $col["model"])
    else if ($col["tier"] == want) {
      print h "\037" $col["model"] "\037" $col["permission"] "\037" s; found = 1; exit   # not a tab: read would merge empty cells
    }
  }
  END {
    if (bad) exit 2
    if (!seen) { print "the table has no header"; exit 2 }
    if (!check && !found) { print "no tier " want " in the table"; exit 2 }
  }
' "$table")
rc=$?
[ "$rc" -eq 0 ] || die "$table: $out"
if [ -n "$check" ]; then
  printf '%s\n' "$out"
  exit 0
fi

IFS=$'\037' read -r harness model permission sandbox <<<"$out"
if [ "$harness" = none ]; then
  echo "lane-tier: tier $tier has harness none: skip it and go one tier up" >&2
  exit 3
fi
refuse() {
  cat >&2 <<MSG
lane-tier: refused: tier $tier needs the sandbox (sandbox required): $1
Do not start this tier with cotal_spawn, so that it never runs bare.
Run it as a Rove task through scripts/opencode-sandbox.sh, or use a tier with sandbox none in $table.
MSG
  exit 4
}
# COTAL_OPENCODE_BIN (empty when unset), then the PATH of the running manager of $1, one per line; nothing when none runs.
manager_env() {
  local c a=() want=$1 i
  for c in /proc/[0-9]*/cmdline; do
    a=(); mapfile -d "" -t a 2>/dev/null <"$c" || continue
    for ((i = 0; i < ${#a[@]}; i++)); do
      [ "${a[$i]}" = __service-manager ] || continue
      for ((i = 0; i + 1 < ${#a[@]}; i++)); do
        if [ "${a[$i]}" = --root ] && [ "${a[$((i + 1))]}" = "$want" ]; then
          local e=() v path="" bin=""
          mapfile -d "" -t e 2>/dev/null <"${c%cmdline}environ" || return 1
          for v in "${e[@]}"; do case $v in PATH=*) path=${v#PATH=} ;; COTAL_OPENCODE_BIN=*) bin=${v#*=} ;; esac; done
          printf '%s\n%s\n' "$bin" "$path"
          return 0
        fi
      done
      break
    done
  done
  return 1
}
if [ "$sandbox" = required ]; then
  [ "$harness" = opencode ] || refuse "the sandbox runs OpenCode only, and this tier's harness is $harness"
  case $model in opencode/*|opencode-go/*) ;;
    *) refuse "the sandbox runs only opencode/ and opencode-go/ models, not ${model:-an empty model cell}" ;;
  esac
  seat=$(dirname "$(realpath "$0")")/opencode-seat
  [ -x "$seat" ] || refuse "the launch wrapper $seat is not installed (run project-setup)"
  # The project's table is <config>/lane-control/projects/<project>/lanes.tsv, with the project's checkout as "root" in the
  # settings.json beside it (a table from before the store, <checkout>/.cotal/lanes.tsv, still names its checkout).
  case $(realpath "$table") in
    */.cotal/lanes.tsv) root=$(dirname "$(dirname "$(realpath "$table")")") ;;
    */lane-control/projects/*/lanes.tsv)
      root=$(python3 -I -c 'import json, sys; print(json.load(open(sys.argv[1]))["root"])' \
        "$(dirname "$(realpath "$table")")/settings.json" 2>/dev/null) && [ "${root#/}" != "$root" ] \
        || refuse "$table has no settings.json with the project's root beside it, so its manager cannot be found (run project-setup --refresh)" ;;
    *) refuse "$table is not a project's tier table (<config>/lane-control/projects/<project>/lanes.tsv), so its manager cannot be found" ;;
  esac
  menv=$(manager_env "$root") || refuse "no Cotal manager is running for $root"
  mbin=${menv%%$'\n'*} mpath=${menv#*$'\n'}
  # Same order as Cotal: COTAL_OPENCODE_BIN wins, else the first opencode on the manager's PATH.
  found=
  if [ -n "$mbin" ]; then found=$(realpath "$mbin" 2>/dev/null)
  else
    IFS=: read -ra dirs <<<"$mpath"
    for d in "${dirs[@]}"; do [ -x "$d/opencode" ] && { found=$(realpath "$d/opencode" 2>/dev/null); break; }; done
  fi
  [ "$found" = "$(realpath "$seat")" ] \
    || refuse "the running manager uses ${found:-no opencode} as opencode, not the launch wrapper, so this would run bare. Restart the manager with project-setup (docs/orca.md)"
fi
printf 'harness=%s model=%s permission=%s sandbox=%s\n' "$harness" "$model" "$permission" "$sandbox"
