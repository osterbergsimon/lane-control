#!/usr/bin/env python3
"""away-merge: the only way a project coordinator merges into its away branch (away-improve mode; design:
docs/superpowers/specs/2026-11-23-away-improve-design.md).

  away-merge --project NAME --pr N --item "<title>" [--local-suite-ok LOG]

Merges PR N into the project's active away/<date> branch as a merge commit titled `away: <item>` (never squashed),
and prints the merge commit. It refuses, merging nothing, with one line per failed check, unless all of these hold:
  improve    improve mode is on for NAME (core/improve.py), which names the project's away branch; or it is draining
             (`lane-improve off` or the end time, until `lane-improve drained NAME`): the running lane's last PR still merges
  base       the PR's base is exactly that branch: never main, develop or another project's away branch
  open       the PR is open
  review     a comment on the PR, by the gh login running this script, says `Review: passed <head sha>` for the PR's
             current head commit (the coordinator writes it after the reviewer's clean round; the PR body never
             counts). A push after the review needs a new review. That a lane never writes it or runs away-merge is a
             rule of the skill, not something one gh identity can enforce.
  ci         every check on the PR passed, or --local-suite-ok is the path of the log of the full suite run through
             lane-heavy, whose last line shows a pass (OK, N passed; any other string, a missing or empty file or a
             failing end is refused). Use it only when CI itself is failing or unavailable for reasons outside the
             change; the log's last line is printed, and say so in AWAY-LOG.md
  secrets    the diff is clean: gitleaks when the project has a .gitleaks.toml (no gitleaks to run it is a refusal),
             otherwise a built-in scan of the added lines for keys, tokens, home paths and private addresses
  deny       the PR touches none of improve.json's deny_paths: every old and new path in the `diff --git` headers of
             the PR's diff is checked (gh's file list stops at 100 files and drops a rename's old name); a diff it
             cannot read paths from is a refusal
The merge is `--match-head-commit <the head that was reviewed and scanned>`, and the head is read again after the diff,
so a push in between is refused. The project's checkout is its coordinator's, from machine.conf. gh is called read-only
except for the merge itself.
Exit: 0 merged; 1 refused or could not be checked; 2 usage.
"""
import argparse
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
import improve  # noqa: E402
import machineconf  # noqa: E402

AWAY_BRANCH = re.compile(r"away/\d{4}-\d{2}-\d{2}")
MARKER = re.compile(r"^\s*Review: passed ([0-9a-f]{40})\s*$", re.M)
HEADER = re.compile(r'^diff --git (?:"a/((?:[^"\\]|\\.)*)"|a/(.*?)) (?:"b/((?:[^"\\]|\\.)*)"|b/(.*))$', re.M)
GREEN = {"SUCCESS", "NEUTRAL", "SKIPPED"}
# The built-in scan, for a project without a gitleaks config: what must never reach a public branch.
PRIVATE = [
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"), "a private key"),
    (re.compile(r"\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}|\bgithub_pat_[A-Za-z0-9_]{30,}"), "a GitHub token"),
    (re.compile(r"\bsk-[A-Za-z0-9_-]{20,}|\bxox[abprs]-[A-Za-z0-9-]{10,}|\bAKIA[0-9A-Z]{16}\b"), "an API key or token"),
    # written in pieces so this file does not match the repo's own public-path test
    (re.compile("/ho" + "me/[a-z_][a-z0-9_-]*/|/Us" + "ers/[A-Za-z][A-Za-z0-9._-]*/|/ro" + "ot/"), "a home path"),
    (re.compile(r"\b(?:10\.\d{1,3}|192\.168|172\.(?:1[6-9]|2\d|3[01]))\.\d{1,3}\.\d{1,3}\b"), "a private address"),
    (re.compile(r"(?i)\b(?:auth\.json|\.credentials\.json|id_(?:rsa|ed25519))\b"), "a credentials file name"),
]


class Refuse(Exception):
    pass


def gh(args: list, cwd: Path) -> str:
    try:
        r = subprocess.run(["gh", *args], cwd=cwd, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Refuse(f"gh {args[0]} {args[1]} failed ({e})") from None
    if r.returncode:
        raise Refuse(f"gh {args[0]} {args[1]} failed ({(r.stderr.strip() or 'no output').splitlines()[-1]})")
    return r.stdout


def glob_re(glob: str) -> "re.Pattern":
    """`**` crosses directories (`**/` also matches none), `*` and `?` stay within one name."""
    out, i = "", 0
    while i < len(glob):
        if glob.startswith("**/", i):
            out += "(?:.*/)?"
            i += 3
        elif glob.startswith("**", i):
            out += ".*"
            i += 2
        elif glob[i] == "*":
            out += "[^/]*"
            i += 1
        elif glob[i] == "?":
            out += "[^/]"
            i += 1
        else:
            out += re.escape(glob[i])
            i += 1
    return re.compile(out)


def _unquote(path: str) -> str:
    """A git-quoted path (C escapes, octal bytes for non-ASCII) as text."""
    out, i = bytearray(), 0
    while i < len(path):
        c = path[i]
        if c == "\\" and i + 1 < len(path):
            n = path[i + 1]
            if n in "01234567" and re.fullmatch(r"[0-7]{3}", path[i + 1:i + 4]):
                out.append(int(path[i + 1:i + 4], 8))
                i += 4
                continue
            out += {"n": b"\n", "t": b"\t", '"': b'"', "\\": b"\\"}.get(n, n.encode()) if n in 'nt"\\' else n.encode()
            i += 2
            continue
        out += c.encode()
        i += 1
    return out.decode("utf-8", "replace")


def diff_paths(diff: str) -> "set | None":
    """Every old and new path named in the `diff --git` headers of a diff (a rename gives both); None when it has no
    header at all."""
    found = set()
    for m in HEADER.finditer(diff):
        old = _unquote(m.group(1)) if m.group(1) is not None else m.group(2)
        new = _unquote(m.group(3)) if m.group(3) is not None else m.group(4)
        found.update((old, new))
    for m in re.finditer(r"^rename (?:from|to) (.+)$", diff, re.M):
        found.add(_unquote(m.group(1)[1:-1]) if m.group(1).startswith('"') else m.group(1))
    return found or None


SUITE_PASS = re.compile(r"^OK\b|\bpassed\b|\b0 failures\b", re.I)
SUITE_FAIL = re.compile(r"\b(fail(ed|ures?)?|errors?)\b", re.I)


def suite_log_end(ref):
    """(last line, "") when `ref` is a log file of a suite run that ends passing; ("", why not) otherwise. --local-suite-ok
    used to take any string, so it bypassed red CI for free."""
    if not ref:
        return "", "--local-suite-ok needs the path of the suite's log"
    f = Path(ref)
    try:
        lines = [l.strip() for l in f.read_text(errors="replace").splitlines() if l.strip()] if f.is_file() else []
    except OSError:
        lines = []
    if not lines:
        return "", f"{ref} is not a readable, non-empty log file"
    last = lines[-1]
    if SUITE_FAIL.search(last) or not SUITE_PASS.search(last):
        return "", f"the log's last line does not show a passing run: {last[:80]}"
    return last[:120], ""


def ci_green(rollup: list) -> "str | None":
    """None when every check passed; else why not."""
    if not rollup:
        return "no checks are reported on the PR"
    if all(str(c.get("conclusion") or c.get("state") or "").upper() == "SKIPPED" for c in rollup):
        return "every check was skipped, none passed"
    bad = []
    for c in rollup:
        verdict = c.get("conclusion") or c.get("state") or c.get("status") or ""
        if str(verdict).upper() not in GREEN:
            bad.append(f"{c.get('name') or c.get('context') or 'a check'}: {str(verdict).lower() or 'not finished'}")
    return "; ".join(bad) or None


def scan_added(diff: str) -> "str | None":
    for line in diff.splitlines():
        if line.startswith("+") and not line.startswith("+++"):
            for rx, what in PRIVATE:
                if rx.search(line):
                    return what
    return None


def secret_scan(checkout: Path, diff: str) -> "str | None":
    """None when clean; else why not."""
    if (checkout / ".gitleaks.toml").is_file():
        with tempfile.TemporaryDirectory(prefix="away-merge-") as d:
            (Path(d) / "pr.diff").write_text(diff)
            try:
                r = subprocess.run(["gitleaks", "detect", "--no-git", "--no-banner", "--redact", "-c",
                                    str(checkout / ".gitleaks.toml"), "--source", d], cwd=checkout,
                                   capture_output=True, text=True, timeout=300)
            except FileNotFoundError:
                return "the project has a .gitleaks.toml but gitleaks is not installed, so the diff cannot be checked"
            except (OSError, subprocess.TimeoutExpired) as e:
                return f"gitleaks could not run ({e})"
        if r.returncode:
            return "gitleaks found a secret in the diff" if r.returncode == 1 else f"gitleaks failed (exit {r.returncode})"
        return None
    what = scan_added(diff)
    return f"the diff adds {what}" if what else None


def run(a) -> int:
    item = " ".join(a.item.split())
    if not item:
        print("away-merge: --item needs a title", file=sys.stderr)
        return 2
    failed = []

    def refuse(check: str, why: str):
        failed.append(f"away-merge: refused ({check}): {why}")

    state, mode = improve.merge_state(a.project)
    branch = None
    if state is None:
        refuse("improve", mode)
    else:
        branch = state["branches"].get(a.project)
        if not branch:
            refuse("improve", f"{a.project} has no away branch recorded in the improve file (a project set up after the "
                              f"mode started: tell the owner to run `lane-improve on --continue --project {a.project}`)")
        elif not AWAY_BRANCH.fullmatch(branch) or branch == state["integration"].get(a.project):
            refuse("improve", f"the branch recorded for {a.project} ({branch!r}) is not an away/<date> branch, or is its "
                              "integration branch: away-merge merges only into away branches, never into main or develop")
            branch = None
    try:
        cos = {c.name: c for c in machineconf.coordinators(machineconf.load())}
    except machineconf.ConfError as e:
        print(f"away-merge: refused: {e}", file=sys.stderr)
        return 1
    if a.project not in cos:
        print(f"away-merge: refused: {a.project} is not a coordinator in machine.conf "
              f"({', '.join(cos) or 'none'})", file=sys.stderr)
        return 1
    checkout = cos[a.project].checkout
    if not branch:
        print("\n".join(failed), file=sys.stderr)
        return 1
    try:
        pr = json.loads(gh(["pr", "view", str(a.pr), "--json", "baseRefName,headRefOid,state,comments,statusCheckRollup,files"],
                           checkout))
        diff = gh(["pr", "diff", str(a.pr)], checkout)
        head_now = json.loads(gh(["pr", "view", str(a.pr), "--json", "headRefOid"], checkout)).get("headRefOid")
    except (Refuse, ValueError) as e:
        print(f"away-merge: refused: PR {a.pr} cannot be read ({e})", file=sys.stderr)
        return 1
    head = pr.get("headRefOid") or ""
    if not re.fullmatch(r"[0-9a-f]{40}", head):
        print(f"away-merge: refused: PR {a.pr} has no readable head commit", file=sys.stderr)
        return 1
    if head_now != head:
        refuse("head", f"PR {a.pr} was pushed to while it was being checked ({head[:7]} then {str(head_now)[:7]}); run again")
    if pr.get("baseRefName") != branch:
        refuse("base", f"PR {a.pr} goes into {pr.get('baseRefName')!r}, not {a.project}'s away branch {branch!r}; "
                       "away-merge never merges anywhere else")
    if str(pr.get("state", "")).upper() != "OPEN":
        refuse("open", f"PR {a.pr} is {str(pr.get('state')).lower()}, not open")
    try:
        login = gh(["api", "user", "-q", ".login"], checkout).strip()
    except Refuse:
        login = ""
    reviewed = bool(login) and any(
        (c.get("author") or {}).get("login") == login and head in MARKER.findall(c.get("body") or "")
        for c in pr.get("comments") or [])
    if not reviewed:
        refuse("review", f"no comment by {login or '(the gh login could not be read)'} says `Review: passed {head}` "
                         f"for PR {a.pr}'s current head (the coordinator writes it after the reviewer's clean round; "
                         "the PR body never counts; a push after the review needs a new one)")
    why = ci_green(pr.get("statusCheckRollup") or [])
    suite_line = ""
    if why:
        suite_line, bad = suite_log_end(a.local_suite_ok)
        if bad:
            refuse("ci", f"{why} (CI must be green; or, when CI itself is failing for reasons outside the change, "
                         f"pass --local-suite-ok <log of the full suite run through lane-heavy> and note it in the log; {bad})")
    hit = secret_scan(checkout, diff)
    if hit:
        refuse("secrets", hit)
    paths = diff_paths(diff)
    if paths is None or (pr.get("files") and not paths):
        refuse("deny", "the PR's diff has no `diff --git` headers to read paths from, so the deny paths cannot be checked")
    else:
        for g, rx in [(g, glob_re(g)) for g in state["deny_paths"]]:
            for f in sorted(paths):
                if rx.fullmatch(f):
                    refuse("deny", f"{f} matches the owner's deny path {g}")
    if failed:
        print("\n".join(failed), file=sys.stderr)
        return 1
    try:
        gh(["pr", "merge", str(a.pr), "--merge", "--subject", f"away: {item}", "--match-head-commit", head], checkout)
        sha = gh(["pr", "view", str(a.pr), "--json", "mergeCommit", "-q", ".mergeCommit.oid"], checkout).strip()
    except Refuse as e:
        print(f"away-merge: the merge did not go through: {e}", file=sys.stderr)
        return 1
    print(f"away-merge: merged PR {a.pr} into {branch} as {sha or '(commit unknown)'}: away: {item}")
    if why:
        print(f"away-merge: CI was not green ({why}); the full suite ran locally: {a.local_suite_ok} "
              f"(ends: {suite_line}) (record this in AWAY-LOG.md)")
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="away-merge", description="merge a PR into the project's away branch")
    ap.add_argument("--project", required=True)
    ap.add_argument("--pr", required=True, type=int)
    ap.add_argument("--item", required=True)
    ap.add_argument("--local-suite-ok", metavar="RUN_REF")
    try:
        a = ap.parse_args(argv)
    except SystemExit as e:
        return 2 if e.code else 0
    return run(a)


if __name__ == "__main__":
    sys.exit(main())
