# lane-control: the reverse tunnel that lets SSH host %i reach this machine's Orca (native-Orca setup, direction 2:
# the host's coordinator runs lanes here). Written by core/scripts/lane-tunnel; its host and port are in the
# instance's env file: PORT here (the share link's), REMOTE_PORT on the host (the port the host dials; PORT when the
# file has none, as every file from before has), on 127.0.0.1 only at both ends.
[Unit]
Description=lane-control tunnel: %i reaches this machine's Orca
After=network-online.target
# An always-on tunnel never gives up: ssh runs with BatchMode, so a key or card it cannot use ends it at once, but so does
# a network that is down for an hour, or a host that still holds the old forward (ExitOnForwardFailure); neither may
# leave the unit failed for good. The delay between tries grows instead (RestartSteps, RestartMaxDelaySec: systemd 254 or
# later; lane-tunnel writes a fixed RestartSec=30 for an older one). lane-tunnel start says when the first try fails.
# ControlPath=none and ControlMaster=no: the unit's ssh never rides (or becomes) the user's ControlMaster. A multiplexed
# ssh hands the forward to the master and exits, so the unit restarts for ever while the port still answers (field
# report lc-l78, C2: 127 restarts). lane-control doctor and project-setup --check read the restart counter and the
# unit's own connection, not the port.
StartLimitIntervalSec=0

[Service]
EnvironmentFile=@TUNNELS@/%i.env
ExecStart=/bin/sh -c 'exec "$${LANE_TUNNEL_SSH:-ssh}" $${SSH_CONFIG:+-F "$$SSH_CONFIG"} -N -o BatchMode=yes -o ControlPath=none -o ControlMaster=no -o ConnectTimeout=15 -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R "127.0.0.1:$${REMOTE_PORT:-$${PORT}}:127.0.0.1:$${PORT}" "$$SSH_HOST"'
Restart=always
RestartSec=10
RestartSteps=6
RestartMaxDelaySec=5min

[Install]
WantedBy=default.target
