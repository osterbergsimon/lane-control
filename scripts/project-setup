#!/usr/bin/env python3
"""Set up an Orca project run by Cotal agents: a coordinator and a frontend design lead (see docs/orca.md).

  project-setup <git-url|dir> [--host H] [--name N] [--dest DIR] [--coordinator HARNESS/MODEL]
                [--design-lead HARNESS/MODEL] [--permission-mode auto|bypassPermissions|default]
                [--port N] [--tiers FILE | --opencode hosted|own|none [--opencode-model M]] [--no-start]
                [--private GLOB]... [--adapter HARNESS/MODEL] [--adapt-reviewer HARNESS/MODEL]
                [--readapt | --skip-adapt | --refresh]

Runs on the execution host as a normal user (never root) and needs a reachable Orca runtime (`orca status`), `cotal`
with the @cotal-ai/orca extension, and the harnesses it will launch. Every step is skipped when already done; a
re-run reports `exists` for each.

Before the Orca steps, a headless adapting agent writes the project's files into .lane-control/ and a reviewer on
another model checks them. They are committed, by explicit path, only on the owner's yes in a terminal; on no, or
without a terminal, they stay uncommitted, no Orca step runs and it exits 3. Nothing else is ever committed.

--refresh is for a project set up earlier, after lane-control's personas or skill changed: it re-renders the personas
in .cotal/agents/ (keeping each one's harness, model and permission mode), reinstalls the skill, leaves the project's
.cotal/lanes.tsv alone and says which running agents keep the old text until restarted. No adapting or reviewing
agent, no broker, no Orca worktree, no commit.

The tier table is decided once per project: with a terminal project-setup asks how OpenCode lanes run; without one,
--opencode or a full --tiers say it, and given neither it is hosted (sandbox required). A re-run keeps .cotal/lanes.tsv.
"""
import argparse
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import zlib
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent  # lane-control checkout (or its copy on a host)
HARNESSES = ("claude", "opencode")
MODES = ("auto", "bypassPermissions", "default")
PROXY_VARS = ("HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "http_proxy", "https_proxy", "no_proxy")
ORCA = "orca"  # resolved in main(): ORCA_CLI, the Orca host CLI, the desktop shim, then PATH (may be OrcaSlicer)
PORTS = range(14200, 15000)
LANE_TOOLS = ("lane-limits.sh", "lane-heavy", "lane-room", "lane-tier")  # the library first: a new tool never sees an old one
HOST_FILES = ("scripts/project-setup", *(f"scripts/{t}" for t in LANE_TOOLS),
              "personas", "skills", "templates", "model-routing.md")  # what --host copies


class Fail(Exception):
    pass


def slug(name: str) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    return s or "project"


def derive_port(project_slug: str) -> int:
    return 14200 + zlib.crc32(project_slug.encode()) % 800


def harness_model(spec: str) -> tuple:
    harness, _, model = spec.partition("/")
    if harness not in HARNESSES or not model:
        raise SystemExit(f"project-setup: expected <claude|opencode>/<model>, got {spec!r}")
    return harness, model


DESIGN_ROUTE = ("The project's design lead (`design-lead`, role `design`) owns frontend and visual quality; route\n"
                "UI work and UI reviews through it.")
NO_DESIGN_ROUTE = "This project has no design lead: you route any UI work yourself, and it gets the code reviewer only."
DESIGN_REVIEW = "Frontend\nlanes also get the design lead's review of how it looks and works. "


def render_persona(text: str, harness: str, model: str, mode: str, project: str, tiers: str = "",
                   reviewer: str = "", design_lead: bool = True) -> str:
    # allow-dangerously-skip-permissions puts bypass in Claude's Shift+Tab mode cycle, without starting in it.
    launch = ("events: false" if harness == "opencode" else
              f'launchOptions: {{ "permission-mode": "{mode}", "allow-dangerously-skip-permissions": "" }}')
    return (text.replace("{{HARNESS}}", harness).replace("{{MODEL}}", model).replace("{{LAUNCH}}", launch)
            .replace("{{PROJECT}}", project).replace("{{MODE}}", mode).replace("{{TIERS}}", tiers)
            .replace("{{REVIEWER}}", reviewer)
            .replace("{{DESIGN_ROUTE}}", DESIGN_ROUTE if design_lead else NO_DESIGN_ROUTE)
            .replace("{{DESIGN_REVIEW}}", DESIGN_REVIEW if design_lead else ""))


def orca_cli() -> str:
    home = Path(os.environ.get("HOME", str(Path.home())))
    # orca-ide: the CLI's own name on Linux (packaged installs put it on PATH; plain `orca` may be GNOME's
    # screen reader). The desktop shim is written by the app when it runs.
    for c in (os.environ.get("ORCA_CLI"), home / ".orca" / "cli" / "bin" / "orca", shutil.which("orca-ide"),
              home / ".config" / "orca" / "linux-orca-cli-shim" / "orca"):
        if c and os.access(str(c), os.X_OK):
            return str(c)
    return shutil.which("orca") or "orca"


def free_port(start: int) -> int:
    """The first port from `start` (wrapping inside PORTS) that nothing listens on at 127.0.0.1."""
    import socket
    order = [p for p in PORTS if p >= start] + [p for p in PORTS if p < start] if start in PORTS else [start]
    for p in order:
        with socket.socket() as s:
            try:
                s.bind(("127.0.0.1", p))
                return p
            except OSError:
                continue
    raise Fail("no free broker port in 14200-14999")


def record(repo: Path, **kw) -> dict:
    f = repo / ".cotal" / "lane-control.json"
    data = json.loads(f.read_text()) if f.exists() else {}
    if kw:
        data.update(kw)
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps(data, indent=2) + "\n")
    return data


def say(step: str, what: str, detail: str = "") -> None:
    print(f"{step}: {what}" + (f" {detail}" if detail else ""), flush=True)


def run(cmd, cwd=None, check=True, timeout=180, **kw):
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, errors="surrogateescape", timeout=timeout,
                           **kw)
    except subprocess.TimeoutExpired:
        raise Fail(f"{' '.join(cmd[:3])} timed out after {timeout}s")
    except OSError as e:
        raise Fail(f"{' '.join(cmd[:3])} could not start: {e.strerror or e}")
    if check and p.returncode != 0:
        msg = (p.stderr.strip() or p.stdout.strip()).splitlines()
        raise Fail(f"{' '.join(cmd[:3])} failed: {msg[-1] if msg else p.returncode}")
    return p


def jrun(cmd, cwd=None):
    p = run(cmd, cwd=cwd)
    try:
        return json.loads(p.stdout)
    except json.JSONDecodeError:
        raise Fail(f"{' '.join(cmd[:3])}: unreadable JSON output")


def add_orca_cli_to_path():
    """Put the Orca CLI's folder first on PATH: on a host ~/.orca/cli/bin (non-interactive ssh shells lack it), on a
    workstation the desktop shim (where a plain `orca` may be another program, e.g. OrcaSlicer)."""
    c = orca_cli()
    if not os.path.isabs(c):
        return
    d = os.path.dirname(c)
    if d not in os.environ.get("PATH", "").split(":"):
        os.environ["PATH"] = f"{d}:{os.environ.get('PATH', '')}"


def ssh_base() -> list:
    """`ssh`, plus `-F <file>` when LANE_SSH_CONFIG names a separate ssh config (trial or throwaway hosts)."""
    cfg = os.environ.get("LANE_SSH_CONFIG")
    return ["ssh", "-F", os.path.expanduser(cfg)] if cfg else ["ssh"]


def on_host(host: str, argv: list, target: str) -> int:
    """Copy what project-setup needs to the host and run it there with the same arguments minus --host."""
    if not re.match(r"^(https?|ssh|git|file)://|^[\w.-]+@[\w.-]+:|^/|^~", target):
        print("project-setup: with --host, give a URL or an absolute (or ~/) path on the host", file=sys.stderr)
        return 2
    remote = "~/.local/share/lane-control"
    pack = subprocess.Popen(["tar", "-C", str(HERE), "-cf", "-", *HOST_FILES], stdout=subprocess.PIPE)
    copy = subprocess.run([*ssh_base(), host, f"mkdir -p {remote} && tar -C {remote} -xf -"], stdin=pack.stdout)
    pack.stdout.close()
    if pack.wait() != 0 or copy.returncode != 0:
        print(f"project-setup: copying lane-control to {host} failed", file=sys.stderr)
        return 1
    args, skip = [], False
    for i, x in enumerate(argv):
        if skip:
            skip = False
            continue
        if x == "--host":
            skip = True
            continue
        if x.startswith("--host="):
            continue
        args.append(x)  # --tiers, like the target, is a path on the host
    def q(x):  # keep a leading ~/ for the remote shell to expand, quote the rest
        return "~/" + shlex.quote(x[2:]) if x.startswith("~/") else shlex.quote(x)
    cmd = f"{remote}/scripts/project-setup " + " ".join(q(x) for x in args)
    tty = sys.stdin.isatty()
    return subprocess.run([*reexec_ssh_args(), host, cmd], stdin=None if tty else subprocess.DEVNULL).returncode


def reexec_ssh_args():
    """ssh for the re-exec on the host: with a terminal (-t) when we have one, so the host run can ask the owner."""
    return ssh_base() + (["-t"] if sys.stdin.isatty() else [])


# --- steps -------------------------------------------------------------------------------------------------------

def preflight(needed_harnesses):
    if not shutil.which(ORCA):
        raise Fail("Orca CLI not found (on an Orca host it is ~/.orca/cli/bin/orca; or set ORCA_CLI)")
    p = run([ORCA, "status", "--json"], check=False, timeout=30)
    try:
        rt = json.loads(p.stdout)["result"]["runtime"]
        ok = rt.get("reachable") and rt.get("state") == "ready"
    except (json.JSONDecodeError, KeyError, TypeError):
        ok = False
    if not ok:
        raise Fail("orca runtime not reachable (`orca status`): start orcad or connect the host in Orca first")
    if not shutil.which("cotal"):
        raise Fail("cotal not on PATH (npm i -g cotal-ai)")
    if "@cotal-ai/orca" not in run(["cotal", "ext", "list"], check=False, timeout=60).stdout:
        raise Fail("cotal has no Orca runtime: run `cotal ext add @cotal-ai/orca`")
    for h in sorted(needed_harnesses):
        if not shutil.which(h):
            raise Fail(f"{h} not on PATH, but this project launches {h} agents")


def bd_workspace(repo):
    try:
        return run(["bd", "where"], cwd=repo, check=False, timeout=30).returncode == 0
    except Fail:
        return False


def beads_note(repo):
    """Says plainly when bd is not set up for this project. Creates nothing: where beads lives is the owner's call."""
    if not shutil.which("bd"):
        print("project-setup: note: `bd` is not on PATH; the coordinator and lanes use beads for issues "
              "(see issues.md). Install it if this project should use beads.", file=sys.stderr)
    elif not bd_workspace(repo):
        print(f"project-setup: note: {repo} has no beads workspace (`bd where` fails); agents will find no issue tracker. "
              "Where beads lives is your choice (a symlink to a separate repo, or `bd init`); nothing was created.",
              file=sys.stderr)


def host_hygiene():
    os.umask(0o022)
    for d in (Path.home() / ".config", Path.home() / ".config" / "cotal"):
        if d.is_dir():
            d.chmod(d.stat().st_mode & ~0o020)


def resolve_repo(target: str, dest: Path, name: str) -> Path:
    if re.match(r"^(https?|ssh|git|file)://|^[\w.-]+@[\w.-]+:", target):
        path = dest / name
        if (path / ".git").exists():
            say("repo", "exists", str(path))
        else:
            dest.mkdir(parents=True, exist_ok=True)
            run(["git", "clone", "-q", target, str(path)])
            say("repo", "created", f"{path} (cloned)")
        return path
    d = Path(target).expanduser().resolve()
    if not d.is_dir():
        raise Fail(f"{d} is not a directory")
    top = run(["git", "rev-parse", "--show-toplevel"], cwd=d, check=False)
    if top.returncode == 0:
        say("repo", "exists", top.stdout.strip())
        return Path(top.stdout.strip())
    if "not a git repository" not in top.stderr:
        # Inside .git, a bare repo, "dubious ownership"...: a repository is there, never init over it.
        raise Fail(f"{d}: git says: {top.stderr.strip().splitlines()[-1] if top.stderr.strip() else 'unusable'}")
    run(["git", "init", "-q", "-b", "main"], cwd=d)
    run(["git", "commit", "-q", "--allow-empty", "-m", "Initial commit"], cwd=d)
    say("repo", "created", f"{d} (git init)")
    return d


def orca_repo(repo: Path) -> str:
    repos = jrun([ORCA, "repo", "list", "--json"])["result"]["repos"]
    for r in repos:
        if Path(r["path"]) == repo:
            say("orca-repo", "exists", r["id"])
            return r["id"]
    rid = jrun([ORCA, "repo", "add", "--path", str(repo), "--json"])["result"]["repo"]["id"]
    say("orca-repo", "created", rid)
    return rid


def lane_tools(home: Path):
    """The machine-wide limits (lane-heavy, lane-room), once per machine in ~/.agents/bin. Copies, because the checkout
    they come from may be a worktree that goes away. Replaced by rename: bash reads a running script as it goes, and
    lanes may be running these right now."""
    bin_dir = home / ".agents" / "bin"
    fresh = not (bin_dir / "lane-heavy").exists()
    changed = False
    for name in LANE_TOOLS:
        src, dst = HERE / "scripts" / name, bin_dir / name
        mode = src.stat().st_mode & 0o777
        if dst.exists() and dst.read_bytes() == src.read_bytes() and dst.stat().st_mode & 0o777 == mode:
            continue
        bin_dir.mkdir(parents=True, exist_ok=True)
        tmp = bin_dir / f".{name}.{os.getpid()}.tmp"
        tmp.write_bytes(src.read_bytes())
        tmp.chmod(mode)
        os.replace(tmp, dst)
        changed = True
    say("lane-tools", "created" if fresh else ("updated" if changed else "exists"), f"lane-heavy, lane-room, lane-tier in {bin_dir}")


def skills():
    """User-level, because lane worktrees carry only committed files: ~/.agents/skills, linked for Claude and OpenCode.
    The machine's lane tools go with them, so whatever installs the skill (a setup, a refresh) installs those too."""
    home = Path(os.environ.get("HOME", str(Path.home())))
    lane_tools(home)
    root = home / ".agents" / "skills"
    dst = root / "orca-cotal-lanes"
    want = {"SKILL.md": (HERE / "skills" / "orca-cotal-lanes" / "SKILL.md").read_text(),
            "brief.md": (HERE / "templates" / "lane-brief.md").read_text()}
    fresh = not dst.exists()
    changed = False
    if not (root / "orca-cli").exists():
        run([ORCA, "skills", "install", "--skill", "orca-cli", "--agent", "universal", "--json"])
        changed = True
    for name, text in want.items():
        f = dst / name
        if not f.exists() or f.read_text() != text:
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_text(text)
            changed = True
    for agent_dir in (home / ".claude" / "skills", home / ".config" / "opencode" / "skills"):
        for name in ("orca-cotal-lanes", "orca-cli"):
            link = agent_dir / name
            if not link.is_symlink() and not link.exists() and (root / name).exists():
                agent_dir.mkdir(parents=True, exist_ok=True)
                link.symlink_to(root / name)
                changed = True
    state = "created" if fresh else ("updated" if changed else "exists")
    say("skills", state, f"orca-cli, orca-cotal-lanes in {root}")
    return state


def write_if_changed(path: Path, text: str) -> str:
    if path.exists() and path.read_text() == text:
        return "exists"
    state = "updated" if path.exists() else "created"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    return state


def cotal_space(repo: Path, space: str):
    shown = run(["cotal", "space", "show", space, "--json"], cwd=repo, check=False)
    try:
        info = json.loads(shown.stdout)
    except json.JSONDecodeError:
        info = {}
    if info.get("outcome") == "ok" and info.get("result"):
        root = info["result"].get("root")
        if root and Path(root) != repo:
            raise Fail(f"space {space} already belongs to {root}; pass another --name")
        say("space", "exists", space)
        return
    run(["cotal", "space", "create", space, "--root", str(repo)], cwd=repo)
    run(["cotal", "telemetry", "off"], cwd=repo, check=False)
    say("space", "created", space)


def claude_wiring(repo: Path, space: str):
    """Cotal's Claude plugin and wake channel for this space; recorded only once `cotal setup` succeeded."""
    if record(repo).get("claude_setup"):
        say("claude-wiring", "exists", space)
        return
    run(["cotal", "setup", "--destination", "local", "-H", "claude", "--runtime", "orca", "--project", str(repo),
         "-s", space, "-y", "--configure-only"], cwd=repo, timeout=600)
    record(repo, claude_setup=True)
    say("claude-wiring", "created", space)


def opencode_key_pins(tiers: Path) -> list:
    """(who, model) for every OpenCode tier that can launch on a pin not named as free: a `required` tier is refused
    before it needs a key. A few free models, like big-pickle, have no such name. Roles cannot pin these (main), and
    lane-tier refuses them as `none`, so today no table reaches a warning: dormant until required tiers can launch (SBX-2)."""
    return [(f"tier {t}", m) for t, h, s, m in check_tier_table(tiers.read_text())
            if h == "opencode" and s != "required" and m.startswith(HOSTED_OPENCODE) and not m.endswith("-free")]


def opencode_key_check(repo: Path, space: str, tiers: Path, mgr_started: bool = False):
    """After the manager step, so its definition is current. Each OpenCode agent has its own empty database, so a paid
    model needs the key in the manager's environment (docs/orca.md). `mgr_started`: this run started the manager from
    this shell, where an empty value passes Cotal's check (`=== undefined`), so the definition's ref alone proves
    nothing."""
    pins = opencode_key_pins(tiers)
    if not pins:
        return
    f = repo / ".cotal" / "mgr-service.json"
    readd = (f"cotal svc stop mgr -s {space} --yes, then cotal svc remove mgr -s {space} --yes, "
             "then rerun project-setup from a shell with the key set.")
    lines = []
    has_ref = f.exists() and "OPENCODE_API_KEY" in json.loads(f.read_text()).get("envRefs", {})
    if has_ref and (os.environ.get("OPENCODE_API_KEY") or not mgr_started):
        pass  # the manager holds it, whatever this shell has
    elif not os.environ.get("OPENCODE_API_KEY"):
        lines += [f"warning: {who} pins {m} and OPENCODE_API_KEY is not set: a paid model is not listed without it, "
                  "and its agents exit on launch." for who, m in pins]
        lines += ["  `opencode auth login` does not reach an agent's own database. Once per machine:",
                  "  1. Create an API key in the OpenCode console and export OPENCODE_API_KEY in your shell setup.",
                  f"  2. If mgr already exists, at a natural stop: {readd}"]
    elif f.exists():
        lines += [f"warning: mgr was added without OPENCODE_API_KEY: a paid model like {pins[0][1]} is not listed without "
                  "it, and its agents exit on launch.", f"  At a natural stop: {readd}"]
    lines.append("note: this check only sees whether the key is set. It cannot tell a wrong key from a spent quota: "
                 "either shows only on the agent's first model call.")
    print("\n".join(lines), file=sys.stderr, flush=True)


def with_cotal_ignored(text: str) -> str:
    lines = text.splitlines()
    if ".cotal/" in lines or ".cotal" in lines:
        return text
    nl = "\r\n" if "\r\n" in text else "\n"
    return text + ("" if not text or text.endswith("\n") else nl) + ".cotal/" + nl


def ignore_cotal(repo: Path) -> str:
    gi = repo / ".gitignore"
    text = read_raw(gi)
    new = with_cotal_ignored(text)
    if new == text:
        return "exists"
    write_raw(gi, new)
    return "updated"


HOSTED_OPENCODE = ("opencode/", "opencode-go/")  # served by OpenCode, region unknown: never `sandbox none` by this script
OWN_NOTE = ("This writes no sandbox: the model runs bare on this machine. Choose only a model on a gateway you run "
            "yourself, offline or internal, not one a third party hosts.")
MODEL_NAME = re.compile(r"[A-Za-z0-9._-]+/[A-Za-z0-9._:/-]+")
MODELS_SHOWN = 40


def check_tier_table(text: str) -> list:
    """(tier, harness, sandbox, model) per row, by scripts/lane-tier so the table has one reader. A bad table is a Fail."""
    try:
        r = subprocess.run(["bash", str(HERE / "scripts" / "lane-tier"), "--check", "/dev/stdin"], input=text,
                           capture_output=True, text=True)
    except OSError as e:
        raise Fail(f"cannot check the tier table: {e}")
    if r.returncode != 0:
        raise Fail(r.stderr.strip())
    return [tuple(l.split()) for l in r.stdout.splitlines() if l.strip()]


def sandbox_note(tier_text: str):
    refused = [t for t, h, s, _ in check_tier_table(tier_text) if s == "required" and h != "none"]
    if refused:
        print(f"note: {', '.join(refused)} has sandbox required: Orca + Cotal refuses it until Cotal has a per-seat "
              "launch wrapper, so that work goes one tier up or to Rove (docs/orca.md).", file=sys.stderr, flush=True)


def table_rows(text: str, drop_sandbox: bool = False) -> list:
    """The cells of a tier table's header and rows, without comments or blank lines."""
    rows = [l.split("\t") for l in text.splitlines() if l.strip() and not l.startswith("#")]
    if drop_sandbox and rows and "sandbox" in rows[0]:
        i = rows[0].index("sandbox")
        rows = [r[:i] + r[i + 1:] for r in rows]
    return rows


def is_older_default_table(text: str, default_text: str) -> bool:
    """An unedited table from before the sandbox column: the defaults, minus that column and its comment."""
    rows = table_rows(text)
    return bool(rows) and "sandbox" not in rows[0] and rows == table_rows(default_text, drop_sandbox=True)


def answered_table(default_text: str, was: dict) -> str:
    """The default table with the answer in a project's record (no recorded answer: the defaults)."""
    return tiers_for_answer(default_text, was["opencode"], was.get("opencode_model", "")) \
        if was.get("opencode") in ("hosted", "own", "none") else default_text


def tiers_for_answer(text: str, answer: str, model: str = "") -> str:
    """The default table with the owner's answer applied. hosted: unchanged. own: OpenCode tiers on `model`, no
    sandbox. none: OpenCode tiers skipped, so their work goes one tier up."""
    if answer == "hosted":
        return text
    out, col = [], None
    for line in text.splitlines():
        cells = line.split("\t")
        if not line.strip() or line.startswith("#"):
            pass
        elif col is None:
            col = {n: i for i, n in enumerate(cells)}
            if "sandbox" not in col:
                raise Fail("this tier table has no sandbox column, so the project's OpenCode answer cannot be applied")
        elif cells[col["harness"]] == "opencode":
            if answer == "own":
                cells[col["model"]], cells[col["sandbox"]] = model, "none"
            else:
                cells[col["harness"]], cells[col["model"]], cells[col["sandbox"]] = "none", "-", "none"
        out.append("\t".join(cells))
    return "\n".join(out) + "\n"


def usable_own_model(name: str) -> bool:
    return bool(MODEL_NAME.fullmatch(name)) and not name.startswith(HOSTED_OPENCODE)


def listed_own_models(repo: Path) -> list:
    """Names from `opencode models`, without OpenCode's own hosted ones. Never opencode.jsonc: it can hold keys, and
    spawned agents load that config anyway."""
    try:
        r = subprocess.run(["opencode", "models"], cwd=repo, capture_output=True, text=True, timeout=120,
                           stdin=subprocess.DEVNULL)  # in the project, so its own opencode.json counts
    except (OSError, subprocess.TimeoutExpired):
        return []
    return sorted({l.strip() for l in r.stdout.splitlines() if usable_own_model(l.strip())})


def ask(prompt: str) -> str:
    try:
        return input(prompt).strip()
    except EOFError:
        return ""


def ask_own_model(repo: Path) -> str:
    """A model name the owner picked or typed, or "" if none was given."""
    print(OWN_NOTE)
    names = listed_own_models(repo)
    for i, n in enumerate(names[:MODELS_SHOWN], 1):
        print(f"  {i} {n}")
    if len(names) > MODELS_SHOWN:
        print(f"  ... and {len(names) - MODELS_SHOWN} more: type the name")
    for _ in range(3):
        got = ask("Model for OpenCode lanes (number from the list, or provider/model): ")
        if got.isdigit() and 1 <= int(got) <= min(len(names), MODELS_SHOWN):
            return names[int(got) - 1]
        if usable_own_model(got):
            return got
        print("  Expected a number from the list or provider/model, and not a hosted opencode/ or opencode-go/ model.")
    return ""


def ask_opencode(repo: Path) -> tuple:
    """(answer, model). Anything unclear ends on hosted, the answer that cannot run a model bare."""
    print("How should OpenCode lanes run? 1 hosted models (sandbox required), "
          "2 own models, offline or internal gateway (no sandbox), 3 no OpenCode lanes (Claude only).")
    for _ in range(3):
        got = ask("[1/2/3, default 1] ") or "1"
        if got == "1":
            return "hosted", ""
        if got == "3":
            return "none", ""
        if got == "2":
            model = ask_own_model(repo)
            if model:
                return "own", model
            print("  No model chosen: OpenCode lanes stay hosted (sandbox required).")
            return "hosted", ""
    print("  No answer: OpenCode lanes stay hosted (sandbox required).")
    return "hosted", ""


def choose_tiers(repo: Path, a, default_table: Path) -> str:
    """The project's tier table, decided once. An explicit --tiers or --opencode wins; otherwise a table the project
    already has is kept and nothing is asked."""
    table = repo / ".cotal" / "lanes.tsv"
    try:
        default_text = default_table.read_text()
        if a.tiers:
            check_tier_table(default_text)
            record(repo, opencode="tiers")
            return default_text
        if not a.opencode and table.exists():
            return table.read_text()
        if a.opencode and table.exists():
            current = table.read_text()
            if current != answered_table(default_text, record(repo)) and not is_older_default_table(current, default_text):
                raise Fail(f"{table} differs from the current defaults, and --opencode would replace it with them. Edit "
                           "that file instead, or delete it first to start again from the defaults")
    except (OSError, UnicodeDecodeError) as e:
        raise Fail(f"cannot read a tier table: {getattr(e, 'filename', None) or e}")
    if a.opencode:
        answer, model = a.opencode, a.opencode_model or ""
        if model:
            print(OWN_NOTE, flush=True)
        if answer == "own" and not model:
            model = ask_own_model(repo)
            if not model:
                raise Fail("--opencode own needs a model, and none was chosen")
    else:
        was = record(repo)
        if was.get("opencode") in ("hosted", "own", "none"):
            answer, model = was["opencode"], was.get("opencode_model", "")
        elif has_terminal():
            answer, model = ask_opencode(repo)
        else:
            answer, model = "hosted", ""
            say("opencode", "default", "hosted (sandbox required): no terminal to ask in; set --opencode or --tiers")
    record(repo, opencode=answer, opencode_model=model)
    say("opencode", "chosen", answer + (f" {model}" if model else ""))
    return tiers_for_answer(default_text, answer, model)


def personas_and_tiers(repo: Path, project: str, coord, lead, reviewer, mode: str, tier_text: str):
    """lead None: the project has no design lead. tier_text: the project's table, from choose_tiers."""
    table = str(repo / ".cotal" / "lanes.tsv")
    review_persona = str(repo / ".cotal" / "agents" / "reviewer.md")
    roles = [("coordinator", coord)] + ([("design-lead", lead)] if lead else []) + [("reviewer", reviewer)]
    for name, (h, m) in roles:
        text = render_persona((HERE / "personas" / f"{name}.md").read_text(), h, m, mode, project, table,
                              review_persona, design_lead=lead is not None)
        say(f"persona {name}", write_if_changed(repo / ".cotal" / "agents" / f"{name}.md", text), f"{h}/{m}")
    say("tiers", write_if_changed(repo / ".cotal" / "lanes.tsv", tier_text), ".cotal/lanes.tsv")
    sandbox_note(tier_text)
    say("gitignore", ignore_cotal(repo), ".cotal/")


def refresh(repo: Path, project: str, mode: str, tiers: Path, reviewer: tuple) -> int:
    """Refresh mode: an onboarded project picks up lane-control's current personas and skill. Each persona keeps the
    harness, model and permission mode it was set up with (a missing reviewer persona, from before it existed, is made
    from `reviewer` and the mode of the others), the project's own .cotal/lanes.tsv is never replaced, and nothing is
    adapted, launched or committed. Running agents keep their old persona: they are listed to restart."""
    agents = repo / ".cotal" / "agents"
    if not (agents / "coordinator.md").is_file():
        raise Fail(f"{repo} has no .cotal/agents/coordinator.md: it was not set up; run project-setup without --refresh")
    try:
        old = {n: (agents / f"{n}.md").read_text() for n in ("coordinator", "design-lead", "reviewer")
               if (agents / f"{n}.md").is_file()}
    except (OSError, UnicodeDecodeError) as e:
        raise Fail(f"cannot read a persona in {agents}: {getattr(e, 'filename', None) or e}")
    named = re.search(r"^description: (.+?) coordinator;", old["coordinator"], re.M)
    project = project or (named.group(1) if named else repo.name)

    def recorded(text: str):
        """The mode a persona was rendered with: its launch line (Claude), else its body line (opencode)."""
        m = (re.search(r'"permission-mode": "(\w+)"', text) or re.search(r"permission mode is `(\w+)`", text))
        return m.group(1) if m else None
    modes = {n: recorded(t) for n, t in old.items()}
    others = next((v for v in modes.values() if v), mode)  # a persona with no record: what the others carry
    if not any(modes.values()):
        say("permission-mode", "unknown", f"no persona records it, so they are rendered with `{mode}`; if the project "
            f"ran another, correct it in {agents}")
    table = repo / ".cotal" / "lanes.tsv"
    design_lead = "design-lead" in old
    texts = {}
    for name in ["coordinator"] + (["design-lead"] if design_lead else []) + ["reviewer"]:
        if name in old:
            h = re.search(r"^agent: (\S+)$", old[name], re.M)
            m = re.search(r"^model: (\S+)$", old[name], re.M)
            if not (h and m):
                raise Fail(f"{agents / (name + '.md')} has no agent/model lines to keep; nothing was changed")
            harness, model = h.group(1), m.group(1)
            if harness == "opencode" and model.startswith(HOSTED_OPENCODE):
                print(f"warning: persona {name} pins {model}: a hosted OpenCode model runs only inside the sandbox, "
                      "which a Cotal agent cannot do yet. Do not restart it on that model.", file=sys.stderr, flush=True)
        else:
            harness, model = reviewer
        texts[name] = (harness, model, render_persona((HERE / "personas" / f"{name}.md").read_text(), harness, model,
                                                      modes.get(name) or others, project, str(table),
                                                      str(agents / "reviewer.md"), design_lead=design_lead))
    try:
        check_tier_table(tiers.read_text())
        default_text = answered_table(tiers.read_text(), record(repo))
        own_text = table.read_text() if table.exists() else None
    except (OSError, UnicodeDecodeError) as e:
        raise Fail(f"cannot read a tier table: {getattr(e, 'filename', None) or e}")
    if own_text is None:
        say("tiers", write_if_changed(table, default_text), ".cotal/lanes.tsv (was missing)")
    elif own_text == default_text:
        say("tiers", "exists", ".cotal/lanes.tsv kept (same as the defaults)")
    else:
        def rows(text):
            return {l for l in text.splitlines() if l.strip() and not l.startswith("#")}
        mine, theirs = rows(own_text) - rows(default_text), rows(default_text) - rows(own_text)
        key = lambda rs: ", ".join(sorted(r.split("\t")[0] for r in rs)) or "none"
        say("tiers", "exists", f".cotal/lanes.tsv kept, differs from the defaults: only in the project: {key(mine)}; "
            f"only in the defaults: {key(theirs)}")
    if own_text is not None:
        try:
            sandbox_note(own_text)
        except Fail as e:
            print(f"warning: {e}: lane-tier refuses every tier until it is fixed", file=sys.stderr, flush=True)
    changed = []
    for name, (harness, model, text) in texts.items():
        state = write_if_changed(agents / f"{name}.md", text)
        say(f"persona {name}", state, f"{harness}/{model}")
        if state != "exists":
            changed.append(name)
    skill = skills()
    needs = {n: "persona changed" for n in changed}
    if skill != "exists":
        for n in ("coordinator", "design-lead"):
            needs.setdefault(n, "skill changed")
    if not needs:
        say("restart", "none", "nothing changed")
        return 0
    try:
        live = live_agents(repo, slug(project))
    except Fail:
        say("restart", "unknown", "no live agent list (broker not running?); restart these if running: "
            + ", ".join(sorted(needs)))
        return 0
    def running(n):  # reviewers run per lane as <key>-review, role reviewer
        return [a for a, v in live.items() if a == n or (n == "reviewer" and v.get("role") == "reviewer")]
    todo = [(", ".join(running(n)), why) for n, why in sorted(needs.items()) if running(n)]
    if todo:
        say("restart", "needed", "; ".join(f"{n} ({why})" for n, why in todo)
            + ". They keep the old text until restarted (stop, then start again)")
    else:
        say("restart", "none", "no changed role is running")
    return 0


SETUP_MARKER = "orca-setup-done"
LOCKFILES = (  # (lockfile, command run in its folder); first match per folder wins for the JS managers
    ("uv.lock", "uv sync --frozen --quiet"),
    ("poetry.lock", "poetry install --no-interaction --quiet"),
    ("pnpm-lock.yaml", "pnpm install --frozen-lockfile"),
    ("yarn.lock", "yarn install --frozen-lockfile"),
    ("bun.lock", "bun install --frozen-lockfile"),
    ("package-lock.json", "npm ci --no-audit --no-fund --loglevel=error"),
    ("Cargo.lock", "cargo fetch --locked"),
    ("go.sum", "go mod download"),
)
JS = {"pnpm-lock.yaml", "yarn.lock", "bun.lock", "package-lock.json"}


def setup_steps(repo: Path) -> list:
    """Shell lines that make a fresh worktree of `repo` ready for its checks: dependencies from the lockfiles in the
    repo root and folders up to two levels down, and the beads link when the main checkout's .beads is a symlink."""
    steps = []
    dirs = [repo] + sorted(d for d in repo.glob("*") if d.is_dir()) + sorted(d for d in repo.glob("*/*") if d.is_dir())
    for d in dirs:
        rel = d.relative_to(repo)
        if any(p.startswith(".") or p in ("node_modules", "vendor", "target", "dist", "build") for p in rel.parts):
            continue
        js_done = False
        for lock, cmd in LOCKFILES:
            if not (d / lock).is_file() or (lock in JS and js_done):
                continue
            js_done = js_done or lock in JS
            if lock == "uv.lock" and "[tool.uv.workspace]" in ((d / "pyproject.toml").read_text()
                                                             if (d / "pyproject.toml").is_file() else ""):
                cmd = cmd.replace("uv sync", "uv sync --all-packages")
            tool = cmd.split()[0]
            line = cmd if str(rel) == "." else f"(cd {shlex.quote(str(rel))} && {cmd})"
            steps.append(f'{line} || echo "setup: {tool} in {rel} failed" >&2')
    beads = repo / ".beads"
    if beads.is_symlink():
        steps.insert(0, f"[ -e .beads ] || ln -s {shlex.quote(os.readlink(beads))} .beads")
    return steps


def setup_script(repo: Path, write: bool):
    """The repo's orca.yaml setup script. Orca reads it from the new worktree, so only a committed one counts: a
    missing one is drafted for the owner to review and commit (never committed here)."""
    tracked = subprocess.run(["git", "ls-files", "--error-unmatch", "orca.yaml"], cwd=repo,
                             capture_output=True).returncode == 0
    if tracked:
        say("setup-script", "exists", "orca.yaml")
        return
    steps = setup_steps(repo)
    if not steps:
        say("setup-script", "none", "no lockfiles found")
        return
    body = "\n".join("    " + l for l in steps + [f'touch "$(git rev-parse --git-dir)/{SETUP_MARKER}"'])
    text = ("# Orca runs scripts.setup in every new worktree of this repo (a lane's checkout). Written by lane-control\n"
            "# project-setup from the lockfiles; edit freely. Keep the last line: agents wait for it before starting.\n"
            f"scripts:\n  setup: |\n{body}\n")
    if write and not (repo / "orca.yaml").exists():
        (repo / "orca.yaml").write_text(text)
        say("setup-script", "written", "orca.yaml (review it, then commit it: lanes only get it once committed)")
    else:
        f = repo / ".cotal" / "orca.yaml.proposed"
        if f.is_file() and f.read_text() == text:
            say("setup-script", "exists", f"{f} (not committed as orca.yaml yet)")
            return
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(text)
        say("setup-script", "proposed", f"{f} (review it and commit it as orca.yaml)")


def git_dir(wt: Path):
    g = wt / ".git"
    if g.is_dir():
        return g
    if g.is_file():
        line = g.read_text().strip()
        if line.startswith("gitdir:"):
            p = Path(line.split(":", 1)[1].strip())
            return p if p.is_absolute() else (wt / p).resolve()
    return None


def wait_for_setup(wt: Path, label: str, timeout: float = 600, step: float = 5):
    """Wait until a new worktree's setup script wrote its marker, so the agent never runs checks on missing
    dependencies. Only for a setup script that writes the marker; never fatal. True once the marker exists, False on
    a timeout, None when there is no marker to wait for."""
    timeout = float(os.environ.get("LANE_SETUP_TIMEOUT") or timeout)  # tests shorten it
    step = min(step, timeout)
    yaml = wt / "orca.yaml"
    if not (yaml.is_file() and SETUP_MARKER in yaml.read_text()):
        return None
    gd = git_dir(wt)
    if gd is None:
        return None
    end = time.time() + timeout
    while time.time() < end:
        if (gd / SETUP_MARKER).exists():
            say(f"setup {label}", "done", str(wt))
            return True
        time.sleep(step)
    say(f"setup {label}", "timeout", f"no {SETUP_MARKER} after {int(timeout)}s; see the worktree's Setup tab")
    return False


def services(repo: Path, space: str):
    inv = jrun(["cotal", "svc", "--json", "-s", space], cwd=repo)["result"]["services"]
    return {s["name"]: s["state"] for s in inv}


def start_stack(repo: Path, space: str, port_flag) -> bool:
    """Broker and manager up. True when this run started the manager, False when it was already running."""
    svc = services(repo, space)
    recorded = record(repo).get("port")
    if svc.get("stack-broker") == "running":
        say("broker", "exists", f"nats://127.0.0.1:{recorded or port_flag or derive_port(space)}")
    else:
        port = port_flag or recorded or free_port(derive_port(space))
        record(repo, port=port)
        run(["cotal", "up", "--no-manager", "--server", f"nats://127.0.0.1:{port}", "--space", space], cwd=repo)
        say("broker", "created", f"nats://127.0.0.1:{port}")
        svc = services(repo, space)
    if svc.get("mgr") == "running":
        say("manager", "exists", "mgr (runtime orca)")
        return False
    if "mgr" not in svc:
        # PATH (starting with the Orca CLI's folder) lets Cotal's Orca driver find `orca-ide`/`orca`: Cotal's schema
        # refuses COTAL_* names here, so COTAL_ORCA_BIN can't be passed on.
        # OPENCODE_API_KEY: passed by name; Cotal forwards it from the manager to each OpenCode agent.
        refs = {v: v for v in PROXY_VARS + ("PATH",) if v in os.environ}
        if os.environ.get("OPENCODE_API_KEY"):
            refs["OPENCODE_API_KEY"] = "OPENCODE_API_KEY"
        definition = {"schemaVersion": 1, "space": space,
                      "launch": {"type": "adapter", "adapter": "manager-service",
                                 "options": {"root": str(repo), "runtime": "orca"}},
                      "readiness": {"type": "adapter", "timeoutMs": 60000}, "envRefs": refs}
        f = repo / ".cotal" / "mgr-service.json"
        f.write_text(json.dumps(definition, indent=2) + "\n")
        run(["cotal", "svc", "add", "mgr", "--file", str(f), "-s", space], cwd=repo)
    run(["cotal", "svc", "start", "mgr", "-s", space], cwd=repo)
    say("manager", "created", "mgr (runtime orca)")
    return True


def live_agents(repo: Path, space: str) -> dict:
    items = jrun(["cotal", "ps", "--json", "-s", space], cwd=repo)["result"]["items"]
    return {a["name"]: a for a in items if a.get("status") == "running"}


def spawn(repo: Path, space: str, name: str, harness: str, model: str, mode: str, cwd: Path, kickoff: str):
    if name in live_agents(repo, space):
        say(f"agent {name}", "exists", str(cwd))
        return
    cmd = ["cotal", "spawn", name, "-d", "--harness", harness, "-m", model, "--cwd", str(cwd)]
    cmd += (["--no-events"] if harness == "opencode" else
            ["--opt", f"permission-mode={mode}", "--opt", "allow-dangerously-skip-permissions="])
    run(cmd + ["-p", kickoff, "--space", space], cwd=repo, timeout=300)
    say(f"agent {name}", "created", f"{harness}/{model} in {cwd}")


def claude_trusts(repo: Path) -> bool:
    """Whether the owner told Claude Code to trust this folder (its first-start "Do you trust this folder?" prompt,
    recorded per folder in ~/.claude.json; worktrees of the repo share the main checkout's answer)."""
    f = Path(os.environ.get("HOME", str(Path.home()))) / ".claude.json"
    try:
        projects = json.loads(f.read_text()).get("projects", {})
    except (OSError, ValueError):
        return False
    return bool(projects.get(str(repo), {}).get("hasTrustDialogAccepted"))


def record_claude_trust(repo: Path):
    """Record "Yes, I trust this folder" for repo in ~/.claude.json, as Claude Code itself does (it has no switch for
    it). Running Claude sessions rewrite that file, so write it atomically, keep everything else, and check it held."""
    f = Path(os.environ.get("HOME", str(Path.home()))) / ".claude.json"
    for _ in range(3):
        try:
            text = f.read_text() if f.exists() else "{}"
            cfg = json.loads(text)
        except (OSError, ValueError) as e:
            raise Fail(f"can't read {f} to record folder trust ({e}); left it untouched")
        if not isinstance(cfg, dict):
            raise Fail(f"{f} is not a JSON object; left it untouched")
        cfg.setdefault("projects", {}).setdefault(str(repo), {})["hasTrustDialogAccepted"] = True
        mode = f.stat().st_mode & 0o777 if f.exists() else 0o600
        tmp = f.with_name(f".claude.json.lane-control-{os.getpid()}")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
        with os.fdopen(fd, "w") as out:
            json.dump(cfg, out, indent=2)
        os.replace(tmp, f)
        time.sleep(0.2)  # let a Claude session that wrote over it show up before checking
        if claude_trusts(repo):
            return
    raise Fail(f"recorded trust for {repo} in {f}, but a running Claude session kept overwriting it; try again")


def ensure_claude_trust(repo: Path, record: bool = False):
    """Claude Code asks "Do you trust this folder?" the first time it starts in one, and an agent tab can't answer.
    With record (--trust-folder, the owner's explicit choice) it is recorded quietly. Otherwise it is never recorded
    for them: in a terminal, offer to open Claude here for them to answer, and go on once they have; without one,
    stop and say what to run."""
    if claude_trusts(repo):
        say("claude-trust", "exists", str(repo))
        return
    if record:
        record_claude_trust(repo)
        say("claude-trust", "created", f"{repo} (--trust-folder)")
        return
    how = (f"Run `cd {repo} && claude` once, answer 'Yes, I trust this folder', exit, and run project-setup again "
           "(or rerun with --trust-folder to answer yes without asking).")
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise Fail(f"Claude Code has not been told to trust {repo} yet. {how}")
    print(f"Claude Code asks whether you trust a folder the first time it starts there, and an agent can't answer "
          f"for you. {repo} has no answer yet.", flush=True)
    ans = input("Open Claude there now? Answer its question, then type /exit to come back here. [Y/n] ")
    if ans.strip().lower() not in ("", "y", "yes"):
        raise Fail(f"stopped: Claude Code doesn't trust {repo} yet. {how}")
    subprocess.run(["claude"], cwd=repo)
    if not claude_trusts(repo):
        raise Fail(f"Claude Code still doesn't trust {repo} (answered no, or closed before answering). {how}")
    say("claude-trust", "created", str(repo))


def design_worktree(repo: Path, repo_id: str):
    """The design lead's child worktree, and whether this run created it."""
    for w in jrun([ORCA, "worktree", "list", "--json"])["result"]["worktrees"]:
        if w["id"].startswith(repo_id + "::") and w.get("displayName") == "design-lead":
            say("worktree design-lead", "exists", w["path"])
            return Path(w["path"]), False
    res = jrun([ORCA, "worktree", "create", "--repo", f"id:{repo_id}", "--name", "design-lead",
                "--parent-worktree", f"path:{repo}", "--setup", "inherit", "--json"])["result"]
    path = Path(res["worktree"]["path"])
    say("worktree design-lead", "created", str(path))
    return path, True


def is_setup_tab(t: dict) -> bool:
    """The title is not reliable: the Setup tab's paneTitle is "Setup", or (before that is set) its title or preview
    names setup-runner.sh."""
    return (t.get("paneTitle") == "Setup" or "setup-runner.sh" in (t.get("title") or "")
            or "setup-runner.sh" in (t.get("preview") or ""))


def worktree_terminals(wt: Path) -> list:
    rows = jrun([ORCA, "terminal", "list", "--json"])["result"]["terminals"]
    return [t for t in rows if Path(t.get("worktreePath") or "/") == wt]


def fresh_shell(t: dict) -> bool:
    """A shell nobody has used: no agent in it and a preview of exactly one line, the prompt, whatever it looks like.
    Output or a run command shows more lines; if the preview cannot prove it (empty or missing), leave the tab open."""
    return not t.get("agentIdentity") and len([l for l in (t.get("preview") or "").splitlines() if l.strip()]) == 1


def close_startup_tabs(wt: Path, before: set, setup_done: bool):
    """After the agent started: close the plain shell Orca opened and, if the setup script finished, its Setup tab.
    Only terminals listed in `before` (taken before the spawn) are considered, so the agent's own tab can never match.
    Never an agent's tab (`agentIdentity`, `cotal-` title), a Setup tab that has not finished, or a shell in use."""
    for t in worktree_terminals(wt):
        if t["handle"] not in before or t.get("agentIdentity") or (t.get("title") or "").startswith("cotal-"):
            continue
        if is_setup_tab(t) and not setup_done:
            continue
        if is_setup_tab(t) or fresh_shell(t):
            jrun([ORCA, "terminal", "close", "--terminal", t["handle"], "--tab", "--json"])


def verify(repo: Path, space: str, wt):
    """wt None: no design lead to check."""
    agents = live_agents(repo, space)
    if wt is None:
        if "coordinator" not in agents:
            raise Fail("verify: not live: coordinator")
        say("verify", "ok", "coordinator live (no design lead)")
        return
    missing = [n for n in ("coordinator", "design-lead") if n not in agents]
    rows = jrun([ORCA, "worktree", "list", "--json"])["result"]["worktrees"]
    lead = [w for w in rows if Path(w["path"]) == wt]
    parent_ok = bool(lead) and (lead[0].get("parentWorktreeId") or "").endswith("::" + str(repo))
    if missing or not parent_ok:
        raise Fail("verify: " + ", ".join(
            ([f"not live: {' '.join(missing)}"] if missing else []) +
            ([] if parent_ok else ["design-lead worktree is not a child of the main checkout"])))
    say("verify", "ok", "coordinator and design-lead live; design-lead nested under the main checkout")


# --- onboarding: adapted files, reviewed, committed only on the owner's yes ----------------------------------------

ADAPTED = ".lane-control"
SUGGESTIONS = f"{ADAPTED}/SUGGESTIONS.md"  # moved out of the repo before any review; never committed
SECTION_BEGIN = "<!-- lane-control:begin -->"
SECTION_END = "<!-- lane-control:end -->"
SECTION = (f"{SECTION_BEGIN}\n## lane-control\n\nThis project is run with lane-control. Its adapted files are in "
           f"`{ADAPTED}/`: read them before you start work.\n{SECTION_END}")
MAX_FIX_ROUNDS = 2
AGENT_TIMEOUT = 1800  # seconds per headless agent run
MAX_TURNS = {True: 80, False: 60}  # per headless agent run, by write: the adapter, then the reviewer
DIFF_LIMIT = 60000  # bytes of diff in a prompt; one argument may hold at most 128 KiB
FINDINGS_LIMIT = 30000  # bytes of reviewer findings in a prompt
STOPPED = 3  # exit status: the owner's answer is needed, and no Orca step ran
READ_TOOLS = ("Read", "Glob", "Grep")
TEMPLATES = HERE / "templates" / "adapt"
PROMPTS = ("prompt.md", "review-prompt.md")  # the two prompts; every other file there is a template to adapt
ADAPT_RULES = f"""
Rules for this run:
- Write only inside {ADAPTED}/. Never edit AGENTS.md or anything else in the project.
- If AGENTS.md should change, write the suggested edits to {SUGGESTIONS} for the owner; do not make them. That file
  is taken away before anything is reviewed: never refer to it in the other files.
- Leave everything uncommitted."""
REVIEW_RULES = """
You can only read. Report every finding with its file. End your reply with one last line, exactly `VERDICT: PASS` when
nothing needs fixing, or `VERDICT: FIX` when something does."""


def read_raw(f: Path) -> str:
    """A file as text, whatever its encoding: bytes that aren't UTF-8 survive read_raw and write_raw unchanged."""
    return f.read_bytes().decode(errors="surrogateescape") if f.exists() else ""


def write_raw(f: Path, text: str):
    f.write_bytes(text.encode(errors="surrogateescape"))


def clip(text: str, limit: int) -> str:
    raw = text.encode(errors="surrogateescape")
    return text if len(raw) <= limit else raw[:limit].decode(errors="ignore") + "\n(cut short: read the files)\n"


def without_section(text: str) -> str:
    """text minus lane-control's marked section. Refuses markers it can't pair: never guess which lines are ours."""
    if text.count(SECTION_BEGIN) != text.count(SECTION_END) or text.count(SECTION_BEGIN) > 1:
        raise Fail(f"AGENTS.md has unpaired or repeated {SECTION_BEGIN} markers; fix it by hand and run again")
    if SECTION_BEGIN not in text:
        return text
    if text.index(SECTION_END) < text.index(SECTION_BEGIN):
        raise Fail(f"AGENTS.md has {SECTION_END} before {SECTION_BEGIN}; fix it by hand and run again")
    head, rest = text.split(SECTION_BEGIN, 1)
    return head + rest.split(SECTION_END, 1)[1]


def with_section(text: str) -> str:
    """text with lane-control's section: replaced in place when present, else added at the end. Nothing else changes."""
    without_section(text)
    nl = "\r\n" if "\r\n" in text else "\n"
    block = SECTION.replace("\n", nl)
    if SECTION_BEGIN in text:
        head, rest = text.split(SECTION_BEGIN, 1)
        return head + block + rest.split(SECTION_END, 1)[1]
    if not text:
        return block + nl
    return text + ("" if text.endswith("\n") else nl) + nl + block + nl


def head_text(repo: Path, path: str) -> str:
    """The file as committed at HEAD, bytes kept as they are; empty when it isn't there."""
    p = subprocess.run(["git", "show", f"HEAD:{path}"], cwd=repo, capture_output=True)
    return p.stdout.decode(errors="surrogateescape") if p.returncode == 0 else ""


def agents_md(repo: Path) -> str:
    """The repo path that holds AGENTS.md: a symlink's target, which must be in the repo for git to commit it."""
    f = repo / "AGENTS.md"
    if not f.is_symlink():
        return "AGENTS.md"
    try:
        return str(f.resolve().relative_to(repo.resolve()))
    except ValueError:
        raise Fail("AGENTS.md links outside the repo, so its section could not be committed. Nothing was committed")


def check_agents_md(repo: Path):
    """AGENTS.md must be as committed, or exactly that plus our section: all the commit is allowed to carry."""
    path = agents_md(repo)
    f = repo / path
    head = head_text(repo, path)
    if read_raw(f) not in (head, with_section(head)):
        raise Fail(f"{path} has uncommitted changes besides the lane-control section; commit or undo them and run "
                   "again. Nothing was committed")


def check_gitignore(repo: Path):
    """.gitignore must be as committed, or exactly that plus the .cotal/ line, for the same reason."""
    head = head_text(repo, ".gitignore")
    if read_raw(repo / ".gitignore") not in (head, with_cotal_ignored(head)):
        hint = " (an earlier project-setup may have rewritten its line endings)" if "\r\n" in head else ""
        raise Fail(f".gitignore has uncommitted changes besides .cotal/{hint}; commit or undo them and run again. "
                   "Nothing was committed")


def write_section(repo: Path):
    f = repo / agents_md(repo)
    text = read_raw(f)
    new = with_section(text)
    if new == text:
        say("agents-md", "exists", "lane-control section")
        return
    write_raw(f, new)
    say("agents-md", "updated" if text else "created", "lane-control section")


def git_changes(repo: Path) -> list:
    """(path, mark) for every file git sees as added, changed or deleted: the record of what happened on disk."""
    out = run(["git", "status", "--porcelain=v1", "-z", "--untracked-files=all", "--no-renames"], cwd=repo).stdout
    rows = []
    for entry in filter(None, out.split("\0")):
        status, path = entry[:2], entry[3:]
        mark = "added" if status == "??" or "A" in status else "changed (deleted)" if "D" in status else "changed"
        rows.append((path, mark))
    return rows


def ours(repo: Path, path: str) -> bool:
    return path in (agents_md(repo), ".gitignore") or path.startswith(ADAPTED + "/")


def fingerprint(f: Path):
    if f.is_symlink():
        return "link:" + os.readlink(f)
    return hashlib.sha1(f.read_bytes()).hexdigest() if f.is_file() else None


HEAD_KEY = "\0HEAD"  # no path holds a NUL


def current_head(repo: Path) -> str:
    return run(["git", "rev-parse", "-q", "--verify", "HEAD"], cwd=repo, check=False).stdout.strip()


def snapshot(repo: Path) -> dict:
    """What is already uncommitted before an agent starts, so it is neither blamed on the agent nor committed."""
    return {**{p: fingerprint(repo / p) for p, _ in git_changes(repo)}, HEAD_KEY: current_head(repo)}


def check_scope(repo: Path, before: dict):
    if current_head(repo) != before[HEAD_KEY]:
        raise Fail("HEAD moved while an agent ran; onboarding's agents never commit. Nothing further was committed")
    # before's paths too: a file put back to its committed state no longer shows in git status
    seen = {p for p, _ in git_changes(repo)} | (set(before) - {HEAD_KEY})
    strays = sorted(p for p in seen if not ours(repo, p) and (p not in before or before[p] != fingerprint(repo / p)))
    if strays:
        raise Fail(f"changed outside {ADAPTED}/ while an agent ran: {' '.join(strays)}. Nothing was committed")
    check_agents_md(repo)
    check_gitignore(repo)


PRIVATE_GLOBS: list = []  # --private: tracked files that are still private; set by main()
RULE_UNSAFE = set("()*?[]{}\\\n")  # a name with one of these cannot be put into a deny rule as it is
DENY_LIMIT = 100000  # bytes of deny rules; they are command-line arguments


def private_rules(repo: Path) -> list:
    """Read-deny rules for what the onboarding agents must not see, by name; the list is never written to a file.

    The .git folder, every git-ignored path (data folders, local settings, keys, the .beads link, .direnv), every .env* file git does not
    track, and each --private glob. Tracked files stay readable, .env.example included. Grep skips ignored files on its
    own but not when it is pointed at one, so these rules cover Read, Glob and Grep alike."""
    ignored = git_z(repo, "ls-files", "-o", "-i", "--exclude-standard", "--directory")
    untracked = git_z(repo, "ls-files", "-o", "--exclude-standard")
    names = [n for n in ignored if n.rstrip("/") != ADAPTED]
    names += [n for n in untracked if Path(n).name.startswith(".env")]
    rules = ["Read(/.git/**)"]  # remote URLs and hooks live there; no onboarding step reads git
    for n in names:
        if RULE_UNSAFE & set(n):
            raise Fail("a git-ignored or untracked .env name has a character that a deny rule cannot carry "
                       f"(one of ( ) * ? [ ] {{ }} \\ or a newline): {n!r}. Rename it, or move it out of the repo")
        rules.append(f"Read(/{n}**)" if n.endswith("/") else f"Read(/{n})")
    for g in PRIVATE_GLOBS:
        rules.append(f"Read(/{g})")
    if sum(map(len, rules)) > DENY_LIMIT:
        raise Fail(f"{len(rules)} private paths are too many to deny one by one; ignore a folder instead of its files")
    return rules


def git_z(repo: Path, *args) -> list:
    out = run(["git", *args, "-z"], cwd=repo).stdout
    return [n for n in out.split("\0") if n]


def agent_cmd(model: str, prompt: str, write: bool, deny: tuple = ()) -> list:
    """A plain headless Claude run: no Orca or Cotal space exists yet, and neither is needed.

    Permissions are what the job needs: read the project except the private paths in `deny` (see private_rules); write
    only inside .lane-control/, and only for the adapting agent. No shell, so neither can run project code or git; no
    web; no MCP servers; the project's own settings and hooks are not loaded; the file tools stay inside the repo
    (--restricted), so a symlink out of it is refused. Anything else is refused, not asked."""
    tools = READ_TOOLS + (("Edit", "Write") if write else ())
    allow = READ_TOOLS + ((f"Edit(/{ADAPTED}/**)",) if write else ())
    cmd = ["claude", "-p", "--model", model, "--no-session-persistence", "--restricted", "--strict-mcp-config",
           "--tools", ",".join(tools), "--allowedTools", ",".join(allow)]
    if deny:  # variadic: another flag must follow, or it would take the prompt
        cmd += ["--disallowedTools", *deny]
    return cmd + ["--permission-mode", "dontAsk", "--max-turns", str(MAX_TURNS[write]), prompt]


def run_agent(repo: Path, who: tuple, prompt: str, write: bool) -> str:
    p = run(agent_cmd(who[1], prompt, write, tuple(private_rules(repo))), cwd=repo, timeout=AGENT_TIMEOUT, stdin=subprocess.DEVNULL, check=False)
    if p.returncode != 0:
        said = (p.stderr.strip() or p.stdout.strip()).splitlines()
        # the adapter may have left half-written files; a plain re-run would review them as if they were complete
        left = (f" Files it half wrote may be left in {ADAPTED}/: run again with --readapt, or remove {ADAPTED}/"
                if write else "")
        if "max turns" in " ".join(said[-1:]).lower():
            raise Fail(f"the {'adapting agent' if write else 'reviewer'} used all {MAX_TURNS[write]} turns and was "
                       f"stopped before it finished. Nothing was committed and no Orca step ran.{left}")
        raise Fail(f"claude -p --model failed: {said[-1] if said else p.returncode}. Nothing was committed.{left}")
    return p.stdout


def kept_suggestions(repo: Path) -> Path:
    """Where SUGGESTIONS.md waits for the owner: in the git dir, so it is neither reviewed nor committed."""
    return repo / run(["git", "rev-parse", "--git-path", "lane-control-suggestions.md"], cwd=repo).stdout.strip()


def adapt(repo: Path, who: tuple, prompt: str, before: dict):
    """One run of the adapting agent. Its suggestions leave the repo before anything reviews the result; a fix round's
    are added to the earlier ones."""
    try:
        run_agent(repo, who, prompt, write=True)
    finally:  # also when the run failed: the suggestions are never left where a later run could commit them
        new = repo / SUGGESTIONS
        if new.is_file():
            kept = kept_suggestions(repo)
            old = kept.read_bytes() if kept.exists() else b""
            kept.write_bytes(old + (b"" if not old or old.endswith(b"\n") else b"\n") + new.read_bytes())
            new.unlink()
    check_scope(repo, before)


def fill(name: str, project: str, design_lead: bool, findings: str = "") -> str:
    """A prompt template with its machine values, so its wording can change without touching this script."""
    text = (TEMPLATES / name).read_text()
    inlined = "\n\n".join(f"--- {t.name} ---\n{t.read_text().rstrip()}" for t in sorted(TEMPLATES.glob("*.md"))
                          if t.name not in PROMPTS)
    if findings and "{{REVIEW_FINDINGS}}" not in text:
        text += "\n{{REVIEW_FINDINGS}}\n"
    return (text.replace("{{PROJECT}}", project).replace("{{DESIGN_LEAD}}", "yes" if design_lead else "no")
            .replace("{{TEMPLATES}}", inlined).replace("{{REVIEW_FINDINGS}}", findings).rstrip() + "\n")


def review_prompt(repo: Path, project: str, design_lead: bool) -> str:
    """Built from git and the project alone, so the reviewer never reads the adapting agent's account of its work."""
    changes = [(p, m) for p, m in git_changes(repo) if ours(repo, p)]
    files = "\n".join(f"- {p} ({m})" for p, m in changes)
    tracked = [p for p, m in changes if m != "added"]
    diff = run(["git", "diff", "HEAD", "--", *tracked], cwd=repo, check=False).stdout if tracked else ""
    diff = clip(diff, DIFF_LIMIT)
    return (fill("review-prompt.md", project, design_lead) + f"\nUncommitted files to review:\n{files}\n"
            + (f"\nDiff of the files already tracked:\n{diff}" if diff else "") + REVIEW_RULES)


def verdict(text: str):
    """PASS or FIX from the reviewer's last line; None when it gave neither, which never counts as a pass."""
    lines = [l for l in re.sub(r"\x1b\[[0-9;]*m", "", text).splitlines() if l.strip()]
    m = re.fullmatch(r"[\s*`_]*VERDICT:\s*(PASS|FIX)[\s*`_.]*", lines[-1]) if lines else None
    return m.group(1) if m else None


def review_with_fixes(repo: Path, project: str, adapter: tuple, reviewer: tuple, before: dict, design_lead: bool):
    """Review, with at most MAX_FIX_ROUNDS rounds of fixes. None when it passed, else what is still unresolved."""
    fixes = 0
    while True:
        say("review", "running", "/".join(reviewer))
        out = run_agent(repo, reviewer, review_prompt(repo, project, design_lead), write=False)
        check_scope(repo, before)
        result = verdict(out)
        if result == "PASS":
            say("review", "passed", f"after {fixes} round(s) of fixes")
            return None
        if result is None:
            return out.strip() + "\n(the reviewer gave no verdict)"
        if fixes == MAX_FIX_ROUNDS:
            return out.strip()
        fixes += 1
        say("adapt", "fixing", f"round {fixes} of {MAX_FIX_ROUNDS}")
        found = f"A reviewer found these problems in {ADAPTED}/. Fix them there:\n{clip(out.strip(), FINDINGS_LIMIT)}"
        adapt(repo, adapter, fill("prompt.md", project, design_lead, found) + ADAPT_RULES, before)


def show_suggestions(repo: Path):
    f = kept_suggestions(repo)
    if f.is_file() and f.read_text(errors="replace").strip():
        print("\nSuggested AGENTS.md edits (not applied, not committed):")
        for line in f.read_text(errors="replace").strip().splitlines():
            print(f"  {line}")


def show_changes(repo: Path, changes: list):
    print("\nFiles added or changed (from git):")
    for p, mark in changes:
        print(f"  {mark}: {p}")
    show_suggestions(repo)
    print(flush=True)


def has_terminal() -> bool:
    return sys.stdin.isatty() and sys.stdout.isatty()


def owner_says_yes() -> bool:
    if not has_terminal():
        say("commit", "skipped", "no terminal to ask the owner in")
        return False
    try:
        return input("Commit these files and run the Orca setup? [y/N] ").strip().lower() in ("y", "yes")
    except EOFError:
        return False


def commit_adapted(repo: Path, paths: list, message: str = "Add lane-control files adapted to this project"):
    """Only these paths, whatever else is staged; with the identity git is configured with, and no attribution."""
    run(["git", "add", "--", *paths], cwd=repo)
    run(["git", "commit", "-q", "-m", message, "--only", "--", *paths], cwd=repo)
    say("commit", "created", f"{len(paths)} file(s)")


def onboarded(repo: Path) -> bool:
    files = run(["git", "ls-tree", "-r", "--name-only", "HEAD", "--", ADAPTED], cwd=repo, check=False).stdout
    return bool(files.strip()) and SECTION_BEGIN in head_text(repo, agents_md(repo))


def refresh_section(repo: Path) -> bool:
    """An onboarded project whose committed AGENTS.md section is out of date: update it in place, on the owner's yes.
    True when the Orca setup may run. Without a terminal nothing is written, so an unattended re-run still gets
    there."""
    path = agents_md(repo)
    head = head_text(repo, path)
    if with_section(head) == head:
        say("agents-md", "exists", "lane-control section")
        return True
    if not has_terminal():
        say("agents-md", "stale", "lane-control section left as it is; run again in a terminal to update it")
        return True
    check_agents_md(repo)
    write_section(repo)
    show_changes(repo, [(p, m) for p, m in git_changes(repo) if p == path])
    if not owner_says_yes():
        say("adapt", "stopped", f"{path} left uncommitted, no Orca setup. Run again in a terminal to answer")
        return False
    commit_adapted(repo, [path], "Update the lane-control section of AGENTS.md")
    return True


def onboard(repo: Path, project: str, adapter: tuple, reviewer: tuple, again: bool, design_lead: bool) -> bool:
    """The steps in front of the Orca setup; True when that setup may run. A re-run is safe: committed files are left
    alone unless `again`, and uncommitted ones (an earlier run, a hand edit) go back to review instead of being
    rewritten."""
    if onboarded(repo) and not again and not any(p.startswith(ADAPTED + "/") for p, _ in git_changes(repo)):
        say("adapt", "exists", f"{ADAPTED}/ is committed")
        return refresh_section(repo)
    if not shutil.which("claude"):
        raise Fail("claude not on PATH, but the onboarding agents use it")
    for key in ("user.name", "user.email"):
        if not run(["git", "config", "--get", key], cwd=repo, check=False).stdout.strip():
            raise Fail(f"git has no {key} here, so the owner's commit can't be made; set it and run again")
    check_agents_md(repo)
    check_gitignore(repo)
    # Before the agent starts, so nothing in .cotal/ can pass for its work; committed with its files.
    say("gitignore", ignore_cotal(repo), ".cotal/")
    before = snapshot(repo)
    if any(p.startswith(ADAPTED + "/") for p in before) and not again:
        say("adapt", "exists", f"uncommitted {ADAPTED}/ from an earlier run; reviewing it again")
    else:
        say("adapt", "running", "/".join(adapter))
        kept_suggestions(repo).unlink(missing_ok=True)
        adapt(repo, adapter, fill("prompt.md", project, design_lead) + ADAPT_RULES, before)
    if not any(p.startswith(ADAPTED + "/") for p, _ in git_changes(repo)):
        show_suggestions(repo)
        kept_suggestions(repo).unlink(missing_ok=True)
        if onboarded(repo):
            say("adapt", "exists", "the agent changed nothing")
            return refresh_section(repo)
        raise Fail(f"the adapting agent wrote nothing under {ADAPTED}/ (is it gitignored?)")
    write_section(repo)
    unresolved = review_with_fixes(repo, project, adapter, reviewer, before, design_lead)
    if unresolved is not None:
        print(f"\nThe review did not pass (at most {MAX_FIX_ROUNDS} rounds of fixes). It said:\n{unresolved}\n")
        say("adapt", "stopped", f"nothing committed, no Orca setup. Owner: fix {ADAPTED}/ and run again, or remove it")
        return False
    changes = [(p, m) for p, m in git_changes(repo) if ours(repo, p)]
    show_changes(repo, changes)
    if not owner_says_yes():
        say("adapt", "stopped", "files left uncommitted, no Orca setup. Run again in a terminal to answer")
        return False
    check_agents_md(repo)  # the owner may have edited meanwhile; only what the commit carries matters here
    check_gitignore(repo)
    commit_adapted(repo, [p for p, _ in changes])
    kept_suggestions(repo).unlink(missing_ok=True)
    return True


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(allow_abbrev=False, prog="project-setup", description=__doc__.split("\n\n")[0])
    ap.add_argument("target")
    ap.add_argument("--host")
    ap.add_argument("--name")
    ap.add_argument("--dest", default=str(Path.home() / "code"))
    ap.add_argument("--coordinator", default="claude/opus")
    ap.add_argument("--design-lead", default="claude/opus")
    ap.add_argument("--trust-folder", action="store_true",
                    help="answer Claude Code's 'Do you trust this folder?' with yes for the repo, without asking "
                         "(for unattended runs)")
    ap.add_argument("--no-design-lead", action="store_true",
                    help="no design lead (projects without a frontend): only the coordinator is started")
    ap.add_argument("--write-orca-yaml", action="store_true",
                    help="write the drafted setup script as orca.yaml in the repo (uncommitted) instead of .cotal/")
    ap.add_argument("--reviewer", default="claude/opus",
                    help="default harness/model of the reviewer persona; leads pick one per lane from the tiers")
    ap.add_argument("--permission-mode", default="auto")
    ap.add_argument("--port", type=int)
    table = ap.add_mutually_exclusive_group()
    table.add_argument("--tiers", help="a full tier table to use as it is")
    table.add_argument("--opencode", choices=("hosted", "own", "none"),
                       help="how OpenCode lanes run, answered without a terminal: hosted (sandbox required), own "
                            "(own models or gateway, no sandbox; needs --opencode-model) or none (Claude only)")
    ap.add_argument("--opencode-model", help="with --opencode own: the provider/model for OpenCode tiers. Writes no "
                                             "sandbox: only for a gateway you run yourself")
    ap.add_argument("--no-start", action="store_true")
    ap.add_argument("--private", action="append", default=[], metavar="GLOB",
                    help="a tracked file or folder the onboarding agents must not read, relative to the repo root "
                         "(repeatable, e.g. 'shot*.png' or 'private/**'); git-ignored paths are always denied")
    ap.add_argument("--adapter", default="claude/sonnet",
                    help="harness/model of the agent that adapts the project's files")
    ap.add_argument("--adapt-reviewer", default="claude/opus",
                    help="harness/model that reviews the adapted files; must be a different model from --adapter")
    again = ap.add_mutually_exclusive_group()
    again.add_argument("--readapt", action="store_true", help="adapt the project again although it was done before")
    again.add_argument("--refresh", action="store_true",
                       help="onboarded project: re-render the personas in .cotal/, reinstall the skill, say which "
                            "running agents need a restart; keeps .cotal/lanes.tsv, starts and commits nothing")
    again.add_argument("--skip-adapt", action="store_true", help="only the Orca setup: no adapting agent, no commit")
    argv = sys.argv[1:] if argv is None else argv
    a = ap.parse_args(argv)

    if os.geteuid() == 0:
        print("project-setup: refusing to run as root; agents run as a normal user", file=sys.stderr)
        return 2
    if a.permission_mode not in MODES:
        print(f"project-setup: --permission-mode must be one of {', '.join(MODES)}", file=sys.stderr)
        return 2
    coord = harness_model(a.coordinator)
    lead = None if a.no_design_lead else harness_model(a.design_lead)
    reviewer = harness_model(a.reviewer)
    adapter, adapt_reviewer = harness_model(a.adapter), harness_model(a.adapt_reviewer)
    for g in a.private:
        if not g or g.startswith(("/", "~", "!")) or ".." in Path(g).parts or RULE_UNSAFE & set(g) - set("*?[]"):
            print(f"project-setup: --private takes a glob relative to the repo root, got {g!r}", file=sys.stderr)
            return 2
    PRIVATE_GLOBS[:] = a.private
    for flag, pin in (("--coordinator", coord), ("--design-lead", lead), ("--reviewer", reviewer)):
        if pin and pin[0] == "opencode" and pin[1].startswith(HOSTED_OPENCODE):
            print(f"project-setup: {flag} {pin[0]}/{pin[1]}: a hosted OpenCode model runs only inside the sandbox, and "
                  "a Cotal agent cannot run there yet. Use claude/<model>, or an opencode/<provider>/<model> on a "
                  "gateway you run yourself", file=sys.stderr)
            return 2
    if not a.skip_adapt and not a.refresh and {adapter[0], adapt_reviewer[0]} != {"claude"}:
        print("project-setup: --adapter and --adapt-reviewer must be claude/<model>: these agents read the whole "
              "project, and a third-party lane may not read private data", file=sys.stderr)
        return 2
    if not a.skip_adapt and not a.refresh and adapter[1] == adapt_reviewer[1]:
        print(f"project-setup: --adapter and --adapt-reviewer must be different models, both are {adapter[1]}",
              file=sys.stderr)
        return 2
    if a.opencode_model and a.opencode != "own":
        print("project-setup: --opencode-model only goes with --opencode own", file=sys.stderr)
        return 2
    if a.opencode_model and not usable_own_model(a.opencode_model):
        print("project-setup: --opencode-model must be provider/model, and not a hosted opencode/ or opencode-go/ "
              "model: those need the sandbox", file=sys.stderr)
        return 2
    if a.opencode == "own" and not a.opencode_model and not has_terminal():
        print("project-setup: --opencode own without a terminal needs --opencode-model", file=sys.stderr)
        return 2
    tiers = Path(a.tiers or HERE / "templates" / "lanes.tsv").expanduser()
    if a.refresh:
        ignored = [f for f in ("--coordinator", "--design-lead", "--no-design-lead", "--permission-mode", "--opencode",
                               "--opencode-model")
                   if any(x == f or x.startswith(f + "=") for x in argv)]
        if ignored:
            print(f"project-setup: {' '.join(ignored)} has no effect with --refresh: each persona keeps what it "
                  "has (only --reviewer is used, for a reviewer persona that is missing)", file=sys.stderr)
            return 2
    if a.host:
        return on_host(a.host, argv, a.target)
    if not tiers.is_file():
        print(f"project-setup: tier table {tiers} not found", file=sys.stderr)
        return 2
    global ORCA
    if a.refresh:
        add_orca_cli_to_path()
        ORCA = orca_cli()
        try:
            host_hygiene()
            d = Path(a.target).expanduser().resolve()
            top = run(["git", "rev-parse", "--show-toplevel"], cwd=d, check=False) if d.is_dir() else None
            if top is None or top.returncode != 0:
                raise Fail(f"{d} is not an existing git repository; --refresh only works on a set-up project")
            say("repo", "exists", top.stdout.strip())
            return refresh(Path(top.stdout.strip()), a.name or "", a.permission_mode, tiers, reviewer)
        except Fail as e:
            print(f"project-setup: {e}", file=sys.stderr)
            return 1
    add_orca_cli_to_path()
    ORCA = orca_cli()
    # Cotal's Orca driver otherwise tries `orca-ide`, then whatever `orca` is on PATH.
    os.environ.setdefault("COTAL_ORCA_BIN", ORCA)
    needed = {coord[0]} | ({lead[0]} if lead else set())
    base = a.name or re.sub(r"\.git$", "", a.target.rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1])
    try:
        preflight(needed)
        host_hygiene()
        repo = resolve_repo(a.target, Path(a.dest).expanduser(), slug(base))
        beads_note(repo)
        tier_text = choose_tiers(repo, a, tiers)
        tier_harnesses = {h for _, h, _, _ in check_tier_table(tier_text)} & set(HARNESSES)
        tier_harnesses.add(reviewer[0])  # started per lane, like a tier's harness
        missing_tier = sorted(h for h in tier_harnesses if not shutil.which(h))
        if missing_tier:
            print(f"project-setup: note: tier harness not on PATH: {' '.join(missing_tier)}", file=sys.stderr)
        # An agent tab can't answer Claude's first-start trust prompt, and the launch times out on it. Trusting the
        # folder is the owner's call, so it is never written for them.
        if "claude" in needed and not a.no_start:
            ensure_claude_trust(repo, record=a.trust_folder)
        project = a.name or repo.name
        if not a.skip_adapt and not onboard(repo, project, adapter, adapt_reviewer, a.readapt, lead is not None):
            return STOPPED
        space = slug(project)
        repo_id = orca_repo(repo)
        skills()
        cotal_space(repo, space)
        if "claude" in needed | tier_harnesses:
            claude_wiring(repo, space)
        personas_and_tiers(repo, project, coord, lead, reviewer, a.permission_mode, tier_text)
        project_table = repo / ".cotal" / "lanes.tsv"
        setup_script(repo, a.write_orca_yaml)
        if a.no_start:
            opencode_key_check(repo, space, project_table)
            say("start", "skipped", "--no-start")
            return 0
        mgr_started = start_stack(repo, space, a.port)
        opencode_key_check(repo, space, project_table, mgr_started)
        spawn(repo, space, "coordinator", *coord, a.permission_mode, repo,
              "Read AGENTS.md and the orca-cotal-lanes skill, then tell the owner in one line that you are ready.")
        wt = None
        if lead:
            wt, created = design_worktree(repo, repo_id)
            if created:
                setup_done = wait_for_setup(wt, "design-lead")
                before = {t["handle"] for t in worktree_terminals(wt)}
            spawn(repo, space, "design-lead", *lead, a.permission_mode, wt,
                  "Read AGENTS.md and the orca-cotal-lanes skill, then cotal_dm coordinator one line: ready.")
            if created:
                # Only now, so the worktree is never empty when the agent starts: an empty worktree may refuse the
                # spawn and strand the name. A Setup tab that never finished stays, to read.
                close_startup_tabs(wt, before, setup_done)
                jrun([ORCA, "terminal", "create", "--worktree", f"path:{wt}", "--json"])  # the owner's shell
        verify(repo, space, wt)
        print(f"summary: {project} · space {space} · broker 127.0.0.1:{record(repo).get('port')} · orca repo {repo_id}")
        print(f"  open Orca: the project {repo.name}, its main checkout (coordinator)"
              + (" and child task design-lead" if lead else ""))
        return 0
    except Fail as e:
        print(f"project-setup: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
