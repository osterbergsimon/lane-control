#!/usr/bin/env python3
"""lane-sweep: find merged, parked, stuck and broken lanes (Orca worktrees that are not a main checkout) on this
machine (spec section 8; reliability.md entry 30).

  lane-sweep                    report only
  lane-sweep --apply            also remove the lanes the rules below allow
  lane-sweep --stuck-hours N    stuck after N hours without activity (default 6; the night manager uses 2)
  lane-sweep --precheck         for an Orca automation's precheck: exit 0 only when a finding is new since the
                                last --precheck run (a standing finding wakes nobody twice); prints the new ones
  lane-sweep --changes          print the findings the last --precheck run found new (what its agent routes)

A merged lane is removed (--apply) only if all hold: its branch has a merged PR and HEAD is that PR's head or behind
it; `git status --porcelain --untracked-files=normal` is empty, whatever git's config says; no Orca terminal of it
printed anything for 30 minutes; and no agent process (claude, opencode, codex) has its cwd inside the worktree.
Otherwise MERGED-KEEP says why. When the sweep cannot tell (the process list or an agent's cwd cannot be read, a
terminal has no lastOutputAt, Orca's terminal list is cut short), it keeps the lane: it fails closed. Right before
removing it reads the lane again (HEAD, status, terminals, agents), so nothing it saw before its gh calls decides.
An open-PR lane is removed the same way (owner, 2026-11-19) when its PR's head is exactly HEAD, the tree is clean,
no terminal printed for 30 minutes and no agent runs in it: the worktree then holds nothing GitHub lacks, and a fix
round checks the PR branch out into a new worktree. In report mode such a lane is listed as PR-PARKED, which is
information only (it waits on the owner) and not a finding. Removing closes the lane's terminals and runs `orca-ide
worktree rm --delete-branch`; the PR and the remote branch are kept. Nothing else is ever removed.

The PR is found by core/prlookup.py: first by the lane's upstream branch when the upstream is that same branch on a
real remote (`x` for a local `x` or `<user>/x`), else its local name, never by a base branch it tracks (a lane on
`origin/develop` would match develop's old merged PRs); then, when the name finds none that holds HEAD and no open one,
by the PR whose head commit is HEAD (a lane Orca recreated has a local `x-2` with no upstream). CHECK means GitHub
could not be asked, which is never the same as no PR. Stuck: no activity for --stuck-hours, where activity is the
newest of Orca's lastActivityAt (which alone can be days old), the last push, the last commit and the last terminal
output, and not parked. Parked: an open PR, a clean tree, and either the PR's head is HEAD, or HEAD is behind the
pushed branch with no live terminal.

Worktrees on another Orca host (hostId not local) are left to that machine's sweep. Lanes listed in
~/.config/lane-control/lane-sweep.hold (one worktree path per line, `#` comments; LANE_SWEEP_HOLD) are skipped (`~`
expands; an entry that matches no worktree is named on stderr). Folder workspaces (not git) are skipped. With
machine.conf, each line ends `owner=<coordinator>`: the coordinator whose checkout the lane belongs to. Exit: 0
nothing found, 10 something reported; with --precheck 0 something new, 1 nothing new; 2 Orca or the machine could
not be read (Orca, the process list, the hold file). An agent is any process whose command line names claude,
opencode or codex; "cannot tell" comes only from one that can really be an agent (argv[0] is one of them, or an
interpreter running one) whose cwd cannot be read, and stderr names its pid and command.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
import machineconf  # noqa: E402
import prlookup  # noqa: E402

QUIET_MIN = 30
STATE = "lane-sweep.json"
AGENT = re.compile(r"claude|opencode|codex")  # anywhere in the command line, as `pgrep -f` matched it
# What can really be an agent, for a process whose cwd cannot be read: the program itself, or an interpreter running it.
AGENT_NAME = re.compile(r"\.?(claude|opencode2?|codex)(-wrapped)?")
INTERPRETER = re.compile(r"(node|bun|python[0-9.]*)")


class SweepError(Exception):
    pass


def orca(*args) -> dict:
    try:
        r = subprocess.run([machineconf.orca_cli(), *args, "--json"], capture_output=True, text=True, timeout=120)
        data = json.loads(r.stdout or "{}")
    except (OSError, subprocess.TimeoutExpired, ValueError) as e:
        raise SweepError(f"orca-ide {' '.join(args)}: {e}") from None
    if r.returncode != 0 or not data.get("ok", False):
        msg = (data.get("error") or {}).get("message") or r.stderr.strip() or f"exit {r.returncode}"
        raise SweepError(f"orca-ide {' '.join(args)}: {msg}")
    return data.get("result") or {}


def terminals() -> list:
    """Every Orca terminal; a list Orca cut short would make a lane's terminals look absent, so it stops the sweep."""
    res = orca("terminal", "list", "--limit", "100000")
    if res.get("truncated"):
        raise SweepError(f"orca-ide terminal list is truncated ({res.get('totalCount', '?')} terminals): not sweeping")
    return res.get("terminals") or []


def git(path, *args, timeout=60) -> "str | None":
    try:
        r = subprocess.run(["git", "-C", str(path), *args], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def is_ancestor(path, a: str, b: str) -> bool:
    return bool(a and b) and subprocess.run(["git", "-C", str(path), "merge-base", "--is-ancestor", a, b],
                                            capture_output=True).returncode == 0


def is_dirty(path) -> bool:
    """Uncommitted or untracked files; untracked are listed whatever status.showUntrackedFiles says. True when git
    cannot tell."""
    out = git(path, "status", "--porcelain", "--untracked-files=normal")
    return out is None or out != ""


def can_be_agent(argv: list) -> bool:
    """argv[0] is claude, opencode(2) or codex, or an interpreter (node, bun, python) whose script is one of them."""
    if not argv:
        return False
    if AGENT_NAME.fullmatch(os.path.basename(argv[0])):
        return True
    if INTERPRETER.fullmatch(os.path.basename(argv[0])):
        script = next((a for a in argv[1:] if not a.startswith("-")), "")
        base = os.path.basename(script)
        stem = base.rsplit(".", 1)[0] if "." in base else base
        return bool(AGENT_NAME.fullmatch(stem) or any(re.fullmatch(r"(claude|opencode2?|codex)([-.].*)?", part)
                                                      for part in Path(script).parts[:-1]))
    return False


class Agents:
    """The cwd of every agent process of this user (LANE_PROC_DIR, default /proc): any process whose command line
    names claude, opencode or codex. `blocking` lists the processes that can be an agent (can_be_agent) and whose cwd
    cannot be read: they could be in any lane, so every lane is kept while there is one."""

    def __init__(self):
        proc, uid = Path(os.environ.get("LANE_PROC_DIR") or "/proc"), os.getuid()
        self.cwds, self.blocking = [], []
        try:
            entries = [e for e in proc.iterdir() if e.name.isdigit()]
        except OSError as e:
            raise SweepError(f"cannot list processes in {proc} ({e}): cannot tell where agents run") from None
        for e in entries:
            try:
                if e.stat().st_uid != uid or int(e.name) == os.getpid():
                    continue
                argv = [a.decode(errors="replace") for a in (e / "cmdline").read_bytes().split(b"\0") if a]
            except (OSError, ValueError):
                continue  # gone while we looked, or not ours to read: it shows no agent
            cmd = " ".join(argv)
            if not AGENT.search(cmd):
                continue
            try:
                self.cwds.append(os.readlink(e / "cwd").removesuffix(" (deleted)"))
            except (FileNotFoundError, ProcessLookupError):
                continue
            except OSError:
                if can_be_agent(argv):
                    self.blocking.append(f"pid {e.name} ({cmd[:120]})")

    @property
    def unknown(self) -> bool:
        return bool(self.blocking)

    def why(self, path: str) -> str:
        """Why an agent keeps this lane, or ''."""
        real = os.path.realpath(path)
        if any(inside(c, real) or inside(c, path) for c in self.cwds):
            return "an agent is still running in it"
        if self.unknown:
            return "cannot tell: an agent process's cwd cannot be read"
        return ""


def inside(cwd: str, path: str) -> bool:
    return cwd == path or cwd.startswith(path.rstrip("/") + "/")


def hold_entries() -> list:
    f = Path(os.environ.get("LANE_SWEEP_HOLD") or Path.home() / ".config" / "lane-control" / "lane-sweep.hold")
    try:
        lines = f.read_text().splitlines()
    except FileNotFoundError:
        return []
    except OSError as e:
        raise SweepError(f"cannot read the hold file {f} ({e}): not sweeping") from None
    entries = [re.sub(r"\s*#.*", "", x).strip() for x in lines]
    return [e for e in entries if e]


def held(path: str, entries: list) -> "str | None":
    real = os.path.realpath(path)
    for e in entries:
        x = os.path.expanduser(e)
        if x == path or os.path.realpath(x) == real:
            return e
    return None


def owners() -> dict:
    """{realpath of a coordinator's checkout: its name} from machine.conf; empty without one."""
    try:
        return {os.path.realpath(c.checkout): c.name for c in machineconf.coordinators(machineconf.load())}
    except machineconf.ConfError:
        return {}


def owner_of(path: str, table: dict) -> str:
    common = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if not common or not table:
        return ""
    main = os.path.realpath(os.path.dirname(common) if os.path.basename(common) == ".git" else common)
    return f" owner={table[main]}" if main in table else ""


def quiet(mine: list, now: float) -> bool:
    """No terminal printed for QUIET_MIN minutes; one whose last output is unknown counts as active."""
    since = (now - QUIET_MIN * 60) * 1000
    return all(t.get("lastOutputAt") is not None and t["lastOutputAt"] <= since for t in mine)


class Sweep:
    def __init__(self, apply: bool, stuck_hours: float):
        self.apply, self.stuck_hours, self.now = apply, stuck_hours, time.time()
        self.found = False
        self.lines = []

    def say(self, line: str, finding: bool = True):
        self.lines.append(line)
        self.found = self.found or finding

    def recheck(self, wt: dict, path: str, head: str, want_head: str) -> tuple:
        """Read the lane again right before removing it: (why it stays, or '', its terminal handles now)."""
        try:
            mine = [t for t in terminals() if t.get("worktreePath") == path]
            agents = Agents()
        except SweepError as e:
            return f"cannot tell ({e})", []
        now_head = git(path, "rev-parse", "HEAD") or ""
        if now_head != head or (want_head and now_head != want_head and not is_ancestor(path, now_head, want_head)):
            return "HEAD moved during the sweep", []
        if is_dirty(path):
            return "uncommitted or untracked files", []
        if not quiet(mine, time.time()):
            return f"a terminal printed output in the last {QUIET_MIN} min (or its last output is unknown)", []
        why = agents.why(path)
        if why:
            return why, []
        return "", [t["handle"] for t in mine if t.get("handle")]

    def remove(self, wt: dict, handles: list) -> bool:
        for h in handles:
            try:
                orca("terminal", "close", "--terminal", h)
            except SweepError:
                pass
        try:
            orca("worktree", "rm", "--worktree", f"id:{wt['id']}", "--delete-branch")
            return True
        except SweepError:
            return False

    def lane(self, wt: dict, terms: list, agents: Agents, own: dict):
        path = wt.get("path") or ""
        branch = (wt.get("branch") or "").removeprefix("refs/heads/")
        if not os.path.isdir(path):
            return self.say(f"GONE   {path} (worktree path missing; Orca entry left)")
        if not branch and git(path, "rev-parse", "--git-dir") is None:
            return  # a folder workspace: no git, nothing to sweep
        tag = owner_of(path, own)
        if not branch:
            return self.say(f"DETACH {path} (no branch){tag}")
        mine = [t for t in terms if t.get("worktreePath") == path]
        handles = [t["handle"] for t in mine if t.get("handle")]
        is_quiet = quiet(mine, self.now)
        agent = agents.why(path)
        head = git(path, "rev-parse", "HEAD") or ""
        dirty = is_dirty(path)
        remote, rb = prlookup.upstream(path, branch)
        terminals_n = f"{len(handles)} terminal(s)"
        try:
            found = prlookup.find(path, path, branch, head)
        except prlookup.CouldNotCheck as e:
            return self.say(f"CHECK  {path} (could not check its PR: {e}){tag}")
        state = found["state"] if found else ""
        merged = found if state == "merged" else None
        opened = found if state == "open" else None

        if merged:
            n, prhead = merged["number"], merged.get("headRefOid", "")
            why = ""
            if not head or (head != prhead and not is_ancestor(path, head, prhead)):
                why = "commits after the merged PR head"
            elif dirty:
                why = "uncommitted or untracked files"
            elif not is_quiet:
                why = f"a terminal printed output in the last {QUIET_MIN} min (or its last output is unknown)"
            elif agent:
                why = agent
            if why:
                return self.say(f"MERGED-KEEP {path} (#{n} merged; kept: {why}){tag}")
            if not self.apply:
                return self.say(f"MERGED {path} (#{n} merged; would close {terminals_n} and remove){tag}")
            why, handles = self.recheck(wt, path, head, prhead)
            if why:
                return self.say(f"MERGED-KEEP {path} (#{n} merged; kept: {why}){tag}")
            if self.remove(wt, handles):
                return self.say(f"REMOVED {path} (#{n} merged; {len(handles)} terminal(s) closed){tag}")
            return self.say(f"MERGED-FAIL {path} (#{n} merged; worktree rm failed){tag}")

        if opened and head and opened.get("headRefOid") == head and not dirty and is_quiet and not agent:
            n = opened["number"]
            if not self.apply:
                return self.say(f"PR-PARKED {path} (#{n} open, pushed and clean; --apply would close {terminals_n} "
                                f"and remove it){tag}", finding=False)
            why, handles = self.recheck(wt, path, head, head)
            if why:
                return self.say(f"PR-KEEP {path} (#{n} open; kept: {why}){tag}", finding=False)
            if self.remove(wt, handles):
                return self.say(f"PR-REMOVED {path} (#{n} open, pushed and clean; recreate from its branch for a "
                                f"fix){tag}")
            return self.say(f"PR-FAIL {path} (#{n} open; worktree rm failed){tag}")

        times = [(wt.get("lastActivityAt") or 0) / 1000,
                 max([(t.get("lastOutputAt") or 0) / 1000 for t in mine] or [0])]
        commit = git(path, "log", "-1", "--format=%ct", "HEAD")
        times.append(int(commit) if commit and commit.isdigit() else 0)
        limit = self.stuck_hours * 3600
        if self.now - max(times) < limit:
            return
        git(path, "fetch", "-q", remote, rb, timeout=120)
        pushed = git(path, "log", "-1", "--format=%ct", f"{remote}/{rb}")
        times.append(int(pushed) if pushed and pushed.isdigit() else 0)
        if self.now - max(times) < limit:
            return
        # a PR whose head is HEAD has HEAD on GitHub, whether or not this branch has a remote branch to compare with
        parked = (opened is not None and not dirty
                  and (opened.get("headRefOid") == head
                       or (is_ancestor(path, "HEAD", f"{remote}/{rb}") and not any(t.get("connected") for t in mine))))
        if parked:
            return
        hours = int((self.now - max(times)) // 3600)
        if not found:
            pr = prlookup.none_found(branch, head)
        elif state == "closed":
            pr = f"no merged or open PR: #{found['number']} closed without a merge"
        else:
            pr = "no merged PR"
        self.say(f"STUCK  {path} (branch {branch}, no push, commit, terminal output or Orca activity for {hours} h, "
                 f"{pr}){tag}")


def state_file() -> Path:
    v = os.environ.get("XDG_CACHE_HOME")
    base = Path(v) if v and os.path.isabs(v) else Path.home() / ".cache"
    return base / "lane-control" / STATE


def key(line: str) -> str:
    """A finding's identity across runs: its tag and path (the hours of a STUCK line change every run)."""
    return " ".join(line.split()[:2])


def main(argv) -> int:
    ap = argparse.ArgumentParser(prog="lane-sweep", description=__doc__.split("\n\n")[0])
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--precheck", action="store_true")
    ap.add_argument("--changes", action="store_true")
    ap.add_argument("--stuck-hours", type=float, default=6)
    a = ap.parse_args(argv)
    if a.apply and (a.precheck or a.changes):
        ap.error("--precheck and --changes only report")
    sf = state_file()
    try:
        last = json.loads(sf.read_text())
    except (OSError, ValueError):
        last = {}
    if a.changes:
        print("\n".join(last.get("new", [])) or "no new findings")
        if last.get("new"):  # read once: a manual "Run now" (no precheck) resends nothing
            try:
                sf.write_text(json.dumps({**last, "new": []}, indent=1) + "\n")
            except OSError:
                pass
        return 0
    sweep = Sweep(a.apply, a.stuck_hours)
    try:
        wts = orca("worktree", "list").get("worktrees", [])
        terms = terminals()
        hold, own, agents = hold_entries(), owners(), Agents()
    except SweepError as e:
        print(f"lane-sweep: {e}", file=sys.stderr)
        return 2
    used = set()
    for wt in wts:
        if wt.get("isMainWorktree") or wt.get("isArchived") or wt.get("hostId") not in (None, "", "local"):
            continue  # a worktree on another Orca host (an SSH box) is that machine's own sweep's
        h = held(wt.get("path") or "", hold)
        if h:
            used.add(h)
            continue
        sweep.lane(wt, terms, agents, own)
    if agents.unknown:
        print("lane-sweep: cannot tell where every agent runs: the cwd of " + "; ".join(agents.blocking) +
              " cannot be read, so no lane was removed", file=sys.stderr)
    for e in hold:
        if e not in used:
            print(f"lane-sweep: hold entry {e!r} matches no lane", file=sys.stderr)
    findings = [x for x in sweep.lines if not x.startswith(("PR-PARKED", "PR-KEEP"))]
    if a.precheck:
        before = set(last.get("findings", []))
        # a lane gh could not be asked about this time keeps what it was (a passing gh failure wakes nobody)
        checks = {x.split()[1] for x in findings if x.startswith("CHECK")}
        kept = {k for k in before if k.split(" ", 1)[-1] in checks}
        new = [x for x in findings if key(x) not in before
               and not (x.startswith("CHECK") and any(k.split(" ", 1)[-1] == x.split()[1] for k in kept))]
        findings = [x for x in findings if not (x.startswith("CHECK") and x.split()[1] in
                                                {k.split(" ", 1)[-1] for k in kept})]
        try:
            sf.parent.mkdir(parents=True, exist_ok=True)
            keep = new or last.get("new", [])  # what the last waking run found, for its agent's --changes
            sf.write_text(json.dumps({"findings": sorted({key(x) for x in findings} | kept), "new": keep}, indent=1)
                          + "\n")
        except OSError as e:
            print(f"lane-sweep: cannot write {sf} ({e})", file=sys.stderr)
            return 2
        print("\n".join(new) or "nothing new")
        return 0 if new else 1
    for line in sweep.lines:
        print(line)
    if not sweep.found:
        print("nothing found")
    return 10 if sweep.found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
