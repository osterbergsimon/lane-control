[Unit]
Description=lane-control window guard (budget orders and the low-memory notice; spends no tokens)
StartLimitIntervalSec=0

[Service]
Environment="PATH=@PATH@"
ExecStart=/usr/bin/env bash "@REPO@/scripts/window-guard.sh"
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
