#!/usr/bin/env bash
# lane-tier: look one tier up in a project's tier table before opening a lane.
#
#   lane-tier <table> <tier>     prints harness=<h> model=<m> permission=<p>
#   lane-tier --check <table>    prints "<tier> <harness> <model>" per row (- for no model); nothing else is decided
#   lane-tier --model <model>    exit 0 when the model may run, 4 when it is refused (an opencode/ or opencode-go/
#                                model, whatever the harness); project-setup asks this for its standing roles
#
# Exit: 0 the tier may be started; 2 usage, a bad table or an unknown tier; 3 the tier's harness is none (skip it, one
# tier up); 4 refused: an OpenCode tier (harness opencode, or an opencode/ or opencode-go/ model whatever the harness
# cell says). Swift on OpenCode runs unsandboxed only in calvin, started by calvin's Orca coordinator, never through
# lane-tier; everywhere else there are no OpenCode lanes until the sandbox is back (model-routing.md, "Sandbox per
# tier"). Columns other than tier, harness, model and permission are ignored (a table from before may still have a
# sandbox column). The check is what the orca-cotal-lanes skill runs before cotal_spawn; --check only lists the rows.
set -u

die() { echo "lane-tier: $*" >&2; exit 2; }

if [ "${1:-}" = "--model" ]; then
  [ $# -eq 2 ] && [ -n "$2" ] || die "usage: lane-tier --model <model>"
  case $2 in
    opencode/*|opencode-go/*)
      cat >&2 <<MSG
lane-tier: refused: $2 is a hosted OpenCode model (opencode/ or opencode-go/). It runs unsandboxed only in calvin,
started there by calvin's Orca coordinator, never through lane-tier or project-setup (model-routing.md, "Sandbox per
tier").
MSG
      exit 4 ;;
  esac
  echo "model=$2 ok"
  exit 0
fi

check=""
if [ "${1:-}" = "--check" ]; then
  check=1
  [ $# -eq 2 ] || die "usage: lane-tier --check <table>"
  table=$2 tier=""
else
  [ $# -eq 2 ] || die "usage: lane-tier <table> <tier>"
  table=$1 tier=$2
fi
if [ ! -r "$table" ]; then
  case $table in */.cotal/lanes.tsv) die "cannot read the tier table $table: it moved to the project's settings store (~/.config/lane-control/projects/); run project-setup --refresh on the project, then restart this agent, so its persona names the new path" ;; esac
  die "cannot read the tier table $table"
fi

# Columns are found by name, so a project's table may order them its own way.
out=$(awk -F'\t' -v want="$tier" -v check="$check" '
  { sub(/\r$/, "") }
  /^#/ || /^[ \t]*$/ { next }
  !seen {
    seen = 1
    for (i = 1; i <= NF; i++) col[$i] = i
    if (!col["tier"] || !col["harness"] || !col["model"] || !col["permission"]) {
      print "the header needs tier, harness, model and permission columns"; bad = 1; exit
    }
    next
  }
  {
    h = $col["harness"]
    if ($col["tier"] == "" || h == "") { print "a row has an empty tier or harness cell"; bad = 1; exit }
    if ($col["tier"] ~ /[ \t]/ || h ~ /[ \t]/ || $col["model"] ~ /[ \t]/ || $col["permission"] ~ /[ \t]/) {
      print "tier " $col["tier"] ": a cell contains a space"; bad = 1; exit
    }
    if (check) print $col["tier"], h, ($col["model"] == "" ? "-" : $col["model"])
    else if ($col["tier"] == want) {
      print h "\037" $col["model"] "\037" $col["permission"]; found = 1; exit   # not a tab: read would merge empty cells
    }
  }
  END {
    if (bad) exit 2
    if (!seen) { print "the table has no header"; exit 2 }
    if (!check && !found) { print "no tier " want " in the table"; exit 2 }
  }
' "$table")
rc=$?
[ "$rc" -eq 0 ] || die "$table: $out"
if [ -n "$check" ]; then
  printf '%s\n' "$out"
  exit 0
fi

IFS=$'\037' read -r harness model permission <<<"$out"
if [ "$harness" = none ]; then
  echo "lane-tier: tier $tier has harness none: skip it and go one tier up" >&2
  exit 3
fi
opencode_tier=
[ "$harness" = opencode ] && opencode_tier=1
case $model in opencode/*|opencode-go/*) opencode_tier=1 ;; esac
if [ -n "$opencode_tier" ]; then
  cat >&2 <<MSG
lane-tier: refused: tier $tier is an OpenCode tier (harness $harness, model $model).
Swift on OpenCode runs unsandboxed only in calvin, where calvin's Orca coordinator starts it as an Orca worker;
lane-tier never starts it, and outside calvin no hosted global-region model runs bare (model-routing.md, "Sandbox per
tier"). Do not start it with cotal_spawn: go one tier up, and tell the owner that $table still has this row.
MSG
  exit 4
fi
printf 'harness=%s model=%s permission=%s\n' "$harness" "$model" "$permission"
