#!/usr/bin/env python3
"""lane-extras: the extras the owner adds to the agents' environments (core/extras.py has what each kind does and
where each harness reads it). Run through the front door:

  lane-control project extras add <project> <one kind> [--for lanes|coordinator|reviewer|all]... [--name N]
  lane-control project extras list <project> [--json]
  lane-control project extras remove <project> <kind:name | name>
  lane-control machine extras add <one kind> [--for ...] [--name N]        every project on this machine
  lane-control machine extras list [--json]
  lane-control machine extras remove <kind:name | name>                    a default design skill is turned off
  lane-control lane prepare <project> <worktree> --role lanes|reviewer     (the coordinator, before a worker starts)

Kinds:
  --skill <git-url>@<commit>[:<path>]                      a skill pinned at a full commit
  --mcp <name> [--env NAME]... -- <command> [args]         an MCP server; each --env names a variable the server
                                                           reads from the agent's environment (never a value)
  --persona <name> --prompt-file <path> [--tier swift|standard|deep] [--harness claude|opencode]
                                                           a lane role the coordinator can brief a lane with
  --agent-hook <event> [--matcher <tools>] -- <script>     PreToolUse, PostToolUse, SessionStart or Stop; the script
                                                           a path outside any project repo, or <git-url>@<commit>:<path>
  --permission allow|deny <rule>                           Claude's rule syntax, e.g. 'Bash(npm test:*)'
  --plugin claude:<plugin>@<marketplace>@<version> | opencode:<package>@<version>
  --env NAME=value                                         a non-secret environment variable

A script or MCP command inside a project checkout is refused unless --allow-repo-path is given. The same id again
replaces the extra (and accepts a changed file). A project's extras add to the machine's. After a change, run
`lane-control project refresh <project>` for each project it touches: that puts them in place for the coordinator
and renders the personas; lanes and reviewers get theirs from `lane prepare` as they start."""
import argparse
import importlib.util
import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parents[2]


def _load(name, rel):
    spec = importlib.util.spec_from_file_location(name, HERE / rel)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


X = _load("lc_extras", "core/extras.py")
KIND_FLAGS = {"skill": "--skill", "mcp": "--mcp", "persona": "--persona", "agent-hook": "--agent-hook",
              "permission": "--permission", "plugin": "--plugin"}


def add_parser(prog: str, project: bool) -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog=prog, add_help=True)
    if project:
        ap.add_argument("project")
    ap.add_argument("--skill")
    ap.add_argument("--mcp")
    ap.add_argument("--persona")
    ap.add_argument("--agent-hook", dest="agent_hook")
    ap.add_argument("--permission", nargs=2, metavar=("ALLOW_OR_DENY", "RULE"))
    ap.add_argument("--plugin")
    ap.add_argument("--env", action="append", default=[])
    ap.add_argument("--for", dest="for_", action="append", default=[])
    ap.add_argument("--name")
    ap.add_argument("--prompt-file", dest="prompt_file")
    ap.add_argument("--tier")
    ap.add_argument("--harness")
    ap.add_argument("--matcher")
    ap.add_argument("--allow-repo-path", dest="allow_repo_path", action="store_true")
    return ap


def kind_of(a) -> tuple:
    given = [(k, getattr(a, k.replace("-", "_"))) for k in KIND_FLAGS if getattr(a, k.replace("-", "_"))]
    if not given and len(a.env) == 1 and "=" in a.env[0]:
        return "env", a.env[0]
    if len(given) != 1 or (given[0][0] != "mcp" and a.env):
        raise X.ExtrasError("give exactly one kind: --skill, --mcp, --persona, --agent-hook, --permission, --plugin "
                            "or --env NAME=value (one at a time)")
    return given[0]


def target(group: str, a):
    """(store file, label, roots, private globs, project root or None) for machine or project."""
    if group == "machine":
        return X.machine_file(), "this machine", X.roots(), [], None
    root, st, store = X.find_project(a.project)
    private = [g for g in st.get("private") or [] if isinstance(g, str)]
    return X.project_file(store), f"project {st.get('name') or root.name}", [*X.roots(), root], private, root


def cmd_add(group: str, argv: list) -> int:
    head, tail = (argv[:argv.index("--")], argv[argv.index("--") + 1:]) if "--" in argv else (argv, [])
    if "--agent-hook" in head and len(tail) > 1 and tail[1].startswith("--"):
        head, tail = head + tail[1:], tail[:1]  # a hook names one script: options after it are still options
    a = add_parser(f"lane-control {group} extras add", group == "project").parse_args(head)
    kind, value = kind_of(a)
    if kind not in ("mcp", "agent-hook") and tail:
        raise X.ExtrasError(f"`--` and a command are for --mcp and --agent-hook only, not --{kind}")
    path, label, roots, private, root = target(group, a)
    opts = {"name": a.name, "for": a.for_, "command": tail, "env": a.env if kind == "mcp" else [],
            "matcher": a.matcher, "prompt_file": a.prompt_file, "tier": a.tier, "harness": a.harness,
            "allow_repo_path": a.allow_repo_path}
    entry, warnings = X.make(kind, value, opts, roots, private)
    for w in warnings:
        print(w, file=sys.stderr)
    state = X.add(path, entry)
    print(f"{state} {X.ident(entry)} for {', '.join(entry['for'])} ({label}): {X.describe(entry)}")
    where = f"lane-control project refresh {root}" if root else \
        "lane-control project refresh <project> for each project on this machine"
    print(f"next: {where}")
    return 0


def rows_of(store) -> list:
    return [{**{k: e.get(k) for k in ("kind", "name", "origin")}, "id": X.ident(e), "for": e.get("for") or
             list(X.SCOPES), "what": X.describe(e)} for e in X.effective(store)]


def cmd_list(group: str, argv: list) -> int:
    ap = argparse.ArgumentParser(prog=f"lane-control {group} extras list")
    if group == "project":
        ap.add_argument("project")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args(argv)
    store = X.find_project(a.project)[2] if group == "project" else None
    rows = rows_of(store)
    off = X.load(X.machine_file())["off"]
    if a.json:
        print(json.dumps({"extras": rows, "off": off}, indent=2))
        return 0
    title = f"extras of {a.project} (the machine's, then its own)" if group == "project" else \
        "extras of this machine (defaults and the machine's own; every project gets them)"
    print(title)
    if not rows:
        print("  none")
    w = max([len(r["id"]) for r in rows] + [10])
    for r in rows:
        print(f"  {r['id']:<{w}}  {r['origin']:<7}  {','.join(r['for']):<26}  {r['what']}")
    for x in off:
        print(f"  {x:<{w}}  off      (a default turned off: lane-control machine extras add brings it back)")
    print("by role:")
    for s in X.SCOPES:
        ids = [r["id"] for r in rows if s in r["for"]]
        print(f"  {s}: {', '.join(ids) or 'none'}")
    return 0


def cmd_remove(group: str, argv: list) -> int:
    ap = argparse.ArgumentParser(prog=f"lane-control {group} extras remove")
    if group == "project":
        ap.add_argument("project")
    ap.add_argument("id")
    a = ap.parse_args(argv)
    path, label, *_rest, root = target(group, a)
    print(f"{X.remove(path, a.id, group == 'machine')} ({label})")
    where = f"lane-control project refresh {root}" if root else \
        "lane-control project refresh <project> for each project on this machine"
    print(f"next: {where} (it takes it out of the folders lane-control put it in)")
    return 0


def cmd_prepare(argv: list) -> int:
    ap = argparse.ArgumentParser(prog="lane-control lane prepare", description=(
        "Put a lane's or reviewer's extras in its worktree before its worker starts (Claude and OpenCode). A reviewer "
        "in the lane's worktree adds its own: the folder then holds both roles' extras."))
    ap.add_argument("project")
    ap.add_argument("worktree")
    ap.add_argument("--role", required=True, choices=("lanes", "reviewer"))
    a = ap.parse_args(argv)
    root, st, store = X.find_project(a.project)
    wt = Path(a.worktree).expanduser().resolve()
    if not wt.is_dir():
        raise X.ExtrasError(f"{wt} is not a folder")
    repos = [root, *[Path(x) for x in st.get("attached") or [] if isinstance(x, str)]]
    mine = X.common_dir(wt)
    if mine is None or mine not in [X.common_dir(r) for r in repos if r.is_dir()]:
        raise X.ExtrasError(f"{wt} is not a worktree of {root} (or of a repo attached to it)")
    if wt in [r.resolve() for r in repos]:
        raise X.ExtrasError(f"{wt} is a main checkout, the coordinator's folder: lane-control project refresh puts "
                            "its extras there")
    try:
        rec = json.loads(X.record_file(wt).read_text())
        had = [s for s in rec.get("scopes", []) if s in ("lanes", "reviewer")]
    except (OSError, ValueError, AttributeError):
        had = []
    scopes = [s for s in X.SCOPES if s in set(had) | {a.role}]
    entries = X.effective(store)
    chosen = {}
    for s in scopes:
        for e in X.for_scope(entries, s):
            chosen[X.ident(e)] = e
    lines, problems = X.apply_folder(wt, list(chosen.values()), scopes)
    for line in lines:
        print(f"prepare: {line}")
    for p in problems:
        print(f"prepare: problem: {p}")
    print(f"prepare: {'done' if not problems else 'incomplete'} ({', '.join(scopes)} extras in {wt}; "
          f"{len(chosen)} extra(s))")
    return 1 if problems else 0


def main(argv=None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    try:
        if argv[:1] == ["prepare"]:
            return cmd_prepare(argv[1:])
        if argv[:1] in (["project"], ["machine"]) and len(argv) > 1 and argv[1] in ("add", "list", "remove"):
            return {"add": cmd_add, "list": cmd_list, "remove": cmd_remove}[argv[1]](argv[0], argv[2:])
    except X.ExtrasError as e:
        print(f"lane-control: {e}", file=sys.stderr)
        return 1
    asked = any(x in ("-h", "--help", "help") for x in argv[:2])
    print("usage: lane-control project extras add|list|remove <project> ..., lane-control machine extras "
          "add|list|remove ...,\n       lane-control lane prepare <project> <worktree> --role lanes|reviewer\n\n"
          + __doc__, file=sys.stdout if asked else sys.stderr)
    return 0 if asked else 2


if __name__ == "__main__":
    sys.exit(main())
