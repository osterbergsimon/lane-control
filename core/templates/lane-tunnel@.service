# lane-control: the reverse tunnel that lets SSH host %i reach this machine's Orca (native-Orca setup, direction 2:
# the host's coordinator runs lanes here). Written by core/scripts/lane-tunnel; its host and port are in the
# instance's env file. Same port at both ends, on 127.0.0.1 only, so the desktop's share link works on the host as is.
[Unit]
Description=lane-control tunnel: %i reaches this machine's Orca
After=network-online.target
# An always-on tunnel never gives up: ssh runs with BatchMode, so a key or card it cannot use ends it at once, but so does
# a network that is down for an hour, or a host that still holds the old forward (ExitOnForwardFailure); neither may
# leave the unit failed for good. The delay between tries grows instead (RestartSteps, RestartMaxDelaySec: systemd 254 or
# later; lane-tunnel writes a fixed RestartSec=30 for an older one). lane-tunnel start says when the first try fails.
StartLimitIntervalSec=0

[Service]
EnvironmentFile=@TUNNELS@/%i.env
ExecStart=/bin/sh -c 'exec "$${LANE_TUNNEL_SSH:-ssh}" $${SSH_CONFIG:+-F "$$SSH_CONFIG"} -N -o BatchMode=yes -o ConnectTimeout=15 -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R "127.0.0.1:$${PORT}:127.0.0.1:$${PORT}" "$$SSH_HOST"'
Restart=always
RestartSec=10
RestartSteps=6
RestartMaxDelaySec=5min

[Install]
WantedBy=default.target
