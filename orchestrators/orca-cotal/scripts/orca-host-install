#!/bin/sh
# Put Orca's server (orcad) and its node runtime on an SSH host, from this workstation's Orca install, so the host
# needs no downloads (nodejs.org, onorca.dev). Optionally start it and pair this desktop with it (no GUI click).
#
#   orca-host-install <ssh-host> [--from DIR | --bundle TAR] [--version V] [--pair [--no-tunnel] [--stop-stale]]
#                     [--port N] [--allow-root] [--appimage-root DIR]
#   orca-host-install <ssh-host> --tunnel [--port N]
#
# Without --pair: add the host in Orca (Settings > SSH, or import ~/.ssh/config) and connect; Orca finds this
# install and reuses it. With --pair: orcad runs on the host on 127.0.0.1:<port> (a systemd user unit when the host
# has a user manager, otherwise detached like the desktop starts it), a local ssh tunnel forwards the same port
# (systemd user unit orca-tunnel-<host>), and `orca environment add` saves it as environment <host>.
#
# Which orcad: by default the newest slot this desktop has built for the host's platform (ORCA_ARTIFACTS), so a box
# gets whatever the desktop has. To pin a box to a known-good server instead:
#   --version V   install orcad V: a slot's folder name (e.g. 0.1.0+b086a7d15d60), its own .version, or the
#                 app version its out/package.json records (e.g. 1.4.251, what "server too old" is about); letters,
#                 digits and . _ + - only. It is installed under the slot's own name. From the desktop's slots, from
#                 --from or from --bundle, that one, and an error listing what the source has when there is none. Given
#                 with a source that is one slot, V must be what that slot says it is, or nothing is copied.
#   --from DIR    take it from DIR instead of the desktop's slots: a slot folder (holds orcad.js and .runtime-node;
#                 its name is its version, with or without a leading "orcad-"; a .version that says another is
#                 refused as mislabelled), or a folder of slots
#                 (<DIR>/<platform>/<version>/ as ORCA_ARTIFACTS is laid out, or <DIR>/<version>/). Its node runtime
#                 comes from node/archives/node-*-linux-<arch>.tar.gz beside the slot folders, else as for the default.
#   --bundle TAR  the same from a tar (.tar, .tar.gz): unpacked in a temporary folder, refused when it names a path
#                 outside itself, an absolute or ".." link or a device. A tar that is one bare slot has no name, so
#                 --version must give it.
# --from and --bundle exclude each other. A node binary is always checked against the sha the slot names.
# An Orca app's own folder (resources/orcad-template, "the packaged app") is not a slot and is refused with a pointer:
# connect a host once from that Orca and give --from its ORCA_ARTIFACTS/<platform> folder.
#
# --no-tunnel: start orcad and print its pairing code, but set up no tunnel and save no environment.
# --tunnel: restore only the direction-1 tunnel (orca-tunnel-<host>) for a host this desktop has paired: the unit is
#   written again (as --pair writes it) and restarted, and proven; nothing is installed or started on the host, and no
#   environment is removed or added. The port is --port, else the one the unit here names. It needs Orca's server on
#   the host on that port and the environment saved here; when that environment does not answer through the restored
#   tunnel, it says so and points at --pair.
#
# A listening port is not proof (field report lc-l78). Before --pair changes anything on the host it lists every
# process of an older server slot there (a server, or a node helper such as the terminal daemon) with its pid, port,
# child processes and whether a daemon-v*.pid names it (a newer server adopted it). Only one with no child process
# that nothing adopted may be stopped, and only with --stop-stale or a yes in a terminal; the rest are left and named
# ("stopped orcad-<ver> pid <pid>", "left ..."). A server already serving the port from another slot is replaced only
# with that consent and when it is unused; without --version (or a yes) it is not replaced at all. A server of this
# build on another port, or orcad.service on another port, stops the run before anything changes, naming --port and
# the pid. After the start the host must run exactly one server of this slot, on this port, owning the listener
# ("one runtime orcad-<ver> pid <pid> on 127.0.0.1:<port>"); an older one left in use is named in a note.
# Where the host's systemd user manager has another SHELL than its passwd entry (a chsh does not reach a running
# manager), it is set to the passwd one before orcad starts ("SHELL <shell> (was <old>)"); a server that already ran is
# not restarted for it, and the line says how. The tunnel unit's ssh never multiplexes (ControlPath=none,
# ControlMaster=no), and it is proven by its own process owning the port, active/running, its restart counter not
# climbing over LANE_CHECK_SETTLE seconds (default 5).
# Output lines: "installed|exists orcad-<ver> - from <source>" (the slot folder, or the bundle; exists means a
# complete slot of that version is already on the host, not that its files were compared), "started|running orcad
# <port>", "stopped|left orcad-<ver> pid <pid> ...", "one runtime ...", "tunnel orca-tunnel-<host>.service ...", "paired|already-paired
# <host>".
# Env: LANE_SSH_CONFIG (a separate ssh config, passed as ssh -F), LANE_TUNNEL_WAIT (seconds for the tunnel to come up, default 20), ORCA_CLI (default orca-ide on PATH, else ~/.config/orca/linux-orca-cli-shim/orca), ORCA_ARTIFACTS (default ~/.config/orca/orcad-artifacts).
set -eu

die() { echo "orca-host-install: $*" >&2; exit "${2:-1}"; }
host=""; stop_stale=0; pair=0; tunnel=1; tunnel_only=0; port=6768; port_set=0; allow_root=0; appimage_root=""; from=""; bundle=""; want=""; want_set=0
while [ $# -gt 0 ]; do
  case $1 in
    --pair) pair=1 ;;
    --no-tunnel) tunnel=0 ;;
    --tunnel) tunnel_only=1 ;;
    --stop-stale) stop_stale=1 ;;
    --port) [ $# -ge 2 ] || die "--port needs a port" 2; port=$2; port_set=1; shift ;;
    --audit-script) audit_only=1 ;;
    --allow-root) allow_root=1 ;;
    --appimage-root) appimage_root=$2; shift ;;
    --from) [ $# -ge 2 ] || die "--from needs a folder" 2; from=$2; shift ;;
    --bundle) [ $# -ge 2 ] || die "--bundle needs a tar file" 2; bundle=$2; shift ;;
    --version) [ $# -ge 2 ] || die "--version needs a version" 2; want=$2; want_set=1; shift ;;
    -h|--help) sed -n '2,/^set -eu/{/^set -eu/d;s/^# \{0,1\}//;p;}' "$0"; exit 0 ;;
    -*) die "unknown option $1" 2 ;;
    *) [ -z "$host" ] || die "one host only" 2; host=$1 ;;
  esac
  shift
done
case $port in ''|*[!0-9]*) die "bad port: $port" 2 ;; esac
{ [ "$port" -ge 1 ] && [ "$port" -le 65535 ]; } || die "bad port: $port" 2

# The host's audit, run there with sh (`sh -s`, whatever the login shell): $1 the slot that should serve, $2 its port,
# $3 list | stop <pid>... | prove | shell | owns <pid>. It reads /proc; only stop and shell change anything.
audit_sh=$(cat <<'AUDIT'
ver=$1 port=$2 act=$3 me=$$
# list: "<pid> <slot> <role> <port|-> <children> <adopted> <unit>" for each process of this user that runs from a slot
# under ~/.orca-remote. role: server (node running an orcad.js) or helper (node with a slot's path in its argv);
# anything else (an editor or a pager on a slot's file) is not part of a server. children: its child processes (live
# terminals, agents). adopted: yes when a daemon-v*.pid file under ~/.orca or ~/.orca-remote names it (the terminal
# daemon a newer server keeps using). unit: yes when it is orcad.service's MainPID. One scan, not one per process.
list() {
  pre="$HOME/.orca-remote/orcad-"
  cands=$( { grep -l -a -F -e "$pre" /proc/[0-9]*/cmdline 2>/dev/null | sed 's|/cmdline$||'
             find /proc -mindepth 2 -maxdepth 2 -name cwd -lname "$pre*" 2>/dev/null | sed 's|/cwd$||'; } | sort -u)
  [ -n "$cands" ] || return 0
  # (cat goes on past a process that ended meanwhile; awk may stop at the first file it cannot open)
  kids=$(cat /proc/[0-9]*/status 2>/dev/null | awk '/^Pid:/ { p = $2 } /^PPid:/ { print p, $2 }')
  pids=$(find "$HOME/.orca" "$HOME/.orca-remote" -maxdepth 4 -name 'daemon-v*.pid' -exec cat {} + 2>/dev/null | tr -cs '0-9' ' ')
  mainpid=$(systemctl --user show orcad.service -p MainPID 2>/dev/null | sed -n 's/^MainPID=//p')
  for d in $cands; do
    p=${d#/proc/}
    [ "$p" != "$me" ] && [ -O "$d" ] || continue
    c=$(tr '\0' '\n' < "$d/cmdline" 2>/dev/null) || continue
    [ -n "$c" ] || continue
    case $(printf '%s\n' "$c" | head -n 1) in node|*/node) ;; *) continue ;; esac
    w=$(readlink "$d/cwd" 2>/dev/null || true)
    s=$(printf '%s\n%s/\n' "$c" "$w" | awk -v pre="$pre" 'index($0, pre) == 1 {
      r = substr($0, length(pre) + 1); sub(/\/.*/, "", r); if (r ~ /^[A-Za-z0-9._+-]+$/) { print r; exit } }')
    [ -n "$s" ] || continue
    if printf '%s\n' "$c" | grep -q -e '/orcad[.]js$' -e '^orcad[.]js$'; then role=server; else role=helper; fi
    pt=$(printf '%s\n' "$c" | awk 'f { print; exit } $0 == "--port" { f = 1 }')
    n=$(printf '%s\n' "$kids" | awk -v p="$p" '$2 == p' | wc -l | tr -d ' ')
    ad=no; case " $pids " in *" $p "*) ad=yes ;; esac
    un=no; [ "$p" != "${mainpid:-0}" ] || un=yes
    printf '%s %s %s %s %s %s %s\n' "$p" "$s" "$role" "${pt:--}" "$n" "$ad" "$un"
  done
}
gone() { [ -z "$(tr -d '\0' < "/proc/$1/cmdline" 2>/dev/null)" ]; }  # exited (a zombie has no command line)
# Whether pid $1 owns the listener on 127.0.0.1:$port; else say who does.
owns() {
  hex=$(printf ':%04X' "$port")
  inos=$(awk -v h="$hex" 'FNR > 1 && $4 == "0A" && substr($2, length($2) - 4) == h { print $10 }' /proc/net/tcp /proc/net/tcp6 2>/dev/null)
  [ -n "$inos" ] || { echo "not listening at all"; return 1; }
  for i in $inos; do
    if ls -l "/proc/$1/fd" 2>/dev/null | grep -q "socket:\[$i\]"; then return 0; fi
  done
  for d in /proc/[0-9]*; do
    [ -O "$d" ] || continue
    for i in $inos; do
      if ls -l "$d/fd" 2>/dev/null | grep -q "socket:\[$i\]"; then
        echo "held by pid ${d#/proc/} ($(tr '\0' ' ' < "$d/cmdline" 2>/dev/null | cut -c1-80))"; return 1
      fi
    done
  done
  echo "held by a process of another user"; return 1
}
case $act in
  list) list ;;
  stop)  # the pids named, each only while it is still of another slot, with no child process and not adopted
    shift 3
    now=$(list)
    rc=0 go=""
    for p in "$@"; do
      row=$(printf '%s\n' "$now" | awk -v p="$p" '$1 == p')
      set -- $row
      if [ -z "$row" ]; then echo "gone pid $p"; continue; fi
      if [ "$2" = "$ver" ] || [ "$5" != 0 ] || [ "$6" = yes ]; then
        echo "left orcad-$2 pid $p: in use now ($5 child processes, adopted $6)"; rc=1; continue
      fi
      if [ "$7" = yes ]; then systemctl --user stop orcad.service 2>/dev/null || true; fi
      kill -TERM "$p" 2>/dev/null || true
      go="$go $p:$2"
    done
    for x in $go; do
      p=${x%%:*} i=0
      while ! gone "$p" && [ $i -lt 5 ]; do i=$((i + 1)); sleep 1; done
      gone "$p" || { kill -KILL "$p" 2>/dev/null || true; sleep 1; }
      if gone "$p"; then echo "stopped orcad-${x#*:} pid $p"; else echo "could not stop orcad-${x#*:} pid $p"; rc=1; fi
    done
    exit $rc ;;
  prove)  # exactly one server of this slot, on this port, owning the listener; other slots' servers left are named
    all=$(list)
    servers=$(printf '%s\n' "$all" | awk -v v="$ver" '$3 == "server" && $2 == v')
    n=$(printf '%s\n' "$servers" | grep -c . || true)
    if [ "$n" -ne 1 ]; then
      echo "$n Orca server processes of orcad-$ver run on this host, one is the rule:"
      printf '%s\n' "$servers" | awk 'NF { print "  pid " $1 " port " $4 ($7 == "yes" ? " (orcad.service)" : "") }'
      exit 1
    fi
    set -- $servers
    [ "$4" = "$port" ] || { echo "the one server, orcad-$2 (pid $1), is on port $4, not $port"; exit 1; }
    why=$(owns "$1") || { echo "orcad-$ver (pid $1) does not own 127.0.0.1:$port: it is $why"; exit 1; }
    echo "one runtime orcad-$ver pid $1 on 127.0.0.1:$port"
    printf '%s\n' "$all" | awk -v v="$ver" '$3 == "server" && $2 != v {
      print "note: left orcad-" $2 " pid " $1 " (port " $4 ", " $5 " child processes): a second runtime until it ends; once its terminals are done, on this host: kill " $1 }' ;;
  owns) owns "$4" ;;
  shell)  # the user manager's SHELL as passwd says (a chsh does not reach a manager that already runs)
    command -v systemctl >/dev/null 2>&1 || exit 0
    m=$(systemctl --user show-environment 2>/dev/null) || exit 0
    cur=$(printf '%s\n' "$m" | sed -n 's/^SHELL=//p')
    u=$(id -un)
    login=$(getent passwd "$u" 2>/dev/null | cut -d: -f7)
    [ -n "$login" ] || login=$(awk -F: -v u="$u" '$1 == u { print $7 }' /etc/passwd)
    case $login in ''|*[!A-Za-z0-9/._+-]*) exit 0 ;; esac
    if [ "$cur" != "$login" ]; then
      systemctl --user set-environment "SHELL=$login" || { echo "could not set SHELL=$login in the user manager"; exit 1; }
      echo "SHELL $login (was ${cur:-unset}) in the user manager: Orca's server starts its terminals with it"
    fi
    # A server that already runs keeps the SHELL it started with: said on every run until it is restarted.
    list | awk '$3 == "server" { print $1 }' | while read -r p; do
      have=$(tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | sed -n 's/^SHELL=//p')
      [ "$have" = "$login" ] || echo "restart needed: Orca's server (pid $p) runs with SHELL=${have:-unset}, the login shell is $login: on this host, systemctl --user restart orcad.service (its terminals end)"
    done ;;
esac
AUDIT
)
if [ "${audit_only:-0}" = 1 ]; then printf '%s\n' "$audit_sh"; exit 0; fi
[ -n "$host" ] || die "usage: orca-host-install <ssh-host> [--from DIR | --bundle TAR] [--version V] [--pair] [--port N]" 2
[ -z "$from" ] || [ -z "$bundle" ] || die "--from and --bundle exclude each other: give one source" 2
if [ "$want_set" = 1 ]; then
  case $want in ''|*[!A-Za-z0-9._+-]*) die "--version takes a version such as 0.1.0+b086a7d15d60 (letters, digits and . _ + - only)" 2 ;; esac
fi
[ -z "$from" ] || [ -d "$from" ] || die "--from $from is not a folder" 2
[ -z "$bundle" ] || [ -f "$bundle" ] || die "--bundle $bundle is not a file" 2

artifacts=${ORCA_ARTIFACTS:-$HOME/.config/orca/orcad-artifacts}
pkg_cli=$(command -v orca-ide 2>/dev/null || true)
if [ -n "$pkg_cli" ]; then default_cli=$pkg_cli; else default_cli=$HOME/.config/orca/linux-orca-cli-shim/orca; fi
orca=${ORCA_CLI:-$default_cli}
# LANE_SSH_CONFIG: a separate ssh config for trial or throwaway hosts (passed as ssh -F), so they stay out of ~/.ssh/config.
sshf=""
if [ -n "${LANE_SSH_CONFIG:-}" ]; then
  sshcfg=$(cd "$(dirname "$LANE_SSH_CONFIG")" && pwd)/$(basename "$LANE_SSH_CONFIG")
  [ -f "$sshcfg" ] || die "LANE_SSH_CONFIG $LANE_SSH_CONFIG not found" 2
  sshf="-F $sshcfg"
fi
# Every command goes to the host as sh -c '<script>', so a fish or csh login shell runs it as sh does (lc-tuh, as
# core/install.py's sh()). Single quotes are the one quoting fish and sh agree on, as long as no backslash comes
# before a quote or another backslash.
r() {
  script=$*
  case $script in *"\\'"*|*'\\\\'*) die "a command for $host holds a backslash before a quote or a backslash, which fish would read differently; nothing was sent" ;; esac
  q=$(printf '%s' "$script" | sed "s/'/'\\\\''/g")
  ssh $sshf -o BatchMode=yes "$host" "sh -c '$q'"
}
audit() { printf '%s\n' "$audit_sh" | r sh -s -- "$@"; }  # the audit on the host: <slot> <port> <action>

# --- the direction-1 tunnel: unit orca-tunnel-<host>, ssh -L, the same port at both ends ---
name=$(printf '%s' "$host" | tr -c 'A-Za-z0-9._-' '-')
unit=orca-tunnel-$name.service
unitfile=$HOME/.config/systemd/user/$unit
# The unit's ssh never multiplexes: one that rides the user's ControlMaster hands the forward to the master and exits,
# so the unit restarts for ever while the port answers (field report lc-l78, C2).
write_tunnel() {
  mkdir -p "$HOME/.config/systemd/user"
  old=$(cat "$unitfile" 2>/dev/null || true)
  cat > "$unitfile" <<UNIT
[Unit]
Description=Orca tunnel to $host:$port
[Service]
ExecStart=/usr/bin/env ssh $sshf -N -o BatchMode=yes -o ControlPath=none -o ControlMaster=no -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -L 127.0.0.1:$port:127.0.0.1:$port $host
Restart=always
RestartSec=5
[Install]
WantedBy=default.target
UNIT
  systemctl --user daemon-reload
  systemctl --user enable --now "$unit" >/dev/null 2>&1
  # A changed unit (other port or host, or one from before ControlPath=none) must replace a tunnel that runs.
  [ "$old" = "$(cat "$unitfile")" ] || systemctl --user restart "$unit"
}
# Proof that the tunnel is the unit's: active/running, its own ssh owning 127.0.0.1:<port>, and its restart counter not
# climbing. A port that answers is not proof: a ControlMaster or a stale ssh can hold it while the unit flaps.
# "<ActiveState> <SubState> <NRestarts> <MainPID>", read by name: systemd prints properties in its own order (MainPID
# before NRestarts), whatever order -p asks for.
unit_state() {
  systemctl --user show "$unit" -p ActiveState -p SubState -p NRestarts -p MainPID 2>/dev/null | awk -F= '
    { v[$1] = substr($0, index($0, "=") + 1) }
    END { printf "%s %s %s %s\n", (v["ActiveState"] == "" ? "unknown" : v["ActiveState"]),
          (v["SubState"] == "" ? "unknown" : v["SubState"]), v["NRestarts"] + 0, v["MainPID"] + 0 }'
}
prove_tunnel() {
  i=0
  while :; do
    set -- $(unit_state)
    if [ "${1:-} ${2:-}" = "active running" ] && [ "${4:-0}" != 0 ]; then
      why=$(printf '%s\n' "$audit_sh" | sh -s -- - "$port" owns "$4") && break
    else
      why="the unit is ${1:-unknown}/${2:-unknown}"
    fi
    [ $i -lt "${LANE_TUNNEL_WAIT:-20}" ] || die "tunnel $unit is not up: ${why:-?}${4:+, not by $unit (pid $4)} (journalctl --user -u $unit)"
    i=$((i + 1)); sleep 1
  done
  n0=${3:-0}; pid=$4
  sleep "${LANE_CHECK_SETTLE:-5}"
  set -- $(unit_state)
  [ "${3:-0}" = "$n0" ] && [ "${4:-0}" = "$pid" ] || die "tunnel $unit restarted while it was watched ($n0, then ${3:-?} restarts): it flaps (journalctl --user -u $unit)"
  echo "tunnel $unit: its ssh (pid $pid) owns 127.0.0.1:$port, restarted $n0 times, not climbing"
}
saved_here() {
  "$orca" environment list --json 2>/dev/null | python3 -c '
import json,sys; n=sys.argv[1]
envs=json.load(sys.stdin).get("result",{}).get("environments",[])
sys.exit(0 if any(e.get("name")==n for e in envs) else 1)' "$name"
}
answers() { "$orca" status --environment "$name" --json 2>/dev/null | grep -q '"reachable": true'; }

if [ "$tunnel_only" = 1 ]; then  # restore the direction-1 tunnel of a paired host, and nothing else
  [ "$pair" = 0 ] && [ -z "$from$bundle$want" ] || die "--tunnel restores the tunnel only: it takes --port, not --pair, --from, --bundle or --version" 2
  # The ssh config the unit was written with stays, unless LANE_SSH_CONFIG names another (review m3).
  if [ -z "$sshf" ]; then
    oldcfg=$(sed -n 's/^ExecStart=.* ssh  *-F \([^ ]*\) .*/\1/p' "$unitfile" 2>/dev/null | head -n 1)
    [ -z "$oldcfg" ] || { [ -f "$oldcfg" ] && sshf="-F $oldcfg"; } || die "$unit names the ssh config $oldcfg, which is not there: set LANE_SSH_CONFIG" 2
  fi
  if [ "$port_set" = 0 ]; then
    port=$(sed -n 's/^ExecStart=.* -L 127\.0\.0\.1:\([0-9][0-9]*\):127\.0\.0\.1:[0-9]* .*/\1/p' "$unitfile" 2>/dev/null | head -n 1)
    [ -n "$port" ] || die "no $unit here to read the port from: give --port <the port orca-host-install --pair used>" 2
  fi
  [ -x "$orca" ] || die "Orca CLI not found at $orca (open Orca once, or set ORCA_CLI)"
  saved_here || die "$host was never paired here (no environment $name): run orca-host-install $host --pair --port $port"
  servers=$(audit - "$port" list) || die "cannot ssh to $host"
  serving=$(printf '%s\n' "$servers" | awk -v p="$port" '$3 == "server" && $4 == p { print $2; exit }')
  [ -n "$serving" ] ||
    die "no Orca server runs on $host with port $port, so a tunnel has nothing to reach: run orca-host-install $host --pair --port $port${want:+ --version $want}"
  write_tunnel
  prove_tunnel
  answers || die "the tunnel is up, but environment $name does not answer through it (the server's identity may have changed): run orca-host-install $host --pair --port $port --version $serving"
  echo "already-paired $name"
  exit 0
fi

# --- host facts ---
facts=$(r 'id -u; uname -m; (ldd --version 2>&1 || true) | head -1') || die "cannot ssh to $host"
uid=$(echo "$facts" | sed -n 1p); arch=$(echo "$facts" | sed -n 2p); libc=$(echo "$facts" | sed -n 3p)
if [ "$uid" = 0 ] && [ "$allow_root" = 0 ]; then die "$host logs in as root; agents should not run as root (use a normal user, or --allow-root)" 2; fi
case $arch in x86_64) a=x64 ;; aarch64|arm64) a=arm64 ;; *) die "unsupported arch $arch" ;; esac
case $libc in *musl*) target=linux-$a-musl ;; *) target=linux-$a-glibc ;; esac

# --- the slot to install (the desktop's newest, or the one --from/--bundle/--version name) and its node ---
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
# A slot folder's name is its version ("orcad-" in front is allowed: that is its name on the host).
slot_version() { v=${1##*/}; printf '%s\n' "${v#orcad-}"; }
# The folders under $1 that hold an orcad.js, newest first.
list_slots() { ls -t "$1" | while IFS= read -r d; do if [ -f "$1/$d/orcad.js" ]; then printf '%s\n' "$d"; fi; done; }
# What a slot says it is, besides its folder name: its .version, and the Orca app version in out/package.json (either
# may be missing; both are only ever read as short words of [A-Za-z0-9._+-]).
slot_record() {  # $1 slot folder, $2 .version | app
  v=""
  case $2 in
    .version) if [ -f "$1/.version" ]; then v=$(tr -d '[:space:]' < "$1/.version"); fi ;;
    app) if [ -f "$1/out/package.json" ]; then
           v=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("version") or "")' "$1/out/package.json" 2>/dev/null || true)
         fi ;;
  esac
  case $v in *[!A-Za-z0-9._+-]*) die "$1 has a $2 that is not a version (letters, digits and . _ + - only)" ;; esac
  printf '%s\n' "$v"
}
# A name like 1.4.251 reads as an Orca app version (slot names are 0.1.0+<hash>).
app_shaped() { printf '%s\n' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; }
# Whether slot $1 says it is $2 (a slot name, its .version or its app version). The folder name counts as long as
# the slot's own .version does not say something else.
slot_is() {
  n=$(slot_version "$1"); dv=$(slot_record "$1" .version); av=$(slot_record "$1" app)
  # (with no .version, a name that reads as an app version must be the one out/package.json records)
  [ "$2" = "$n" ] && { [ -z "$dv" ] || [ "$dv" = "$n" ] || [ "$dv" = "$av" ]; } \
    && { [ -n "$dv" ] || [ -z "$av" ] || [ "$n" = "$av" ] || ! app_shaped "$n"; } && return 0
  [ -n "$dv" ] && [ "$2" = "$dv" ] && return 0
  [ -n "$av" ] && [ "$2" = "$av" ] && return 0
  return 1
}
slot_says() {  # $1 slot folder, $2 its name if not the folder's: "<name> (.version <v>) (Orca <app version>)", as far as it differs
  n=${2:-$(slot_version "$1")}; dv=$(slot_record "$1" .version); av=$(slot_record "$1" app)
  out=$n
  if [ -n "$dv" ] && [ "$dv" != "$n" ]; then out="$out (.version $dv)"; fi
  if [ -n "$av" ]; then out="$out (Orca $av)"; fi
  printf '%s' "$out"
}
# The Orca app's own folder (resources/orcad-template, not a slot: no target overlay, no node sha of its own).
refuse_app_dir() {
  for d in "$1" "$1/orcad-template" "$1/resources/orcad-template" "$1/resources"; do
    if [ -f "$d/orcad-template.json" ]; then
      av=$(slot_record "$d" app)
      die "$2 is ${av:+Orca $av's }packaged app (orcad-template), not an orcad slot: a slot is what Orca builds from it for one platform. Connect a $target host once from that Orca, then use --from <its ORCA_ARTIFACTS>/$target (default ~/.config/orca/orcad-artifacts/$target), and --appimage-root <its resources folder> for its node runtime"
    fi
  done
}
srcroot=""
if [ -n "$bundle" ]; then
  python3 - "$bundle" "$tmp/bundle" <<'PY' || die "cannot unpack $bundle: not a tar, or it holds a path outside itself, an absolute or .. link, or a device"
import os, sys, tarfile
src, dest = sys.argv[1:3]
os.makedirs(dest)
def outside(p): return p.startswith("/") or ".." in p.split("/")
with tarfile.open(src, "r:*") as tf:
    members = tf.getmembers()
    for m in members:
        if outside(m.name) or ((m.issym() or m.islnk()) and outside(m.linkname)) or not (m.isfile() or m.isdir() or m.issym() or m.islnk()):
            sys.exit(1)
    tf.extractall(dest, members, **({"filter": "data"} if hasattr(tarfile, "data_filter") else {}))
PY
  srcroot=$tmp/bundle; base=$srcroot; label=$bundle
  # a bundle may sit in one folder of its own
  if [ "$(ls -A "$base" | wc -l)" = 1 ] && [ -d "$base/$(ls -A "$base")" ]; then base=$base/$(ls -A "$base"); fi
elif [ -n "$from" ]; then
  srcroot=$from; base=$from; label=$from
else
  [ -d "$artifacts/$target" ] || die "no $target slot in $artifacts (connect any $target host once from the Orca app, or use a matching host, or give --from or --bundle)"
  base=$artifacts/$target; label=$artifacts/$target
fi
refuse_app_dir "$base" "$label"
pin=""; [ -z "$from$bundle$want" ] || pin=1
if [ -f "$base/orcad.js" ]; then  # the source is one slot
  slot=$base
  if [ "$base" = "$tmp/bundle" ]; then  # a bare slot in a tar has no folder name: its own .version, else --version
    ver=$(slot_record "$slot" .version)
    [ -n "$ver" ] || ver=$want
    [ -n "$ver" ] || die "the bundle is one slot with no folder name and no .version to give its version: say it with --version" 2
  else
    ver=$(slot_version "$base")
  fi
  if [ -n "$want" ]; then
    if [ "$base" = "$tmp/bundle" ]; then  # no folder name: the slot's own records are all there is to check
      dv=$(slot_record "$slot" .version); av=$(slot_record "$slot" app)
      if { [ -n "$dv" ] || [ -n "$av" ]; } && [ "$want" != "$dv" ] && [ "$want" != "$av" ]; then ok=""; else ok=1; fi
    else
      if slot_is "$slot" "$want"; then ok=1; else ok=""; fi
    fi
    [ -n "$ok" ] || die "requested orcad $want, but $label is orcad $(slot_says "$slot" "$ver"); nothing was copied"
  fi
else  # a folder of slots, possibly in a <platform> folder
  dir=$base; [ ! -d "$base/$target" ] || dir=$base/$target
  names=$(list_slots "$dir")
  [ -n "$names" ] || die "no orcad slot (a folder with orcad.js) in $label"
  if [ -n "$want" ]; then
    # (read in this shell, not a $(...) one: a record that is not a version must stop the run, not just print)
    printf '%s\n' "$names" > "$tmp/names"
    while IFS= read -r d; do slot_record "$dir/$d" .version > /dev/null; slot_record "$dir/$d" app > /dev/null; done < "$tmp/names"
    pick=$(printf '%s\n' "$names" | while IFS= read -r d; do if slot_is "$dir/$d" "$want"; then printf '%s\n' "$d"; break; fi; done)
    [ -n "$pick" ] || die "$label has no orcad $want; it has: $(printf '%s\n' "$names" | while IFS= read -r d; do slot_says "$dir/$d"; printf '; '; done)"
  else
    pick=$(printf '%s\n' "$names" | head -1)
  fi
  slot=$dir/$pick; ver=$(slot_version "$pick")
fi
case $ver in ''|*[!A-Za-z0-9._+-]*) die "the slot $slot has no usable version name (letters, digits and . _ + - only), so it cannot be installed" ;; esac
# A folder or tar the owner points at must be what it says: a .version that names another server than the folder does
# is a mislabelled slot (the desktop's own slots, taken as they come, are not second-guessed).
if [ -n "$pin" ]; then
  dv=$(slot_record "$slot" .version); av=$(slot_record "$slot" app)
  if [ -n "$dv" ] && [ "$dv" != "$ver" ] && [ "$dv" != "$av" ]; then
    die "$label is named orcad $ver but its .version says $dv: not installing one server under another's name; nothing was copied"
  fi
  if [ -z "$dv" ] && [ -n "$av" ] && [ "$ver" != "$av" ] && app_shaped "$ver"; then
    die "$label is named orcad $ver, which reads as an Orca app version, but its out/package.json says Orca $av and it has no .version to settle it: not installing one server under another's name; nothing was copied"
  fi
fi
[ -n "$bundle" ] || label=$slot
nodesha=$(tr -d '[:space:]' < "$slot/.runtime-node") || die "$slot has no .runtime-node (not an orcad slot)"
case $nodesha in ''|*[!0-9a-f]*) die "$slot/.runtime-node does not hold a sha256" ;; esac
[ "${#nodesha}" = 64 ] || die "$slot/.runtime-node does not hold a sha256"
# A packaged orca-ide (resources/bin/orca-ide) carries the node runtime two levels up; else the AppImage cache.
if [ -z "$appimage_root" ] && [ -n "$pkg_cli" ]; then
  appimage_root=$(dirname "$(dirname "$(readlink -f "$pkg_cli")")")
fi
if [ -z "$appimage_root" ] || [ ! -x "$appimage_root/node-runtime/bin/node" ]; then
  appimage_root=$(ls -dt "$HOME"/.cache/appimage-run/*/resources 2>/dev/null | head -1 || true)
fi
node=""
if [ -n "$appimage_root" ] && [ -x "$appimage_root/node-runtime/bin/node" ] && [ "$a" = x64 ]; then
  node=$appimage_root/node-runtime/bin/node
fi
if [ -z "$node" ] || [ "$(sha256sum "$node" | cut -d' ' -f1)" != "$nodesha" ]; then
  # node's tarball: beside the slot folders of the source (or the slot), else the desktop's. A bundle is searched
  # only inside its own unpacked folder.
  tarball=""
  { printf '%s\n' "$slot"
    if [ -n "$bundle" ]; then
      d=$slot; while [ "$d" != "$tmp/bundle" ] && [ "$d" != / ]; do d=$(dirname "$d"); printf '%s\n' "$d"; done
    else printf '%s\n%s\n%s\n' "$slot/.." "$slot/../.." "$srcroot"; fi
    printf '%s\n' "$artifacts"; } > "$tmp/nodedirs"
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    tarball=$(ls "$d"/node/archives/node-*-linux-$a.tar.gz 2>/dev/null | head -1 || true)
    [ -z "$tarball" ] || break
  done < "$tmp/nodedirs"
  [ -n "$tarball" ] || die "no node binary with sha $nodesha found (AppImage resources, or node/archives next to $slot or in $artifacts)"
  tar -xzf "$tarball" -C "$tmp" --wildcards '*/bin/node' --strip-components=1
  node=$tmp/bin/node
fi
[ "$(sha256sum "$node" | cut -d' ' -f1)" = "$nodesha" ] || die "node binary sha does not match $nodesha"

# --- with --pair, before anything changes on the host: what runs there now, and what may be stopped ---
if [ "$pair" = 1 ]; then
  plan=$(audit "$ver" "$port" list) || die "cannot ssh to $host"
  # One runtime per host: a server of this build on another port, or orcad.service on another port, is not replaced.
  other=$(printf '%s\n' "$plan" | awk -v v="$ver" -v p="$port" 'NF && $3 == "server" && $4 != p && ($2 == v || $7 == "yes")' | head -n 1)
  if [ -n "$other" ]; then
    set -- $other
    if [ "$7" = yes ]; then
      die "orcad.service on $host serves orcad-$2 on port $4 (pid $1), not $port: run again with --port $4 --version $2, or stop it there first (systemctl --user stop orcad.service; its terminals end). Nothing was changed"
    fi
    die "orcad-$2 already runs on $host as pid $1 on port $4 (not orcad.service), and one runtime per host is the rule: run again with --port $4 --version $2, or on $host: kill $1 (its terminals end). Nothing was changed"
  fi
  state=none; old=""; oldpid=""
  srv=$(printf '%s\n' "$plan" | awk -v p="$port" 'NF && $3 == "server" && $4 == p' | head -n 1)
  if [ -n "$srv" ]; then
    set -- $srv
    if [ "$2" = "$ver" ]; then state=current; else state=stale; old=$2; oldpid=$1; fi
  elif why=$(audit - "$port" owns 0); [ "$why" != "not listening at all" ]; then
    die "port $port on $host is in use by another process ($why); pick one with --port"
  fi
  # Name every process of an older slot before anything is stopped. Only one with no child process (no live
  # terminal or agent) that no daemon-v*.pid names (the terminal daemon a newer server adopts) may be stopped.
  stale=$(printf '%s\n' "$plan" | awk -v v="$ver" 'NF && $2 != v')
  to_stop=""
  if [ -n "$stale" ]; then
    echo "of an older Orca server build on $host:"
    printf '%s\n' "$stale" | awk '{
      d = "  pid " $1 " orcad-" $2 " " $3 ($4 != "-" ? " port " $4 : "") ($7 == "yes" ? " (orcad.service)" : "") ": " $5 " child processes"
      if ($6 == "yes") d = d ", the terminal daemon a server adopted"
      print d (($5 == 0 && $6 == "no") ? ": stop" : ": leave (in use)") }'
    to_stop=$(printf '%s\n' "$stale" | awk '$5 == 0 && $6 == "no" { printf "%s ", $1 }')
    if [ "$state" = stale ] && ! printf '%s\n' "$to_stop" | grep -qw "$oldpid"; then
      die "orcad-$old serves port $port on $host (pid $oldpid) and is in use, so it is not replaced: end its terminals (or stop it there yourself), then run again. Nothing was changed"
    fi
    if [ "$state" = stale ] && [ "$want_set" = 0 ] && [ "$stop_stale" = 0 ] && [ ! -t 0 ]; then
      die "$host serves orcad-$old on port $port, and this desktop's newest is orcad-$ver: to replace it run again with --version $ver --stop-stale; to keep it, --version $old. Nothing was changed"
    fi
    if [ -n "$to_stop" ] && [ "$stop_stale" = 0 ]; then
      ans=n
      if [ -t 0 ]; then
        printf 'Stop the ones marked stop (pid %s)? [y/N] ' "$(echo $to_stop)" >&2
        read -r ans || ans=n
      fi
      case $ans in y|Y|yes) ;; *)
        [ "$state" != stale ] || die "orcad-$old on port $port was not replaced (no yes): run again with --stop-stale, or in a terminal. Nothing was changed"
        echo "left them: run again with --stop-stale (or in a terminal) to stop the ones marked stop"
        to_stop="" ;;
      esac
    fi
  fi
fi

# --- install (idempotent) ---
rslot="\$HOME/.orca-remote/orcad-$ver"
rnode="\$HOME/.orca-remote/runtimes/node-$nodesha"
if r "test -f $rslot/.install-complete && test -f $rslot/orcad.js && test -f $rnode/.verified && test -x $rnode/bin/node"; then
  echo "exists orcad-$ver - from $label"
else
  stage=".stage-$$"
  r "umask 077; mkdir -p ~/.orca-remote/$stage/slot ~/.orca-remote/$stage/node/bin ~/.orca-remote/runtimes"
  tar -C "$slot" -cf - . | r "tar -C ~/.orca-remote/$stage/slot -xf -"
  tar -C "$(dirname "$node")" -cf - node | r "tar -C ~/.orca-remote/$stage/node/bin -xf -"
  r "set -e; cd ~/.orca-remote/$stage
     node/bin/node --version >/dev/null || { echo 'node runtime does not run on this host' >&2; exit 1; }
     chmod 755 node/bin/node; chmod 755 slot/ripgrep/*/rg slot/agent-browser-* 2>/dev/null || true
     rm -rf $rslot $rnode; mv slot $rslot; mv node $rnode
     touch $rnode/.verified $rslot/.install-complete
     [ -f ~/.orca-remote/orcad-machine.json ] || printf '{\"schemaVersion\":1,\"machineKey\":\"%s\"}' \"\$(head -c8 /dev/urandom | od -An -tx1 | tr -d ' \\n')\" > ~/.orca-remote/orcad-machine.json
     cd ..; rm -rf $stage; chmod 700 ~/.orca-remote"
  echo "installed orcad-$ver - from $label"
fi
[ "$pair" = 1 ] || exit 0

# --- start orcad (idempotent) ---
# Ours and current: running. Ours but an older slot: stopped above with the owner's yes, then the new one starts.
if [ -n "$to_stop" ]; then
  out=$(audit "$ver" "$port" stop $to_stop) && rc=0 || rc=$?
  [ -z "$out" ] || printf '%s\n' "$out"
  if [ "$state" = stale ] && ! printf '%s\n' "$out" | grep -q "^stopped orcad-$old pid $oldpid\$"; then
    die "orcad-$old (pid $oldpid) on port $port could not be stopped on $host, so orcad-$ver is not started"
  fi
  [ "$rc" = 0 ] || echo "note: not everything marked stop was stopped (above); one runtime per host once it ends"
fi
# A chsh does not reach a user manager that already runs: orcad.service would start terminals with the old shell.
said=$(audit "$ver" "$port" shell) || die "$said"
[ -z "$said" ] || printf '%s\n' "$said"
if [ "$state" = current ]; then
  echo "running orcad $port"
else
  r "set -e; cd $rslot; rm -f .orcad-readiness-$port
     [ -w \"\${TMPDIR:-/tmp}\" ] || { mkdir -p ~/tmp; export TMPDIR=\$HOME/tmp; }
     if systemctl --user show-environment >/dev/null 2>&1; then
       mkdir -p ~/.config/systemd/user
       cat > ~/.config/systemd/user/orcad.service <<UNIT
[Unit]
Description=Orca server (orcad $ver)
[Service]
WorkingDirectory=\$PWD
Environment=ORCA_VERSION=$ver ORCA_USER_DATA=\$HOME/.orca
ExecStart=/bin/sh -c 'exec \$HOME/.orca-remote/runtimes/node-$nodesha/bin/node --max-semi-space-size=8 \$PWD/orcad.js --json --bind 127.0.0.1 --port $port > .orcad-readiness-$port 2>> orcad.log'
Restart=on-failure
[Install]
WantedBy=default.target
UNIT
       systemctl --user daemon-reload; systemctl --user enable --now orcad.service
     else
       ORCA_VERSION=$ver ORCA_USER_DATA=\$HOME/.orca setsid nohup $rnode/bin/node --max-semi-space-size=8 $rslot/orcad.js \
         --json --bind 127.0.0.1 --port $port > .orcad-readiness-$port 2>> orcad.log < /dev/null &
     fi"
  echo "started orcad $port"
fi
# Exactly one server of this slot now, on this port, owning its listener (an older one left in use is named).
i=0
until proof=$(audit "$ver" "$port" prove); do
  [ $i -lt 30 ] || die "the Orca server on $host is not one runtime: $proof"
  i=$((i + 1)); sleep 1
done
printf '%s\n' "$proof"
# The pairing code is in orcad's first stdout line, kept per port. Only read when it is needed: an orcad that was
# already running may have no code left to give, and an already-paired desktop does not need one.
pairing_url() {
  ready=""; i=0
  while [ $i -lt 60 ]; do
    ready=$(r "head -1 $rslot/.orcad-readiness-$port 2>/dev/null" || true)
    case $ready in *orca_server_ready*) break ;; esac
    i=$((i + 1)); sleep 1
  done
  case $ready in
    *orca_server_ready*) ;;
    *) if [ "$state" = current ]; then
         die "orcad on $host:$port runs but its pairing code is gone; stop it (pkill -u <user> -f 'orcad[.]js .*--port $port\$' on $host) and rerun"
       fi
       die "orcad did not report ready in 60s; see ~/.orca-remote/orcad-$ver/orcad.log on $host" ;;
  esac
  url=$(printf '%s' "$ready" | python3 -c 'import json,sys; print(json.load(sys.stdin)["pairing"]["url"] or "")')
  [ -n "$url" ] || die "orcad reported no pairing url"
  printf '%s\n' "$url"
}
if [ "$tunnel" = 0 ]; then url=$(pairing_url) || exit 1; echo "pairing-code $url"; exit 0; fi

# --- local tunnel (same port both ends, so the pairing endpoint is valid as is) ---
write_tunnel
prove_tunnel

# --- pair ---
[ -x "$orca" ] || die "Orca CLI not found at $orca (open Orca once, or set ORCA_CLI)"
if saved_here && ! answers; then
  # Saved but unreachable: the host's identity changed (its ~/.orca was reset). Pair afresh.
  "$orca" environment rm --environment "$name" --json >/dev/null 2>&1 || die "cannot remove stale environment $name"
fi
if answers; then
  echo "already-paired $name"
else
  url=$(pairing_url) || exit 1
  # The code goes to Orca's CLI on stdin, never in argv (ps, /proc), a file or a log (lc-5zn): project-setup's
  # --box-pairing add runs the CLI as its launcher does, with core/scripts/pairing-code-stdin.cjs preloaded, and
  # redacts what Orca says. printf is a shell builtin, so the code is on no command line here either.
  d=$(dirname "$(readlink -f "$0")")
  while [ ! -f "$d/.lane-control-root" ]; do
    [ "$d" != / ] || die "lane-control root not found from $0, so the pairing code has no way in but argv; nothing was saved"
    d=$(dirname "$d")
  done
  outp=$(printf '%s\n' "$url" | ORCA_CLI=$orca "$d/core/scripts/project-setup" --box-pairing add "$name" 2>&1) || {
    url=""
    case $outp in *lready*paired*) echo "already-paired $name"; exit 0 ;; esac
    die "environment add failed: $outp"; }
  url=""
  echo "paired $name"
fi
