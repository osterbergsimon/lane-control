#!/usr/bin/env bash
# lane-away: tell this machine the owner is away, or back.
#
#   lane-away on       the owner is away: writes ~/.config/lane-control/away (LANE_AWAY_FILE). It counts for
#                      AWAY_HOURS from machine.conf (default 14 h), so a forgotten `off` never lasts for days; run
#                      `on` again to extend it.
#   lane-away on --improve [--until HH:MM|--hours N|--until-back] [--limits "<text>"] [--deny-paths "<glob>,..."]
#                      [--project <name>]... [--unmetered] [--continue [away/<name>]] [--yes]
#                      also switches on away-improve mode (core/improve.py; docs/superpowers/specs/
#                      2026-11-23-away-improve-design.md): each chosen project's coordinator keeps improving its
#                      product on its own away/<date> branch until the end (default: until you run `off`). It is
#                      the ONLY way the mode turns on: plain `on`, night or a changed budget never do, and an agent
#                      runs it only on the owner's own explicit word. It prints what it turned on, and without a
#                      terminal it refuses unless --yes. While it is on the owner counts as away whatever
#                      AWAY_HOURS says. --project (repeatable) limits it to those coordinators (default: all);
#                      --unmetered marks a machine with no usage limits.
#                      Each project gets a new away/<date> branch on origin, cut from its integration branch
#                      (the base of its recent merged PRs, else origin's default); --continue reuses the newest
#                      (or the named) away branch instead and refuses when there is none. Nothing is merged.
#   lane-away off      the owner is back: removes the away file and ends improve mode.
#   lane-away status   presence as lane-limits.sh sees it now: for limits (day or away, and why) and whether the
#                      owner counts as away (night or the away file; never a stopped budget).
#
# Away or night gives the CI slice (ci-presence) and lane-heavy their larger limits, and lets the night manager
# check in on idle coordinators. The owner runs it, or asks the machine coordinator to. Exit: 0, or 2 for usage.
set -u
self=$(readlink -f "$0")
# shellcheck source=lane-limits.sh
. "${self%/*}/lane-limits.sh"

case ${1:-} in
  on)
    if [ "${2:-}" != "" ]; then
      case $2 in
        --improve) ;;
        *) echo "usage: lane-away on [--improve [options]]" >&2; exit 2 ;;
      esac
      shift 2
      exec python3 "${self%/*}/../improve.py" on --away-file "$LANE_AWAY_FILE" "$@"
    fi
    mkdir -p "$(dirname "$LANE_AWAY_FILE")" && touch "$LANE_AWAY_FILE" || exit 1
    echo "lane-away: away for ${LANE_AWAY_HOURS} h (until $(date -d "+${LANE_AWAY_HOURS} hours" '+%a %H:%M'));" \
      "the CI slice follows within 15 minutes"
    ;;
  off)
    rm -f "$LANE_AWAY_FILE" || exit 1
    python3 "${self%/*}/../improve.py" off || exit 1
    echo "lane-away: back; the CI slice follows within 15 minutes"
    ;;
  status)
    if [ -e "$LANE_AWAY_FILE" ]; then
      since=$(date -r "$LANE_AWAY_FILE" '+%a %H:%M')
      if [ -n "$(find "$LANE_AWAY_FILE" -maxdepth 0 -mmin -$((LANE_AWAY_HOURS * 60)) 2>/dev/null)" ]; then
        echo "away file: since $since, counts for ${LANE_AWAY_HOURS} h"
      else
        echo "away file: since $since, expired (older than ${LANE_AWAY_HOURS} h)"
      fi
    else
      echo "away file: none"
    fi
    echo "night: ${LANE_NIGHT_START}:00-${LANE_NIGHT_END}:00"
    if [ "$LANE_PRESENCE" = day ]; then echo "presence: day"; else echo "presence: away ($LANE_PRESENCE_WHY)"; fi
    if [ -n "$LANE_OWNER_AWAY" ]; then echo "owner away: yes ($LANE_PRESENCE_WHY)"; else echo "owner away: no"; fi
    python3 "${self%/*}/../improve.py" status
    ;;
  -h | --help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$self" ;;
  *) echo "usage: lane-away on [--improve ...]|off|status" >&2; exit 2 ;;
esac
