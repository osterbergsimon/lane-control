#!/usr/bin/env python3
"""lane-extras: the extras the owner adds to the agents' environments (core/extras.py has what each kind does and
where each harness reads it). Run through the front door:

  lane-control project extras add <project> <one kind> [--for lanes|coordinator|reviewer|all]... [--name N]
  lane-control project extras list <project> [--json]
  lane-control project extras remove <project> <kind:name | name>
  lane-control machine extras add <one kind> [--for ...] [--name N]        every project on this machine
  lane-control machine extras list [--json]
  lane-control machine extras remove <kind:name | name>                    a default design skill is turned off
  lane-control lane prepare <project> <worktree> --role lanes|reviewer     (the coordinator, before a worker starts)

Kinds:
  --skill <git-url>@<commit>[:<path>]                      a skill pinned at a full commit
  --mcp <name> [--env NAME]... -- <command> [args]         an MCP server; each --env names a variable the server
                                                           reads from the agent's environment (never a value); an
                                                           argument may say ${NAME} for one
  --persona <name> --prompt-file <path> [--tier swift|standard|deep] [--harness claude|opencode]
                                                           a lane role the coordinator can brief a lane with
  --plugin claude:<plugin>@<marketplace>@<version> | opencode:<package>@<version>

add and remove are a person's only, at a terminal (an agent is refused, as for lane new). A file an extra names (an
MCP command or argument, a prompt file) must be an absolute path outside every project checkout unless
--allow-repo-path is given; it is pinned by its hash. The same id again replaces the extra (and accepts a changed
file). A project's extras add to the machine's. After a change, run `lane-control project refresh <project>`: it
gives the coordinator its extras, renders the personas, and applies every worktree lane prepare wrote in again (a
removed extra is taken out there too)."""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parents[2]


def _load(name, rel):
    spec = importlib.util.spec_from_file_location(name, HERE / rel)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


X = _load("lc_extras", "core/extras.py")
KIND_FLAGS = ("skill", "mcp", "persona", "plugin")


class Parser(argparse.ArgumentParser):
    """argparse that never repeats what it could not parse: a misplaced value may be a secret."""

    def error(self, message):
        safe = message.split(":")[0] if "unrecognized arguments" in message else message
        self.exit(2, f"{self.prog}: {safe} (not shown: one may be a secret); see --help\n")


def person(what: str) -> None:
    """project-setup's person check (as CLI-2's lane new and --force): an agent is refused."""
    loader = importlib.machinery.SourceFileLoader("project_setup_extras",
                                                  str(HERE / "core" / "scripts" / "project-setup"))
    spec = importlib.util.spec_from_loader("project_setup_extras", loader)
    ps = importlib.util.module_from_spec(spec)
    loader.exec_module(ps)
    place = None
    if os.environ.get("ORCA_TERMINAL_HANDLE"):
        ps.add_orca_cli_to_path()
        ps.ORCA = ps.orca_cli()
        place = ps.Place()
    why = ps.agent_caller(place)
    if why:
        raise X.ExtrasError(f"{what} is for a person at a terminal, and {why}. Nothing was changed")


def add_parser(prog: str, project: bool) -> argparse.ArgumentParser:
    ap = Parser(prog=prog)
    if project:
        ap.add_argument("project")
    ap.add_argument("--skill")
    ap.add_argument("--mcp")
    ap.add_argument("--persona")
    ap.add_argument("--plugin")
    ap.add_argument("--env", action="append", default=[], metavar="NAME")
    ap.add_argument("--for", dest="for_", action="append", default=[])
    ap.add_argument("--name")
    ap.add_argument("--prompt-file", dest="prompt_file")
    ap.add_argument("--tier")
    ap.add_argument("--harness")
    ap.add_argument("--allow-repo-path", dest="allow_repo_path", action="store_true")
    return ap


def target(group: str, a):
    """(store file, label, project root or None) for machine or project; a project on another orchestrator is
    refused, since nothing there would apply its extras."""
    if group == "machine":
        return X.machine_file(), "this machine", None
    root, st, store = X.find_project(a.project)
    if not X.native(root, st):
        raise X.ExtrasError(f"{root} runs on Orca + Cotal (parked): extras are applied on native Orca only")
    return X.project_file(store), f"project {st.get('name') or root.name}", root


def next_line(root) -> str:
    return (f"next: lane-control project refresh {root}" if root else
            "next: lane-control project refresh <project> for each project on this machine")


def cmd_add(group: str, argv: list) -> int:
    head, tail = (argv[:argv.index("--")], argv[argv.index("--") + 1:]) if "--" in argv else (argv, [])
    a = add_parser(f"lane-control {group} extras add", group == "project").parse_args(head)
    given = [(k, getattr(a, k)) for k in KIND_FLAGS if getattr(a, k)]
    if len(given) != 1:
        raise X.ExtrasError("give exactly one kind: --skill, --mcp, --persona or --plugin (agent hooks, permission "
                            "rules and env values are not extras yet: lc-yw1g)")
    kind, value = given[0]
    if kind != "mcp" and (tail or a.env):
        raise X.ExtrasError("`--` with a command, and --env, are for --mcp only")
    path, label, root = target(group, a)
    person(f"lane-control {group} extras add")
    opts = {"name": a.name, "for": a.for_, "command": tail, "env": a.env, "prompt_file": a.prompt_file,
            "tier": a.tier, "harness": a.harness, "allow_repo_path": a.allow_repo_path}
    entry, warnings = X.make(kind, value, opts)
    if kind == "skill" and group == "project" and X.find(X.defaults(), entry["name"]):
        warnings.append(f"note: {entry['name']} is also a default design skill, installed for the whole user; "
                        "Claude may load the user's copy instead of this one (a personal skill beats a project's). "
                        f"To be sure, turn the default off: lane-control machine extras remove {entry['name']}")
    for w in warnings:
        print(w, file=sys.stderr)
    state = X.add(path, entry)
    print(f"{state} {X.ident(entry)} for {', '.join(entry['for'])} ({label}): {X.describe(entry)}")
    print(next_line(root))
    return 0


def rows_of(store) -> list:
    return [{**{k: e.get(k) for k in ("kind", "name", "origin")}, "id": X.ident(e), "for": e.get("for") or
             list(X.SCOPES), "what": X.describe(e)} for e in X.effective(store)]


def cmd_list(group: str, argv: list) -> int:
    ap = Parser(prog=f"lane-control {group} extras list")
    if group == "project":
        ap.add_argument("project")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args(argv)
    store = X.find_project(a.project)[2] if group == "project" else None
    rows = rows_of(store)
    off = X.load(X.machine_file())["off"]
    if a.json:
        print(json.dumps({"extras": rows, "off": off}, indent=2))
        return 0
    print(f"extras of {a.project} (the machine's, then its own)" if group == "project" else
          "extras of this machine (defaults and the machine's own; every project gets them)")
    if not rows:
        print("  none")
    w = max([len(r["id"]) for r in rows] + [10])
    for r in rows:
        print(f"  {r['id']:<{w}}  {r['origin']:<7}  {','.join(r['for']):<26}  {r['what']}")
    for x in off:
        print(f"  {x:<{w}}  off      (a default turned off: lane-control machine extras add brings it back)")
    print("by role:")
    for s in X.SCOPES:
        ids = [r["id"] for r in rows if s in r["for"]]
        print(f"  {s}: {', '.join(ids) or 'none'}")
    return 0


def cmd_remove(group: str, argv: list) -> int:
    ap = Parser(prog=f"lane-control {group} extras remove")
    if group == "project":
        ap.add_argument("project")
    ap.add_argument("id")
    a = ap.parse_args(argv)
    path, label, root = target(group, a)
    person(f"lane-control {group} extras remove")
    print(f"{X.remove(path, a.id, group == 'machine')} ({label})")
    print(next_line(root) + ": it takes it out of the coordinator's files and of every worktree lane prepare wrote "
          "in, and names each file it removes")
    return 0


def cmd_prepare(argv: list) -> int:
    ap = Parser(prog="lane-control lane prepare", description=(
        "Put a lane's or reviewer's extras in its worktree before its worker starts (Claude and OpenCode). A reviewer "
        "in the lane's worktree adds its own: the folder then holds both roles' extras."))
    ap.add_argument("project")
    ap.add_argument("worktree")
    ap.add_argument("--role", required=True, choices=("lanes", "reviewer"))
    a = ap.parse_args(argv)
    root, st, store = X.find_project(a.project)
    wt = Path(a.worktree).expanduser()
    if wt.is_symlink():
        raise X.ExtrasError(f"{wt} is a symlink: give the worktree's own path")
    wt = wt.resolve()
    if not wt.is_dir():
        raise X.ExtrasError(f"{wt} is not a folder")
    repos = [root, *[Path(x) for x in st.get("attached") or [] if isinstance(x, str)]]
    mine = X.common_dir(wt)
    if mine is None or mine not in [X.common_dir(r) for r in repos if r.is_dir()]:
        raise X.ExtrasError(f"{wt} is not a worktree of {root} (or of a repo attached to it)")
    if wt in [r.resolve() for r in repos]:
        raise X.ExtrasError(f"{wt} is a main checkout, the coordinator's folder: lane-control project refresh gives "
                            "the coordinator its extras")
    had = [s for s in X.read_record(wt).get("scopes", []) if s in ("lanes", "reviewer")]
    scopes = [s for s in X.SCOPES if s in set(had) | {a.role}]
    entries = X.prepare_entries(X.effective(store), scopes)
    try:
        lines, problems = X.apply_folder(wt, entries, scopes, project=root)
    except OSError as e:  # a disk or permission error part way: said as a problem, the record knows both marks
        lines, problems = [], [f"could not write in {wt}: {e.strerror or e}"]
    for line in lines:
        print(f"prepare: {line}")
    for p in problems:
        print(f"prepare: problem: {p}")
    if problems:
        print(f"prepare: failed: none of lane-control's extras are in {wt} (all or nothing); hold the lane")
        return 1
    n = len([e for e in entries if not X.user_level(e) and e["kind"] != "persona"])
    print(f"prepare: done ({', '.join(scopes)} extras in {wt}; {n} extra(s))")
    return 0


def main(argv=None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    try:
        if argv[:1] == ["prepare"]:
            return cmd_prepare(argv[1:])
        if argv[:1] in (["project"], ["machine"]) and len(argv) > 1 and argv[1] in ("add", "list", "remove"):
            return {"add": cmd_add, "list": cmd_list, "remove": cmd_remove}[argv[1]](argv[0], argv[2:])
    except X.ExtrasError as e:
        print(f"lane-control: {e}", file=sys.stderr)
        return 1
    asked = any(x in ("-h", "--help", "help") for x in argv[:2])
    print("usage: lane-control project extras add|list|remove <project> ..., lane-control machine extras "
          "add|list|remove ...,\n       lane-control lane prepare <project> <worktree> --role lanes|reviewer\n\n"
          + __doc__, file=sys.stdout if asked else sys.stderr)
    return 0 if asked else 2


if __name__ == "__main__":
    sys.exit(main())
