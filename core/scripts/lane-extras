#!/usr/bin/env python3
"""lane-extras: the extras the owner adds to the agents' environments (core/extras.py has what each kind does and
where each harness reads it). Run through the front door:

  lane-control project extras add <project> <one kind> [--for lanes|coordinator|reviewer|all]... [--name N]
  lane-control project extras list <project> [--json]
  lane-control project extras remove <project> <kind:name | name>
  lane-control machine extras add <one kind> [--for ...] [--name N]        every project on this machine
  lane-control machine extras list [--json]
  lane-control machine extras remove <kind:name | name>                    a default design skill is turned off
  lane-control lane prepare <project> <worktree> --role lanes|reviewer [--lane KEY] [--issue ID]
                                                     (the coordinator, before a worker starts; a lane's runs the
                                                     lane-start hooks)
  lane-control project gate <project> <PR> [--head <sha>] [--lane KEY] [--issue ID]
                                                     the gate hooks, before a merge: exit 1 is not green
  lane-control project hook <project> <event> [--pr N] [--head <sha>] [--merge-sha <sha>] [--lane KEY]
                                              [--issue ID] [--outcome WORD]
                                                     run one event's hooks now (after-merge and on-report warn only)

Kinds:
  --skill <git-url>@<commit>[:<path>]                      a skill pinned at a full commit
  --mcp <name> [--env NAME]... -- <command> [args]         an MCP server; each --env names a variable the server
                                                           reads from the agent's environment (never a value); an
                                                           argument may say ${NAME} for one
  --persona <name> --prompt-file <path> [--tier swift|standard|deep] [--harness claude|opencode]
                                                           a lane role the coordinator can brief a lane with
  --plugin claude:<plugin>@<marketplace>@<version> | opencode:<package>@<version>
  --hook after-setup|lane-start|gate|after-merge|on-report --script <absolute path | git-url@commit:path>
         [--timeout SECONDS]                               a lifecycle hook: the owner's script, run by lane-control at
                                                           that event with facts as LANE_HOOK_* variables, outside every
                                                           worktree, never with a secret (core/hooks.py); default
                                                           timeout 600 s

add and remove are a person's only, at a terminal (an agent is refused, as for lane new). A file an extra names (an
MCP command or argument, a prompt file, a hook script) must be an absolute path outside every project checkout unless
--allow-repo-path is given; it is pinned by its hash (a git hook by its commit and hash, fetched at add). The same id again replaces the extra (and accepts a changed
file). A project's extras add to the machine's. After a change, run `lane-control project refresh <project>`: it
gives the coordinator its extras, renders the personas, and applies every worktree lane prepare wrote in again (a
removed extra is taken out there too)."""
import argparse
import importlib.machinery
import re
import subprocess
import importlib.util
import json
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parents[2]


def _load(name, rel):
    spec = importlib.util.spec_from_file_location(name, HERE / rel)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


H = _load("lc_hooks", "core/hooks.py")
X = H.X  # one copy of core/extras.py, so one ExtrasError
KIND_FLAGS = ("skill", "mcp", "persona", "plugin", "hook")


class Parser(argparse.ArgumentParser):
    """argparse that never repeats what it could not parse: a misplaced value may be a secret."""

    def error(self, message):
        safe = message.split(":")[0] if "unrecognized arguments" in message else \
            message.split(": invalid choice")[0] + ": invalid choice" if "invalid choice" in message else message
        self.exit(2, f"{self.prog}: {safe} (not shown: one may be a secret); see --help\n")


def person(what: str) -> None:
    """project-setup's person check (as CLI-2's lane new and --force): an agent is refused."""
    loader = importlib.machinery.SourceFileLoader("project_setup_extras",
                                                  str(HERE / "core" / "scripts" / "project-setup"))
    spec = importlib.util.spec_from_loader("project_setup_extras", loader)
    ps = importlib.util.module_from_spec(spec)
    loader.exec_module(ps)
    place = None
    if os.environ.get("ORCA_TERMINAL_HANDLE"):
        ps.add_orca_cli_to_path()
        ps.ORCA = ps.orca_cli()
        place = ps.Place()
    why = ps.agent_caller(place)
    if why:
        raise X.ExtrasError(f"{what} is for a person at a terminal, and {why}. Nothing was changed")


def add_parser(prog: str, project: bool) -> argparse.ArgumentParser:
    ap = Parser(prog=prog)
    if project:
        ap.add_argument("project")
    ap.add_argument("--skill")
    ap.add_argument("--mcp")
    ap.add_argument("--persona")
    ap.add_argument("--plugin")
    ap.add_argument("--hook")
    ap.add_argument("--script")
    ap.add_argument("--timeout")
    ap.add_argument("--env", action="append", default=[], metavar="NAME")
    ap.add_argument("--for", dest="for_", action="append", default=[])
    ap.add_argument("--name")
    ap.add_argument("--prompt-file", dest="prompt_file")
    ap.add_argument("--tier")
    ap.add_argument("--harness")
    ap.add_argument("--allow-repo-path", dest="allow_repo_path", action="store_true")
    return ap


def target(group: str, a):
    """(store file, label, project root or None) for machine or project; a project on another orchestrator is
    refused, since nothing there would apply its extras."""
    if group == "machine":
        return X.machine_file(), "this machine", None
    root, st, store = X.find_project(a.project)
    if not X.native(root, st):
        raise X.ExtrasError(f"{root} runs on Orca + Cotal (parked): extras are applied on native Orca only")
    return X.project_file(store), f"project {st.get('name') or root.name}", root


def next_line(root) -> str:
    return (f"next: lane-control project refresh {root}" if root else
            "next: lane-control project refresh <project> for each project on this machine")


def cmd_add(group: str, argv: list) -> int:
    head, tail = (argv[:argv.index("--")], argv[argv.index("--") + 1:]) if "--" in argv else (argv, [])
    a = add_parser(f"lane-control {group} extras add", group == "project").parse_args(head)
    given = [(k, getattr(a, k)) for k in KIND_FLAGS if getattr(a, k)]
    if len(given) != 1:
        raise X.ExtrasError("give exactly one kind: --skill, --mcp, --persona, --plugin or --hook (agent hooks of "
                            "Claude or OpenCode, permission rules and env values are not extras yet: lc-yw1g)")
    kind, value = given[0]
    if kind != "mcp" and (tail or a.env):
        raise X.ExtrasError("`--` with a command, and --env, are for --mcp only")
    if kind != "hook" and (a.script or a.timeout):
        raise X.ExtrasError("--script and --timeout are for --hook only")
    path, label, root = target(group, a)
    person(f"lane-control {group} extras add")
    opts = {"name": a.name, "for": a.for_, "command": tail, "env": a.env, "prompt_file": a.prompt_file,
            "tier": a.tier, "harness": a.harness, "allow_repo_path": a.allow_repo_path, "script": a.script,
            "timeout": a.timeout}
    entry, warnings = X.make(kind, value, opts)
    if kind == "skill" and group == "project" and X.find(X.defaults(), entry["name"]):
        warnings.append(f"note: {entry['name']} is also a default design skill, installed for the whole user; "
                        "Claude may load the user's copy instead of this one (a personal skill beats a project's). "
                        f"To be sure, turn the default off: lane-control machine extras remove {entry['name']}")
    for w in warnings:
        print(w, file=sys.stderr)
    state = X.add(path, entry)
    if kind == "hook":
        print(f"{state} {X.ident(entry)} ({label}): {X.describe(entry)}")
        print(next_line(root) + ": the coordinator's persona then says to prepare each lane" if entry["event"] ==
              "lane-start" else f"next: nothing to refresh; it runs at the next {entry['event']}")
        return 0
    print(f"{state} {X.ident(entry)} for {', '.join(entry['for'])} ({label}): {X.describe(entry)}")
    print(next_line(root))
    return 0


def rows_of(store) -> list:
    return [{**{k: e.get(k) for k in ("kind", "name", "origin", "event") if k != "event" or e.get("event")},
             "id": X.label(e), "for": X.roles(e), "what": X.describe(e)} for e in X.effective(store)]


def cmd_list(group: str, argv: list) -> int:
    ap = Parser(prog=f"lane-control {group} extras list")
    if group == "project":
        ap.add_argument("project")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args(argv)
    store = X.find_project(a.project)[2] if group == "project" else None
    rows = rows_of(store)
    off = X.load(X.machine_file())["off"]
    if a.json:
        print(json.dumps({"extras": rows, "off": off}, indent=2))
        return 0
    print(f"extras of {a.project} (the machine's, then its own)" if group == "project" else
          "extras of this machine (defaults and the machine's own; every project gets them)")
    if not rows:
        print("  none")
    w = max([len(r["id"]) for r in rows] + [10])
    for r in rows:
        print(f"  {r['id']:<{w}}  {r['origin']:<7}  {','.join(r['for']):<26}  {r['what']}")
    for x in off:
        print(f"  {x:<{w}}  off      (a default turned off: lane-control machine extras add brings it back)")
    print("by role:")
    for s in X.SCOPES:
        ids = [r["id"] for r in rows if s in r["for"]]
        print(f"  {s}: {', '.join(ids) or 'none'}")
    if any(r["kind"] == "hook" for r in rows):
        print("by event:")
        for ev in X.EVENTS:
            ids = [r["id"] for r in rows if r.get("event") == ev]
            print(f"  {ev}: {', '.join(ids) or 'none'}")
    return 0


def cmd_remove(group: str, argv: list) -> int:
    ap = Parser(prog=f"lane-control {group} extras remove")
    if group == "project":
        ap.add_argument("project")
    ap.add_argument("id")
    a = ap.parse_args(argv)
    path, label, root = target(group, a)
    person(f"lane-control {group} extras remove")
    print(f"{X.remove(path, a.id, group == 'machine')} ({label})")
    print(next_line(root) + ": it takes it out of the coordinator's files and of every worktree lane prepare wrote "
          "in, and names each file it removes")
    return 0


def cmd_prepare(argv: list) -> int:
    ap = Parser(prog="lane-control lane prepare", description=(
        "Put a lane's or reviewer's extras in its worktree before its worker starts (Claude and OpenCode). A reviewer "
        "in the lane's worktree adds its own: the folder then holds both roles' extras."))
    ap.add_argument("project")
    ap.add_argument("worktree")
    ap.add_argument("--role", required=True, choices=("lanes", "reviewer"))
    ap.add_argument("--lane", help="the lane's key, for the lane-start hooks")
    ap.add_argument("--issue", help="the lane's issue id, for the lane-start hooks")
    skip_flags(ap)
    a = ap.parse_args(argv)
    H.check_facts({"lane": a.lane, "issue": a.issue})  # before anything is written
    root, st, store = X.find_project(a.project)
    skip = skips(X.effective(store), "lane-start", a, "lane-control lane prepare") if a.role == "lanes" else {}
    wt = Path(a.worktree).expanduser()
    if wt.is_symlink():
        raise X.ExtrasError(f"{wt} is a symlink: give the worktree's own path")
    wt = wt.resolve()
    if not wt.is_dir():
        raise X.ExtrasError(f"{wt} is not a folder")
    repos = [root, *[Path(x) for x in st.get("attached") or [] if isinstance(x, str)]]
    mine = X.common_dir(wt)
    if mine is None or mine not in [X.common_dir(r) for r in repos if r.is_dir()]:
        raise X.ExtrasError(f"{wt} is not a worktree of {root} (or of a repo attached to it)")
    if wt in [r.resolve() for r in repos]:
        raise X.ExtrasError(f"{wt} is a main checkout, the coordinator's folder: lane-control project refresh gives "
                            "the coordinator its extras")
    had = [s for s in X.read_record(wt).get("scopes", []) if s in ("lanes", "reviewer")]
    scopes = [s for s in X.SCOPES if s in set(had) | {a.role}]
    entries = X.prepare_entries(X.effective(store), scopes)
    try:
        lines, problems = X.apply_folder(wt, entries, scopes, project=root)
    except OSError as e:  # a disk or permission error part way: said as a problem, the record knows both marks
        lines, problems = [], [f"could not write in {wt}: {e.strerror or e}"]
    for line in lines:
        print(f"prepare: {line}")
    for p in problems:
        print(f"prepare: problem: {p}")
    if problems:
        print(f"prepare: failed: none of lane-control's extras are in {wt} (all or nothing); hold the lane")
        return 1
    n = len([e for e in entries if not X.user_level(e) and e["kind"] not in ("persona", "hook")])
    if a.role == "lanes":
        facts = {**facts_of(root, st), "worktree": str(wt), "role": a.role, "lane": a.lane, "issue": a.issue}
        if skip:
            H.record_skip(skip, "lane-start", H.check_facts(facts))
        res = H.run(X.effective(store), "lane-start", facts, skip)
        for line in H.report(res):
            print(f"prepare: {line}")
        if H.failed(res):
            print(f"prepare: failed: {len(H.failed(res))} lane-start hook(s) did not pass; hold the lane and tell "
                  "the owner what they printed")
            for line in H.way_past(res, "lane-start", f"lane-control lane prepare {root} {wt} --role lanes"):
                print(f"prepare: {line}")
            return 1
    print(f"prepare: done ({', '.join(scopes)} extras in {wt}; {n} extra(s))")
    return 0


def facts_of(root: Path, st: dict) -> dict:
    return {"project": st.get("name") or root.name, "project_root": str(root)}


def fact_flags(ap) -> None:
    ap.add_argument("--head", help="the PR's full head commit")
    ap.add_argument("--lane", help="the lane's key")
    ap.add_argument("--issue", help="the lane's issue id")
    ap.add_argument("--repo", help="the checkout of the repo the PR is in, for a repo attached to the project "
                                   "(default: the project's own)")
    skip_flags(ap)


def skip_flags(ap) -> None:
    ap.add_argument("--skip-hook", dest="skip_hook", action="append", default=[], metavar="NAME",
                    help="a person at a terminal only: do not run this hook once, recorded with --reason")
    ap.add_argument("--reason")


def skips(entries: list, event: str, a, what: str) -> dict:
    """--skip-hook: checked, and a person's only (an agent is refused, as for extras add)."""
    if not a.skip_hook:
        return {}
    skip = H.check_skip(entries, event, a.skip_hook, a.reason)
    person(f"{what} --skip-hook")
    return skip


def repo_of(root: Path, st: dict, given: "str | None") -> Path:
    """The checkout the PR is in: the project's own, or a repo attached to it."""
    if not given:
        return root
    d = Path(given).expanduser().resolve()
    repos = [root, *[Path(x).resolve() for x in st.get("attached") or [] if isinstance(x, str)]]
    if d not in repos:
        raise X.ExtrasError(f"--repo {d} is neither the project's checkout nor a repo attached to it")
    return d


def pr_head(root: Path, pr: str) -> "str | None":
    """The PR's head commit by `gh pr view` (read only), or None."""
    try:
        r = subprocess.run(["gh", "pr", "view", pr, "--json", "headRefOid", "-q", ".headRefOid"], cwd=root,
                           capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return None
    sha = r.stdout.strip()
    return sha if r.returncode == 0 and re.fullmatch(r"[0-9a-f]{40}", sha) else None


def cmd_gate(argv: list) -> int:
    ap = Parser(prog="lane-control project gate", description=(
        "Run the project's gate hooks (the machine's, then its own) for a PR before it is merged. Exit 0: green, "
        "merge only the head it names; exit 1: not green, do not merge."))
    ap.add_argument("project")
    ap.add_argument("pr")
    fact_flags(ap)
    a = ap.parse_args(argv)
    root, st, store = X.find_project(a.project)
    entries = X.effective(store)
    gates = X.hooks_for(entries, "gate")
    if not gates:  # green before anything else is looked at
        print(f"gate: passed for PR {a.pr}: no gate hooks (lane-control project|machine extras add --hook gate ...)")
        return 0
    repo = repo_of(root, st, a.repo)
    facts = H.check_facts({**facts_of(root, st), "repo": str(repo), "pr": a.pr, "head_sha": a.head,
                           "lane": a.lane, "issue": a.issue})
    skip = skips(entries, "gate", a, "lane-control project gate")
    head = a.head or pr_head(repo, a.pr)
    if not head:
        print(f"gate: failed for PR {a.pr}: its head commit cannot be read (gh pr view {a.pr} in {repo}); give "
              "--head <full sha>: not green, do not merge")
        return 1
    facts["head_sha"] = head
    if skip:
        H.record_skip(skip, "gate", facts)
    total = sum(int(e.get("timeout") or X.HOOK_TIMEOUT) for e in gates if H.scoped(e) not in skip)
    print(f"gate: running {len(gates)} gate hook(s) for PR {a.pr} at {head}, up to {total} s in all", flush=True)
    res = H.run(entries, "gate", facts, skip)
    for line in H.report(res):
        print(f"gate: {line}")
    bad = H.failed(res)
    if bad:
        print(f"gate: failed for PR {a.pr} at {head}: {len(bad)} of {len(res)} gate hook(s) did not pass: not "
              "green, do not merge; tell the owner what they printed")
        cmd = f"lane-control project gate {root} {a.pr} --head {head}" + (f" --repo {repo}" if repo != root else "")
        for line in H.way_past(res, "gate", cmd):
            print(f"gate: {line}")
        return 1
    ran = [r for r in res if r["state"] == "ok"]
    skipped = [r["id"] for r in res if r["state"] == "skipped"]
    if not ran:
        print(f"gate: not run for PR {a.pr} at {head}: every gate hook was skipped by a person ({', '.join(skipped)});"
              f" green only on that person's word: merge only this head (--match-head-commit {head})")
        return 0
    print(f"gate: passed for PR {a.pr} at {head} ({len(ran)} gate hook(s) run" +
          (f", {len(skipped)} skipped by a person: {', '.join(skipped)}" if skipped else "") +
          f"): merge only this head (--match-head-commit {head})")
    return 0


def cmd_hook(argv: list) -> int:
    ap = Parser(prog="lane-control project hook", description=(
        "Run one event's hooks for the project now, with the facts given. A failing gate or lane-start exits 1; "
        "after-merge and on-report only warn (exit 0); after-setup exits 1."))
    ap.add_argument("project")
    ap.add_argument("event", choices=X.EVENTS)
    ap.add_argument("--pr")
    ap.add_argument("--merge-sha", dest="merge_sha")
    ap.add_argument("--outcome", choices=H.OUTCOMES, help="the report's status, the word after the lane key "
                                                          "(succeeded, failed, blocked, ...), or escalation")
    ap.add_argument("--worktree")
    fact_flags(ap)
    a = ap.parse_args(argv)
    root, st, store = X.find_project(a.project)
    entries = X.effective(store)
    if not X.hooks_for(entries, a.event):  # nothing to run: done before anything else is looked at
        print(f"hook: no {a.event} hooks for {st.get('name') or root.name}")
        return 0
    repo = repo_of(root, st, a.repo)
    facts = H.check_facts({**facts_of(root, st), "repo": str(repo), "pr": a.pr, "head_sha": a.head,
                           "merge_sha": a.merge_sha, "lane": a.lane, "issue": a.issue, "outcome": a.outcome,
                           "worktree": a.worktree})
    skip = skips(entries, a.event, a, "lane-control project hook")
    if skip:
        H.record_skip(skip, a.event, facts)
    res = H.run(entries, a.event, facts, skip)
    for line in H.report(res):
        print(f"hook: {line}")
    bad = H.failed(res)
    if bad and a.event in H.BLOCKING:
        print(f"hook: failed: {len(bad)} {a.event} hook(s) did not pass")
        for line in H.way_past(res, a.event, f"lane-control project hook {root} {a.event} ..."):
            print(f"hook: {line}")
        return 1
    if bad:
        print(f"hook: warning: {len(bad)} {a.event} hook(s) did not pass; {a.event} only warns, nothing is undone: "
              "tell the owner what they printed")
    return 0


def main(argv=None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    try:
        if argv[:1] == ["prepare"]:
            return cmd_prepare(argv[1:])
        if argv[:1] == ["gate"]:
            return cmd_gate(argv[1:])
        if argv[:1] == ["hook"]:
            return cmd_hook(argv[1:])
        if argv[:1] in (["project"], ["machine"]) and len(argv) > 1 and argv[1] in ("add", "list", "remove"):
            return {"add": cmd_add, "list": cmd_list, "remove": cmd_remove}[argv[1]](argv[0], argv[2:])
    except X.ExtrasError as e:
        print(f"lane-control: {e}", file=sys.stderr)
        return 1
    asked = any(x in ("-h", "--help", "help") for x in argv[:2])
    print("usage: lane-control project extras add|list|remove <project> ..., lane-control machine extras "
          "add|list|remove ...,\n       lane-control lane prepare <project> <worktree> --role lanes|reviewer,\n"
          "       lane-control project gate <project> <PR>, lane-control project hook <project> <event> ...\n\n"
          + __doc__, file=sys.stdout if asked else sys.stderr)
    return 0 if asked else 2


if __name__ == "__main__":
    sys.exit(main())
