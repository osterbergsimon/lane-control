#!/usr/bin/env python3
"""lane-sweep: find merged, parked, stuck and broken lanes (Orca worktrees that are not a main checkout) on this
machine (spec section 8; reliability.md entry 30).

  lane-sweep                    report only
  lane-sweep --apply            also remove the lanes the rules below allow
  lane-sweep --stuck-hours N    stuck after N hours without activity (default 6; the night manager uses 2)
  lane-sweep --precheck         for an Orca automation's precheck: exit 0 only when something is reported

A merged lane is removed (--apply) only if all hold: its branch has a merged PR and HEAD is that PR's head or behind
it; `git status --porcelain` is empty, untracked files included; no Orca terminal of it printed anything for 30
minutes; and no agent process (claude, opencode, codex) has its cwd inside the worktree. Otherwise MERGED-KEEP says
why. An open-PR lane is removed the same way (owner, 2026-11-19) when its PR's head is exactly HEAD, the tree is
clean, no terminal printed for 30 minutes and no agent runs in it: the worktree then holds nothing GitHub lacks, and a
fix round checks the PR branch out into a new worktree. In report mode such a lane is listed as PR-PARKED, which is
information only (it waits on the owner) and not a finding. Removing closes the lane's terminals and runs `orca-ide
worktree rm --delete-branch`; the PR and the remote branch are kept. Nothing else is ever removed.

The PR is looked up by the lane's upstream branch when the upstream is that same branch (`x` for a local `x` or
`<user>/x`), never by a base branch it tracks (a lane on `origin/develop` would match develop's old merged PRs).
Stuck: no activity for --stuck-hours, where activity is the newest of Orca's lastActivityAt (which alone can be days
old), the last push, the last commit and the last terminal output, and not parked. Parked: an open PR, HEAD equal to
or behind the pushed branch, a clean tree, and either no live terminal or the PR's head is HEAD.

Worktrees on another Orca host (hostId not local) are left to that machine's sweep. Lanes listed in
~/.config/lane-control/lane-sweep.hold (one worktree path per line, `#` comments; LANE_SWEEP_HOLD)
are skipped. With machine.conf, each line ends `owner=<coordinator>`: the coordinator whose checkout the lane belongs
to. Exit: 0 nothing found, 10 something reported; with --precheck 0 something reported, 1 nothing; 2 Orca or the
machine could not be read.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
import machineconf  # noqa: E402

QUIET_MIN = 30
AGENT = re.compile(r"claude|opencode|codex")  # in any argv word's basename: wrappers and node scripts count too


class SweepError(Exception):
    pass


def orca(*args) -> dict:
    try:
        r = subprocess.run([machineconf.orca_cli(), *args, "--json"], capture_output=True, text=True, timeout=120)
        data = json.loads(r.stdout or "{}")
    except (OSError, subprocess.TimeoutExpired, ValueError) as e:
        raise SweepError(f"orca-ide {' '.join(args)}: {e}") from None
    if r.returncode != 0 or not data.get("ok", False):
        msg = (data.get("error") or {}).get("message") or r.stderr.strip() or f"exit {r.returncode}"
        raise SweepError(f"orca-ide {' '.join(args)}: {msg}")
    return data.get("result") or {}


def git(path, *args, timeout=60) -> "str | None":
    try:
        r = subprocess.run(["git", "-C", str(path), *args], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def is_ancestor(path, a: str, b: str) -> bool:
    return subprocess.run(["git", "-C", str(path), "merge-base", "--is-ancestor", a, b],
                          capture_output=True).returncode == 0


def pr_of(path, branch: str, state: str) -> "dict | None":
    try:
        r = subprocess.run(["gh", "pr", "list", "--head", branch, "--state", state, "--json", "number,headRefOid,url",
                            "--limit", "1"], cwd=path, capture_output=True, text=True, timeout=120)
        rows = json.loads(r.stdout) if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, ValueError):
        rows = None
    if rows is None:
        raise SweepError(f"gh pr list --head {branch} --state {state} failed")
    return rows[0] if rows else None


def live_agent_cwds() -> list:
    """The cwd of every agent process of this user (LANE_PROC_DIR, default /proc)."""
    proc, uid, out = Path(os.environ.get("LANE_PROC_DIR") or "/proc"), os.getuid(), []
    try:
        entries = [e for e in proc.iterdir() if e.name.isdigit()]
    except OSError:
        return out
    for e in entries:
        try:
            if e.stat().st_uid != uid:
                continue
            argv = (e / "cmdline").read_bytes().split(b"\0")
            if any(AGENT.search(os.path.basename(a.decode(errors="replace"))) for a in argv if a):
                out.append(os.readlink(e / "cwd").removesuffix(" (deleted)"))
        except OSError:
            continue
    return out


def inside(cwd: str, path: str) -> bool:
    return cwd == path or cwd.startswith(path.rstrip("/") + "/")


def held() -> set:
    f = Path(os.environ.get("LANE_SWEEP_HOLD") or Path.home() / ".config" / "lane-control" / "lane-sweep.hold")
    try:
        lines = f.read_text().splitlines()
    except FileNotFoundError:
        return set()
    paths = {re.sub(r"\s*#.*", "", x).strip() for x in lines}
    return {p for p in paths if p} | {os.path.realpath(p) for p in paths if p}


def owners() -> dict:
    """{realpath of a coordinator's checkout: its name} from machine.conf; empty without one."""
    try:
        return {os.path.realpath(c.checkout): c.name for c in machineconf.coordinators(machineconf.load())}
    except machineconf.ConfError:
        return {}


def owner_of(path: str, table: dict) -> str:
    common = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if not common or not table:
        return ""
    main = os.path.realpath(os.path.dirname(common) if os.path.basename(common) == ".git" else common)
    return f" owner={table[main]}" if main in table else ""


def upstream(path: str, branch: str) -> tuple:
    """(remote, branch on the remote) to look PRs and pushes up by: the upstream only when it names this branch."""
    remote = git(path, "config", f"branch.{branch}.remote") or "origin"
    merge = (git(path, "config", f"branch.{branch}.merge") or "").removeprefix("refs/heads/")
    if merge and merge in (branch, branch.rsplit("/", 1)[-1]):
        return remote, merge
    return ("origin" if remote == "." else remote), branch


class Sweep:
    def __init__(self, apply: bool, stuck_hours: float):
        self.apply, self.stuck_hours, self.now = apply, stuck_hours, time.time()
        self.found = False
        self.lines = []

    def say(self, line: str, finding: bool = True):
        self.lines.append(line)
        self.found = self.found or finding

    def remove(self, wt: dict, handles: list) -> bool:
        for h in handles:
            try:
                orca("terminal", "close", "--terminal", h)
            except SweepError:
                pass
        try:
            orca("worktree", "rm", "--worktree", f"id:{wt['id']}", "--delete-branch")
            return True
        except SweepError:
            return False

    def lane(self, wt: dict, terms: list, agents: list, own: dict):
        path = wt.get("path") or ""
        branch = (wt.get("branch") or "").removeprefix("refs/heads/")
        if not os.path.isdir(path):
            return self.say(f"GONE   {path} (worktree path missing; Orca entry left)")
        tag = owner_of(path, own)
        if not branch:
            return self.say(f"DETACH {path} (no branch){tag}")
        mine = [t for t in terms if t.get("worktreePath") == path]
        handles = [t["handle"] for t in mine if t.get("handle")]
        quiet_since = (self.now - QUIET_MIN * 60) * 1000
        recent_output = any((t.get("lastOutputAt") or 0) > quiet_since for t in mine)
        real = os.path.realpath(path)
        agent = any(inside(c, real) or inside(c, path) for c in agents)
        head = git(path, "rev-parse", "HEAD") or ""
        dirty = git(path, "status", "--porcelain")
        dirty = dirty is None or dirty != ""
        remote, rb = upstream(path, branch)
        terminals = f"{len(handles)} terminal(s)"
        try:
            merged = pr_of(path, rb, "merged")
            opened = None if merged else pr_of(path, rb, "open")
        except SweepError as e:
            return self.say(f"CHECK  {path} (could not look up its PRs: {e}){tag}")

        if merged:
            n, prhead = merged["number"], merged.get("headRefOid", "")
            why = ""
            if head != prhead and not is_ancestor(path, head, prhead):
                why = "commits after the merged PR head"
            elif dirty:
                why = "uncommitted or untracked files"
            elif recent_output:
                why = f"a terminal printed output in the last {QUIET_MIN} min"
            elif agent:
                why = "an agent is still running in it"
            if why:
                return self.say(f"MERGED-KEEP {path} (#{n} merged; kept: {why}){tag}")
            if not self.apply:
                return self.say(f"MERGED {path} (#{n} merged; would close {terminals} and remove){tag}")
            if self.remove(wt, handles):
                return self.say(f"REMOVED {path} (#{n} merged; {terminals} closed){tag}")
            return self.say(f"MERGED-FAIL {path} (#{n} merged; worktree rm failed){tag}")

        if opened and opened.get("headRefOid") == head and not dirty and not recent_output and not agent:
            n = opened["number"]
            if not self.apply:
                return self.say(f"PR-PARKED {path} (#{n} open, pushed and clean; --apply would close {terminals} and "
                                f"remove it){tag}", finding=False)
            if self.remove(wt, handles):
                return self.say(f"PR-REMOVED {path} (#{n} open, pushed and clean; recreate from its branch for a "
                                f"fix){tag}")
            return self.say(f"PR-FAIL {path} (#{n} open; worktree rm failed){tag}")

        times = [(wt.get("lastActivityAt") or 0) / 1000,
                 max([(t.get("lastOutputAt") or 0) / 1000 for t in mine] or [0])]
        commit = git(path, "log", "-1", "--format=%ct", "HEAD")
        times.append(int(commit) if commit and commit.isdigit() else 0)
        limit = self.stuck_hours * 3600
        if self.now - max(times) < limit:
            return
        git(path, "fetch", "-q", remote, rb, timeout=120)
        pushed = git(path, "log", "-1", "--format=%ct", f"{remote}/{rb}")
        times.append(int(pushed) if pushed and pushed.isdigit() else 0)
        if self.now - max(times) < limit:
            return
        parked = (opened is not None and is_ancestor(path, "HEAD", f"{remote}/{rb}") and not dirty
                  and (opened.get("headRefOid") == head or not any(t.get("connected") for t in mine)))
        if parked:
            return
        hours = int((self.now - max(times)) // 3600)
        self.say(f"STUCK  {path} (branch {branch}, no push, commit, terminal output or Orca activity for {hours} h, "
                 f"no merged PR){tag}")


def main(argv) -> int:
    ap = argparse.ArgumentParser(prog="lane-sweep", description=__doc__.split("\n\n")[0])
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--precheck", action="store_true")
    ap.add_argument("--stuck-hours", type=float, default=6)
    a = ap.parse_args(argv)
    if a.apply and a.precheck:
        ap.error("--precheck only reports")
    sweep = Sweep(a.apply, a.stuck_hours)
    try:
        wts = orca("worktree", "list").get("worktrees", [])
        terms = orca("terminal", "list").get("terminals", []) or []
    except SweepError as e:
        print(f"lane-sweep: {e}", file=sys.stderr)
        return 2
    hold, own, agents = held(), owners(), live_agent_cwds()
    for wt in wts:
        if wt.get("isMainWorktree") or wt.get("isArchived") or wt.get("hostId") not in (None, "", "local"):
            continue  # a worktree on another Orca host (an SSH box) is that machine's own sweep's
        p = wt.get("path") or ""
        if p in hold or os.path.realpath(p) in hold:
            continue
        sweep.lane(wt, terms, agents, own)
    for line in sweep.lines:
        print(line)
    if not sweep.found:
        print("nothing found")
    if a.precheck:
        return 0 if sweep.found else 1
    return 10 if sweep.found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
