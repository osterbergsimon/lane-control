ENV_NAME = re.compile(r"[A-Za-z0-9._-]{1,64}")


def tool_path(env: str, rel: str) -> str:
    """A lane-control tool, or the stand-in a test or trial names in env."""
    return os.environ.get(env) or str(HERE / rel)


def hosts_dir() -> Path:
    return config_home() / "lane-control" / "hosts"


def host_record(host: str) -> Path:
    return hosts_dir() / f"{env_name(host)}.json"


def this_machine() -> str:
    """This machine's name for a box to save it under: Orca's machine name, else the host name."""
    name = ""
    try:
        rows = LOCAL.jrun("host", "list")["result"]["hosts"]
        name = next((h.get("machineName") or "" for h in rows if h.get("kind") == "local"), "")
    except (Fail, KeyError, TypeError):
        pass
    if not name:
        import socket
        name = socket.gethostname().split(".")[0]
    return env_name(name)[:64] or "desktop"


def link_port(link: str) -> int:
    """The port of an Orca pairing link's endpoint, which must be this computer's own address. Every message is
    free of the link and of what it holds."""
    import base64
    import urllib.parse
    bad = Fail("that is not an Orca pairing link (orca://pair?code=...), so nothing was sent or started. Make it in "
               'Orca here: Settings > Servers > "Share this computer"')
    try:
        text = link.strip()
        if text.lower().startswith("orca://"):
            u = urllib.parse.urlsplit(text)
            if u.netloc.lower() != "pair":
                raise ValueError
            code = (urllib.parse.parse_qs(u.query).get("code") or [""])[0] or u.fragment
        else:
            code = text
        code = code.replace("+", "-").replace("/", "_")
        payload = json.loads(base64.urlsafe_b64decode(code + "=" * (-len(code) % 4)))
        ep = urllib.parse.urlsplit(payload["endpoint"])
        address, port = ep.hostname, ep.port
    except Exception:  # noqa: BLE001 (any parse error: one message, without the link)
        raise bad from None
    if address != "127.0.0.1":  # the tunnel binds 127.0.0.1 at both ends: localhost or ::1 would never connect
        raise Fail("the link names another address than this computer's own 127.0.0.1, so nothing was sent or "
                   'started. Make it again choosing 127.0.0.1 (Settings > Servers > "Share this computer"), and '
                   "revoke the one you made: a network address widens what the desktop listens on")
    if not port:
        raise bad
    return port


def link_for_port(link: str, port: int, remote: int) -> str:
    """The link with its endpoint's port changed from `port` (this machine's, behind the tunnel) to `remote` (the one
    the box dials), everything else as it was; the link itself when they are the same. The endpoint is only where the
    box dials: Orca pins this machine by the offer's public key and seals the token to it (Orca 1.4.250 and 1.4.268,
    read from its source), so the rest of the offer stays valid. Every message is free of the link."""
    if remote == port:
        return link
    import base64
    import urllib.parse
    bad = Fail("the link's endpoint is not plainly 127.0.0.1 and its port, so it cannot be pointed at another port "
               "on the box; nothing was sent or started. Leave out --tunnel-remote-port, or make the link again")
    try:
        text = link.strip()
        if text.lower().startswith("orca://"):
            u = urllib.parse.urlsplit(text)
            code = (urllib.parse.parse_qs(u.query).get("code") or [""])[0] or u.fragment
        else:
            code = text
        code = code.replace("+", "-").replace("/", "_")
        payload = json.loads(base64.urlsafe_b64decode(code + "=" * (-len(code) % 4)))
        ep = urllib.parse.urlsplit(payload["endpoint"])
        if ep.netloc != f"127.0.0.1:{port}":  # no user part, no other spelling of the address or the port
            raise ValueError
        payload["endpoint"] = urllib.parse.urlunsplit(ep._replace(netloc=f"127.0.0.1:{remote}"))
        # Orca's own encoding: JSON.stringify, then unpadded base64url, as orca://pair?code=
        data = json.dumps(payload, separators=(",", ":"), ensure_ascii=False).encode()
        return "orca://pair?code=" + base64.urlsafe_b64encode(data).decode().rstrip("=")
    except Exception:  # noqa: BLE001 (one message, without the link)
        raise bad from None


def box_pairing_remote(place: Place, op: str, name: str, link: "str | None" = None) -> str:
    """The box-side pairing step (project-setup --box-pairing on the host's copy): its one-word answer."""
    r = place.ssh(remote_cmd("scripts/project-setup", ["--box-pairing", op, name]), input=link)
    said = [l.strip() for l in r.stdout.splitlines() if l.strip()]
    if r.returncode != 0 or not said:
        err = [l.strip() for l in (r.stderr or "").splitlines() if l.strip()]
        why = err[-1] if err else f"exit {r.returncode}"
        raise Fail(f"on {place.host}, pairing step {op} failed: {why}")
    return said[-1]


def recorded_ports(host: str) -> "tuple | None":
    """(this machine's port, the box's port) of the host's tunnel from its record; a record from before the two
    could differ has tunnel_port only, which is both."""
    try:
        rec = json.loads(host_record(host).read_text())
        port = rec["tunnel_port"]
        remote = rec.get("tunnel_remote_port", port)
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return None
    ok = all(isinstance(p, int) and not isinstance(p, bool) and 1 <= p <= 65535 for p in (port, remote))
    return (port, remote) if ok else None


def saved_environments() -> "list | None":
    """The names of the environments saved in this machine's Orca, or None when it cannot say."""
    try:  # an empty stdin: nothing the owner types ahead for the link's prompt can reach Orca's CLI
        p = LOCAL.run("environment", "list", "--json", stdin=subprocess.DEVNULL, timeout=60)
        return [e.get("name") for e in json.loads(p.stdout)["result"]["environments"]]
    except (Fail, ValueError, KeyError, TypeError, AttributeError):
        return None


def pairing_preview(place: Place, desktop_lanes_on: bool, by_hand: bool = False) -> None:
    """Before the box's server and the box's own run, for a native-Orca box project: the pairing each direction has,
    and when the desktop's link will be asked for, the steps to make it now (owner 2026-11-25: a hand step is a
    prerequisite, said up front). Changes nothing."""
    host, envs = place.host, saved_environments()
    if envs is None:
        say("pairing", "direction 1 unknown", "(this machine's Orca did not list its environments; the next step "
            "checks the server itself)")
    elif place.env in envs:
        say("pairing", "direction 1 saved", f"(environment {place.env} here; whether it answers is checked next)")
    else:
        say("pairing", "direction 1 to do", f"(no environment {place.env} here: setup puts Orca's server on {host} "
            "and pairs it with this machine, orca-host-install)")
    if not desktop_lanes_on:
        return say("pairing", "direction 2 skipped", "(--no-desktop-lanes)")
    if recorded_ports(host):
        return say("pairing", "direction 2 recorded", f"(paired earlier; setup checks on {host} that it still answers "
                   "and asks for no link when it does)")
    if not has_terminal():
        return say("pairing", "direction 2 skipped", "(the desktop's link is made or asked for only in a terminal)")
    if not by_hand:
        return say("pairing", "direction 2 to do", f"(later in this run setup asks once whether to make {host}'s link "
                   "to this desktop's Orca itself, with orca pair, after saying what it grants and changes; "
                   "--pair-by-hand keeps the hand link, which keeps this desktop on loopback)")
    print(PAIR_STEPS.format(host=host), flush=True)


DESKTOP_PORT = int(os.environ.get("LANE_DESKTOP_ORCA_PORT") or 6768)  # the desktop Orca's own listener
BOX_PROBE = r'''
import json, os, re, shutil, subprocess, sys
me, want = sys.argv[1], (sys.argv[2] if len(sys.argv) > 2 else "")
old = sys.argv[3] if len(sys.argv) > 3 else ""  # the name an earlier run saved this desktop under
home = os.path.expanduser("~")
path = os.environ.get("PATH", "") + os.pathsep + home + "/bin" + os.pathsep + home + "/.local/bin"
lc = os.path.join(os.environ.get("XDG_DATA_HOME") or home + "/.local/share", "lane-control")
try:  # the installed tree's sha (core/install.py: `current` names it, its MARK file says it), "old" for a copy from before
    sha = os.readlink(lc + "/current")
    with open(os.path.join(lc, sha, ".lane-control-sha")) as f:
        installed = f.read().strip() == sha and sha
except OSError:
    installed = None
out = {"lane_control": installed or ("old" if os.access(lc + "/scripts/project-setup", os.X_OK) else None),
       "agents": [n for n in ("claude", "opencode", "opencode2", "codex") if shutil.which(n, path=path)]}
# Orca's CLI as project-setup --box-pairing finds it (orca_cli), but never a bare `orca`: that may be another program
cli = next((c for c in (os.environ.get("ORCA_CLI"), home + "/.orca/cli/bin/orca", shutil.which("orca-ide"),
                        home + "/.config/orca/linux-orca-cli-shim/orca") if c and os.access(c, os.X_OK)), None)
out["orca_cli"] = bool(cli)
def orca(*args):
    p = subprocess.run([cli, *args, "--json"], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
    return json.loads(p.stdout)
if cli:
    try:
        names = [e.get("name") for e in orca("environment", "list")["result"]["environments"]]
        if old and old != me and old in names and me not in names:  # a box keeps one name per desktop
            try:
                rt = orca("status", "--environment", old)["result"]["runtime"]
                out["old_desktop"] = "reachable" if rt.get("reachable") and rt.get("state") == "ready" else "saved"
            except Exception:
                out["old_desktop"] = "saved"
        if me not in names:
            out["desktop"] = "missing"
        else:
            try:
                rt = orca("status", "--environment", me)["result"]["runtime"]
                out["desktop"] = "reachable" if rt.get("reachable") and rt.get("state") == "ready" else "saved"
            except Exception:
                out["desktop"] = "saved"
    except Exception as e:
        out["desktop_error"] = "environment list: " + type(e).__name__
# the gateway key: the {env:NAME} of a provider's options.apiKey in OpenCode's config, the coordinator's provider first
key, conf = None, os.environ.get("XDG_CONFIG_HOME") or home + "/.config"
for f in (conf + "/opencode/opencode.json", conf + "/opencode/opencode.jsonc"):
    try:
        text = open(f).read()
    except OSError:
        continue
    try:
        provs = json.loads(re.sub(r"(?m)^\s*//.*$", "", text)).get("provider") or {}
        for name in ([want] if want in provs else []) + [k for k in provs if k != want]:
            m = re.fullmatch(r"\{env:([A-Za-z_][A-Za-z0-9_]*)\}",
                             str(((provs.get(name) or {}).get("options") or {}).get("apiKey") or ""))
            if m:
                key = m.group(1)
                break
    except (ValueError, AttributeError, TypeError):
        out["gateway_config_error"] = os.path.basename(f)
    if key:
        break
out["gateway_key_env"] = key
out["gateway_key_set"] = bool(key and os.environ.get(key))
# Orca's server runtimes (core/boxhealth.py, sent ahead of this probe): one server, nothing of an older slot; the pin
# it serves (its slot's name, .version and app version); the user manager's SHELL against passwd.
procs = orcad(home)
out["runtime"] = list(runtimes(procs)) + [procs]
srv = [p for p in procs if p["role"] == "server"]
if len(srv) == 1:
    d = os.path.join(home, ".orca-remote", "orcad-" + srv[0]["slot"])
    pin = {"slot": srv[0]["slot"]}
    try:
        pin["version"] = open(os.path.join(d, ".version")).read().strip()
    except OSError:
        pass
    try:
        pin["app"] = str(json.load(open(os.path.join(d, "out", "package.json"))).get("version") or "")
    except (OSError, ValueError, AttributeError):
        pass
    out["pin"] = pin
out["shell"] = list(shells())
out["server_shell"] = server_shell(srv[0]["pid"]) if len(srv) == 1 else None  # what the running server started with
out["orcad_unit"] = os.path.isfile(os.path.join(conf, "systemd", "user", "orcad.service"))
def anchor(folder, persona, name):  # "unset" without a rendered persona; else whether the anchor is in the folder
    f = os.path.expanduser(folder)
    if not os.path.isfile(os.path.join(f, ".lane-control", persona)):
        return "unset"
    try:
        with open(os.path.join(f, name), errors="replace") as h:
            return "ok" if "<!-- lane-control:persona-anchor begin" in h.read() else "missing"
    except OSError:
        return "missing"
out["anchors"] = {"project": anchor(sys.argv[4], "coordinator.md", "CLAUDE.local.md"),
                  "machine": anchor("~/machine-coordinator", "machine-coordinator.md", "CLAUDE.local.md")}
print(json.dumps(out))
'''  # what --check asks the box in one ssh call: names and yes/no only, never a value


def box_probe() -> str:
    """The probe --check sends: core/boxhealth.py's functions, then BOX_PROBE."""
    return (HERE / "core" / "boxhealth.py").read_text() + "\n" + BOX_PROBE
CHECK_REFUSES = ("--remove-host", "--suggest-tiers", "--refresh", "--readapt", "--show", "--write-orca-yaml",
                 "--trust-folder", "--with", "--private", "--beads-repo", "--via-host", "--desktop-environment")
UNCHECKED = "could not check"  # a row whose answer was not read: --check is then not ok


def box_folder(a) -> str:
    """The project's folder on the box, as setup there finds it: the path given, else ~/code/<name> for a URL."""
    if a.target.startswith(("/", "~/")):
        return a.target
    base = a.name or re.sub(r"\.git$", "", a.target.rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1])
    dest = a.dest if a.dest != str(Path.home() / "code") else "~/code"
    return f"{dest.rstrip('/')}/{slug(base)}"


def check_host(a, host: str) -> int:
    """--check <repo> <host>: every prerequisite of `project-setup <repo> <host>`, each on its own line, missing ones
    with what fixes them. Reads only: nothing is copied, installed, paired, started or written, here or there. A row
    it could not read says so ("could not check: <why>"). Exit 0 when nothing is missing and every row was read; 1
    otherwise. A step setup does itself, and the link the owner makes when setup asks, are "to do" and pass."""
    if not remote_target_ok(a.target):
        print("project-setup: with a host, give a URL or an absolute (or ~/) path on the host", file=sys.stderr)
        return 2
    global ORCA
    add_orca_cli_to_path()
    ORCA = orca_cli()
    place, rows = Place(host), []

    def row(name, state, detail=""):
        rows.append((name, state))
        say(f"check {name}", state, detail)

    def unread(name, why):
        row(name, UNCHECKED, f"({why})")

    here, ready = None, False
    if not LOCAL.found():
        row("orca here", "missing", "(the Orca CLI is not found: orca-ide, or set ORCA_CLI)")
    else:
        try:
            rt = json.loads(LOCAL.run("status", "--json", check=False, timeout=30).stdout)["result"]["runtime"]
            ready = bool(rt.get("reachable") and rt.get("state") == "ready")
            here = rt.get("appVersion") if ready else None
        except (Fail, ValueError, KeyError, TypeError, AttributeError):
            ready = False
        row("orca here", "ok" if ready else "missing",
            f"(Orca {here or 'of a version it does not report'})" if ready else
            "(Orca's runtime does not answer: start Orca here)")
    if listens_beyond_loopback(DESKTOP_PORT):
        row("desktop listener", "warn", f"(this desktop's Orca listens beyond loopback on port {DESKTOP_PORT}, so "
            "anything that reaches this machine can try it: an earlier network pairing did that, and it stays while "
            "that client is paired. A 127.0.0.1 link does not change it; see remote.md, Do you need the tunnel?)")
    else:
        row("desktop listener", "ok", f"(loopback only on port {DESKTOP_PORT})")
    harness, _, rest = (a.coordinator or "claude/opus").partition("/")
    provider = rest.split("/", 1)[0] if harness == "opencode" and "/" in rest else ""
    me, probe, no_probe = this_machine(), None, None
    old = recorded_desktop_name(host) or ""
    try:
        r = place.ssh(f"python3 - {shlex.quote(me)} {shlex.quote(provider)} {shlex.quote(old)} "
                      f"{shlex.quote(box_folder(a))}", input=box_probe(), timeout=90)
        if r.returncode == 255:
            no_probe = f"ssh {host} did not answer"
            row("ssh", "missing", f"(ssh {host} needs a prompt or fails: run `ssh {host}` once by hand for its host "
                "key, and give it a key it can use without asking)")
        else:
            row("ssh", "ok", f"({host} answers without a prompt)")
            try:
                probe = json.loads((r.stdout.strip().splitlines() or [""])[-1])
                if not isinstance(probe, dict):
                    raise ValueError
            except ValueError:
                probe, no_probe = None, f"python3 did not run on {host}"
                row("python on box", "missing", f"(python3 does not run on {host}; setup needs it there)")
    except Fail as e:
        no_probe = str(e)
        row("ssh", "missing", f"({e})")
    envs = saved_environments() if ready else None
    d1_todo = False
    if envs is None:
        unread("direction 1", "this machine's Orca did not list its environments")
    elif place.env not in envs:
        d1_todo = True
        row("direction 1", "to do", f"(no environment {place.env} here: project-setup <repo> {host} puts Orca's "
            "server there and pairs it, orca-host-install)")
    elif not place.reachable():
        d1u = next((t for t in HEALTH.tunnel_units(config_home()) if t["unit"] == f"orca-tunnel-{place.env}.service"),
                   None)
        row("direction 1", "missing", f"(environment {place.env} is saved here but does not answer: is "
            f"orca-tunnel-{place.env}.service running here, and Orca's server on {host}? systemctl --user status "
            f"orca-tunnel-{place.env}.service" + (f"; to restore the tunnel: {HEALTH.repair(d1u, HERE)}" if d1u else
                                                   "") + ")")
    else:
        try:
            box = place.jrun("status")["result"]["runtime"].get("appVersion")
        except (Fail, KeyError, TypeError, AttributeError):
            box = None
        row("direction 1", "ok", f"(environment {place.env} answers here)")
        if not (here and box):
            unread("versions", f"Orca did not say its version: here {here or 'not said'}, {host} {box or 'not said'}")
        else:
            row("versions", "ok" if here == box else "warn", f"(here {here}, {host} {box}" + (
                "" if here == box else ": keep both on one version, remote.md direction 1 step 2") + ")")
    if d1_todo and (a.orca_from or a.orca_bundle):
        src = a.orca_from or a.orca_bundle
        there = Path(src).expanduser().is_dir() if a.orca_from else Path(src).expanduser().is_file()
        row("orca source", "ok" if there else "missing", f"({src} is there)" if there else
            f"({src} is not a {'folder' if a.orca_from else 'file'} here, so orca-host-install has no source)")
    if d1_todo or not a.no_desktop_lanes:  # orca-host-install's -L unit (direction 1), lane-tunnel's -R unit (2)
        sysd = shutil.which("systemctl") is not None and subprocess.run(
            ["systemctl", "--user", "show-environment"], capture_output=True, stdin=subprocess.DEVNULL).returncode == 0
        row("systemd here", "ok" if sysd else "missing", "(a user manager runs the tunnels here)" if sysd else
            "(no systemd user manager here, so the tunnels cannot run: log in with one, or loginctl enable-linger "
            "$USER)")
    ports = recorded_ports(host)
    if a.no_desktop_lanes:
        row("direction 2", "skipped", "(--no-desktop-lanes)")
    elif probe is None:
        unread("direction 2", no_probe)
    elif not probe.get("orca_cli"):
        row("direction 2", "to do", f"(no Orca CLI on {host} yet, so no link either: setup puts Orca's server there "
            f"first. {pair_steps_short(a.pair_by_hand)})")
    elif probe.get("desktop_error"):
        unread("direction 2", f"Orca's CLI on {host} failed: {probe['desktop_error']}")
    elif probe.get("desktop") == "reachable":
        row("direction 2", "ok", f"({host} reaches this machine's Orca as environment {me})")
    elif probe.get("desktop") == "saved":
        row("direction 2", "missing", f"({host} has this machine's Orca as {me} but cannot reach it: the tunnel "
            "is down, see the tunnel line)")
    elif probe.get("desktop") == "missing" and probe.get("old_desktop") == "reachable":
        row("direction 2", "ok", f"({host} reaches this machine's Orca as environment {old}, the name an earlier run "
            f"gave it; this machine is now {me}, and setup keeps the old name)")
    elif probe.get("desktop") == "missing" and probe.get("old_desktop") == "saved":
        row("direction 2", "missing", f"({stale_name_steps(host, old, me)})")
    elif probe.get("desktop") == "missing":
        row("direction 2", "to do", f"({host}'s Orca has no environment {me}, so no link to this desktop yet: "
            f"{pair_steps_short(a.pair_by_hand)})")
    else:
        unread("direction 2", f"the answer from {host} named no state")
    # The tunnels, as units: a listening port is not proof (lc-l78). Active/running, the restart counter not climbing,
    # the unit's own ssh owning the socket, and never multiplexed onto a ControlMaster (ControlPath=none).
    found = {t["unit"]: t for t in HEALTH.tunnel_units(config_home())}
    d1 = found.get(f"orca-tunnel-{place.env}.service")
    d2 = found.get(f"lane-tunnel@{env_name(host)}.service") if not a.no_desktop_lanes and ports else None
    if not a.no_desktop_lanes and ports and d2 is None:  # recorded, but no env file: the unit was stopped
        d2 = {"unit": f"lane-tunnel@{env_name(host)}.service", "host": host, "port": None, "controlpath": True,
              "kind": "lane-tunnel", "env": {"PORT": str(ports[0]), "REMOTE_PORT": str(ports[1])}}
    states = HEALTH.health({t["unit"]: t["port"] for t in (d1, d2) if t})

    def tunnel_row(label, t):
        state, detail = states[t["unit"]]
        fix = HEALTH.repair(t, HERE) + (" (with the options it was started with)" if t["kind"] == "lane-tunnel" and
                                        not t.get("env", {}).get("SSH_HOST") else "")
        if state == "not checked":
            return unread(label, f"{t['unit']}: {detail}")
        if state != "ok":
            return row(label, "missing", f"({detail}: {fix})")
        if not t["controlpath"]:
            return row(label, "missing", f"({t['unit']} was written before ControlPath=none, so its ssh can ride your "
                       f"ControlMaster and flap while the port answers: {fix})")
        row(label, "ok", f"({detail})")

    if d1:
        tunnel_row("direction 1 tunnel", d1)
    if not a.no_desktop_lanes:
        if ports:
            tunnel_row("tunnel", d2)
        else:
            row("tunnel", "to do", "(setup starts it before the link is sent)")
    program = BINARIES.get(harness, harness)
    if a.no_start:
        row("agent on box", "skipped", "(--no-start)")
    elif probe is None:
        unread("agent on box", no_probe)
    else:
        have = program in probe.get("agents", [])
        row("agent on box", "ok" if have else "missing", f"({program} on {host})" if have else
            f"({program} is not on {host}'s PATH, ~/bin or ~/.local/bin: install it there and sign in once by "
            "hand; setup never copies a credential)")
    if harness == "opencode":
        key = probe.get("gateway_key_env") if probe else None
        if probe is None:
            unread("gateway key", no_probe)
        elif probe.get("gateway_config_error"):
            unread("gateway key", f"OpenCode's {probe['gateway_config_error']} on {host} is not plain JSON")
        elif not key:
            row("gateway key", "warn", f"(OpenCode's config on {host} names no provider apiKey as {{env:...}}; "
                "docs/getting-started.md 2.3)")
        else:
            row("gateway key", "ok" if probe.get("gateway_key_set") else "warn",
                f"({key} is set in an ssh shell on {host})" if probe.get("gateway_key_set") else
                f"({key}, which OpenCode's config on {host} names, is not set in an ssh shell there; Orca's "
                "environment on the box must have it, docs/getting-started.md 2.3)")
    if probe is None:
        unread("lane-control on box", no_probe)
    else:
        there, here = probe.get("lane_control"), INSTALL.installed()
        if there and there == here:
            row("lane-control on box", "ok", f"({INSTALL.short(there)}, the one installed here)")
        elif there and there != "old":
            row("lane-control on box", "ok", f"({INSTALL.short(there)}; here {INSTALL.short(here)}: setup or --refresh "
                                             "sends this machine's)")
        elif there == "old":
            row("lane-control on box", "to do", "(a copy from before the install; setup sends the whole tree)")
        else:
            row("lane-control on box", "to do", "(setup sends this machine's installed tree)")
    if probe is None:
        unread("runtimes on box", no_probe)
    else:
        state, detail, procs = ((probe.get("runtime") or []) + [None, "", []])[:3]
        pin = probe.get("pin") or {}
        one = [x for x in procs or [] if x.get("role") == "server"]
        pport = (d1 or {}).get("port") or (one[0].get("port") if len(one) == 1 else None)  # direction 1's, else the server's
        if state == "ok":
            want = a.orca_version
            if want and want not in (pin.get("slot"), pin.get("version"), pin.get("app")):
                row("runtimes on box", "missing", f"({detail}, but --orca-version asks for {want}: "
                    f"scripts/orca-host-install {host} --pair --port {pport or '<its port>'} --version {want} "
                    "--stop-stale, which replaces it only while it is unused)")
            else:
                row("runtimes on box", "ok", f"({detail}" + (f", Orca {pin['app']}" if pin.get("app") else "") + ")")
        elif state == "broken":
            row("runtimes on box", "missing", f"({detail}. One runtime per host: scripts/"
                f"{HEALTH.pair_fix(host, procs or [], pport)} names each process and stops only an older build's "
                f"unused ones; one in use goes once its terminals end; another of the same build, on {host}: kill "
                "<its pid>)")
        elif state == "none":
            row("runtimes on box", "to do" if d1_todo else "warn",
                "(no Orca server runs there yet: setup starts one)" if d1_todo else
                f"({detail} on {host}, though direction 1 answers: a server started some other way is not checked)")
        else:
            unread("runtimes on box", f"the answer from {host} named no runtime")
        manager, login = (probe.get("shell") or [None, None])[:2]
        sstate, sdetail = HEALTH.shell_state(manager, login, probe.get("server_shell"))
        if not manager:
            row("shell on box", "skipped", f"(no systemd user manager answered on {host}; a detached server starts "
                "with the login shell)")
        elif sstate == "ok":
            row("shell on box", "ok", f"({sdetail})")
        elif sstate == "broken" and not probe.get("orcad_unit"):
            row("shell on box", "to do", f"({sdetail}: orca-host-install sets it before it starts Orca's server)")
        elif sstate == "broken":
            row("shell on box", "missing", f"({sdetail}. On {host}: {HEALTH.shell_fix(login)})")
        else:
            row("shell on box", "missing", f"({sdetail}. On {host}: systemctl --user restart orcad.service (its "
                "terminals end; a running agent keeps the environment it started with))")
    for kind, who, skip, writes in (
            ("project", "the box's coordinator", None, f"project-setup <repo> {host}"),
            ("machine", "the box's machine coordinator", "--no-machine-setup" if a.no_machine_setup else None,
             f"machine-setup, which project-setup <repo> {host} runs there,")):
        name = f"{kind} anchor on box"
        state = (probe or {}).get("anchors", {}).get(kind)
        if probe is None:
            unread(name, no_probe)
        elif state == "ok":
            row(name, "ok", f"({who}'s folder has its persona anchor)")
        elif skip:
            row(name, "skipped", f"({skip})")
        elif state == "missing":
            row(name, "to do", f"(a persona but no anchor: a session started by hand is not told to read it; "
                f"{writes} writes it)")
        else:
            row(name, "to do", f"({writes} writes it with {who}'s persona)")
    missing = [n for n, s in rows if s == "missing"]
    unchecked = [n for n, s in rows if s == UNCHECKED]
    todo = [n for n, s in rows if s == "to do"]
    if not missing and not unchecked:
        say("check", "ok", f"(project-setup <repo> {host} has what it needs" +
            (f"; to do in that run: {', '.join(todo)}" if todo else "") + "; nothing was changed)")
        return 0
    said = [f"{len(missing)} missing" if missing else "", f"{len(unchecked)} {UNCHECKED}" if unchecked else ""]
    say("check", ", ".join(s for s in said if s), "(" + ", ".join(missing + unchecked) + "; nothing was changed)")
    return 1


PAIR_STEPS_SHORT = ('Make the link in Orca here: Settings > Servers > "Share this computer", choosing 127.0.0.1, then '
                    "paste it when project-setup <repo> <host> asks, on its hidden prompt")


def pair_steps_short(by_hand: bool) -> str:
    """What --check says setup will do for the desktop's link."""
    if by_hand:
        return f"a step of yours that setup asks for (--pair-by-hand). {PAIR_STEPS_SHORT}"
    return (f"setup makes the link with orca pair --address 127.0.0.1:<box port> --rotate after your yes, which ends "
            f"every other unused access link of this Orca and makes it listen on every interface (port "
            f"{DESKTOP_PORT}); --pair-by-hand keeps it on loopback: {PAIR_STEPS_SHORT}")


def recorded_desktop_name(host: str) -> "str | None":
    """The name an earlier run saved this desktop under on the box (the host's record), or None."""
    try:
        name = json.loads(host_record(host).read_text()).get("desktop_environment")
    except (OSError, ValueError, AttributeError):
        return None
    return name if isinstance(name, str) and ENV_NAME.fullmatch(name) else None


def stale_name_steps(host: str, old: str, me: str) -> str:
    return (f"{host} has this desktop saved as {old}, and this machine's name is now {me}. A box keeps one name per "
            f"desktop and refuses a second one, so a rename is remove-then-add: project-setup --remove-host {host} "
            f"(removes {old} there and stops the tunnel), then project-setup <repo> {host} again")


def listeners(port: int) -> list:
    """(address, socket inode) of every TCP listener on this port here, the address as 127.0.0.1:<port> or
    [::]:<port> (from /proc/net/tcp*); empty when nothing listens or /proc cannot say."""
    import ipaddress
    found = set()
    for f, v6 in (("/proc/net/tcp", False), ("/proc/net/tcp6", True)):
        try:
            rows = Path(f).read_text().splitlines()[1:]
        except OSError:
            continue
        for row in rows:
            cols = row.split()
            if len(cols) < 10 or cols[3] != "0A":  # 0A = LISTEN
                continue
            addr, _, p = cols[1].partition(":")
            try:
                if int(p, 16) != port:
                    continue
                raw = bytes.fromhex(addr)  # the kernel's words, each in host (little-endian) order
                raw = b"".join(raw[i:i + 4][::-1] for i in range(0, len(raw), 4))
                ip = ipaddress.ip_address(raw)
            except ValueError:
                continue
            found.add((f"[{ip}]:{port}" if v6 else f"{ip}:{port}", cols[9]))
    return sorted(found)


def listen_addresses(port: int) -> list:
    return sorted({a for a, _ in listeners(port)})


def orca_app_pid() -> "int | None":
    """The pid of this desktop's running Orca app, as `orca status` says it."""
    try:
        pid = json.loads(LOCAL.run("status", "--json", check=False, stdin=subprocess.DEVNULL,
                                   timeout=30).stdout)["result"]["app"]["pid"]
    except (Fail, ValueError, KeyError, TypeError):
        return None
    return pid if isinstance(pid, int) and not isinstance(pid, bool) and pid > 0 else None


def held_by(pid: int, inodes: set) -> bool:
    """Whether the process holds one of these sockets (its /proc/<pid>/fd links)."""
    try:
        fds = list(Path(f"/proc/{pid}/fd").iterdir())
    except OSError:
        return False
    for fd in fds:
        try:
            if os.readlink(fd) in {f"socket:[{i}]" for i in inodes}:
                return True
        except OSError:
            continue
    return False


def orca_listener(port: int) -> tuple:
    """(addresses on the port, whether this desktop's Orca app holds them, Orca's pid). Orca's CLI does not say its
    own port, so setup checks that the listener on the port it expects is the running Orca's."""
    rows = listeners(port)
    pid = orca_app_pid() if rows else None
    return [a for a, _ in rows], bool(pid and held_by(pid, {i for _, i in rows})), pid


class OfferUnavailable(Fail):
    """Orca answered that it makes no offer (it widened nothing: a failed widen is undone)."""


def mint_link(remote: int) -> str:
    """This desktop's Orca makes a fresh access link for the box: `orca pair --address 127.0.0.1:<remote> --rotate
    --json` (owner 2026-11-26; field report H). --rotate, because Orca hands out an unused earlier offer again
    otherwise, and the box must not share a link with whoever that was made for; it also ends every other unused one,
    which setup says before asking. The answer is read from a pipe and kept in memory: never printed, logged or
    written, and no message carries it. The link the box gets dials 127.0.0.1:<remote>."""
    p = LOCAL.run("pair", "--address", f"127.0.0.1:{remote}", "--rotate", "--json", check=False,
                  stdin=subprocess.DEVNULL, timeout=60)
    try:
        res = json.loads(p.stdout)
        offer = res.get("result") or {}
        if res.get("ok") is False:
            raise Fail(f"orca pair failed here: {redact((res.get('error') or {}).get('message')) or 'no reason given'}"
                       "; no link was made")
        if not offer.get("available"):
            raise OfferUnavailable(f"Orca here made no link: {redact(offer.get('reason')) or 'unavailable'}: "
                                   f"{redact(offer.get('guidance'))}")
        link = offer["pairingUrl"]
        if not isinstance(link, str):
            raise TypeError
    except (ValueError, KeyError, TypeError, AttributeError):
        raise Fail(f"orca pair gave no link it could read (exit {p.returncode})") from None
    finally:
        p = None  # noqa: F841 (its stdout held the link)
    try:
        port = link_port(link)
    except Fail:
        raise Fail("the link orca pair made does not name 127.0.0.1 and a port, so it was not sent") from None
    return link_for_port(link, port, remote)  # an Orca that keeps its own port: the box still dials its own end


def retire_offer(remote: int) -> bool:
    """`orca pair --rotate`: the link setup made stops working if the box did not use it (one it used stays until
    it is revoked), and so does any other unused one. Its answer, a new unused link nobody holds, is dropped unread."""
    try:
        p = LOCAL.run("pair", "--address", f"127.0.0.1:{remote}", "--rotate", "--json", check=False,
                      stdin=subprocess.DEVNULL, timeout=60)
        return p.returncode == 0
    except Fail:
        return False


def ask_link(host: str) -> str:
    """The hand link (Settings > Servers > "Share this computer"), read hidden; "" when the owner skips."""
    print(SHARE_HELP.format(host=host), flush=True)
    import getpass
    import warnings
    with warnings.catch_warnings():
        warnings.simplefilter("error", getpass.GetPassWarning)  # getpass would read with echo: refuse instead
        try:
            return getpass.getpass(f"Desktop share link for {host} (hidden; Enter to skip): ").strip()
        except getpass.GetPassWarning:
            raise Fail("this terminal cannot hide what is typed, so the share link is not asked for here; nothing "
                       "was sent. Run project-setup in another terminal, or pass --no-desktop-lanes") from None
        except (EOFError, KeyboardInterrupt):
            return ""


def today() -> str:
    return time.strftime("%Y-%m-%d")


def ask_mint(host: str, me: str, remote: int, port: int, addrs: list, replaces: bool) -> bool:
    """Before minting: what the link grants, what --rotate ends, what it does to this desktop's listener (and whether
    it already listens on every interface), what it replaces, how to undo it; then one yes, Enter being no (owner
    2026-11-26: questions in setup are fine)."""
    now = ", ".join(addrs)
    wide = any(not a.startswith(("127.", "[::1]", "[::ffff:127.")) for a in addrs)
    listener = (MINT_WIDE if wide else MINT_WIDENS).format(now=now, port=port, host=host)
    print(MINT_HELP.format(host=host, remote=remote, grant=GRANT.format(host=host), listener=listener,
                           replaces=REPLACES.format(host=host, me=me) if replaces else "",
                           revoke=MINT_REVOKE.format(host=host, when=f"today, {today()}")), flush=True)
    return owner_says_yes(f"Make {host}'s link with orca pair now? [y/N] ", step="desktop lanes")


def after_mint(host: str, port: int, retired: "bool | None", when: str) -> str:
    """What the owner needs once setup asked Orca for a link, whatever happened next: the listener as it is now (the
    ask widens it), what the rotate did, and the mint's revoke steps."""
    now = listen_addresses(port)
    return (f"Setup asked this desktop's Orca for a link, which makes it listen on every interface: it listens on "
            f"{', '.join(now) or 'an address /proc does not show'} now (port {port}). "
            + ("Setup ran orca pair --rotate, which ends that link if " + host + " did not use it (and any other "
               "unused link of this Orca). " if retired else
               "The rotate that would end an unused link failed: run orca pair --rotate --json > /dev/null here. "
               if retired is False else "")
            + "To undo the rest: " + MINT_REVOKE.format(host=host, when=when))


def restart_tunnel(place: Place, ports: tuple, tunnel_opts: "list | None") -> bool:
    """A paired box whose tunnel is down (a reboot, a locked card): lane-tunnel start with the recorded ports, then
    whether the box reaches this machine again within PAIR_WAIT."""
    host, me = place.host, this_machine()
    t = subprocess.run([tool_path("LANE_TUNNEL", "core/scripts/lane-tunnel"), "start", *(tunnel_opts or []),
                        "--remote-port", str(ports[1]), host, str(ports[0])], capture_output=True, text=True)
    if t.returncode != 0:
        return False
    end = time.time() + PAIR_WAIT
    while True:
        try:
            if box_pairing_remote(place, "status", me) == "reachable":
                return True
        except Fail:
            pass
        if time.time() >= end:
            return False
        time.sleep(2)


def desktop_lanes(place: Place, tunnel_opts: "list | None" = None, remote_port: "int | None" = None,
                  by_hand: bool = False) -> "str | None":
    """Direction 2: the box pairs with this desktop's Orca, through a reverse tunnel. The environment's name on the
    box, or None when skipped. By default this desktop's Orca makes the link (orca pair, after the owner's yes);
    by_hand (or a no) asks for the hand link instead (PAIN-1). tunnel_opts are lane-tunnel start's own options
    (--auth-sock, --ssh, --no-enable); remote_port is the port the box dials (default: the link's, or this desktop's
    Orca port when setup makes the link)."""
    host, me = place.host, this_machine()
    state = box_pairing_remote(place, "status", me)
    ports = recorded_ports(host)
    old = recorded_desktop_name(host)
    if state == "missing" and old and old != me:  # one name per desktop per box: a second one would be refused
        was = box_pairing_remote(place, "status", old)
        if was == "reachable":
            say("desktop lanes", "exists", f"{host} has this machine's Orca as environment {old}, the name an earlier "
                f"run gave it (this machine is now {me}; to rename it: {stale_name_steps(host, old, me)})")
            return old
        if was == "saved":
            say("desktop lanes", "stale", f"({stale_name_steps(host, old, me)}; nothing was made or sent)")
            return None
    again = (f"core/scripts/lane-tunnel start <options> --remote-port {ports[1]} {host} {ports[0]}" if ports else
             f"core/scripts/lane-tunnel start <options> --remote-port <box port> {host} <port> (the ports are "
             "tunnel_port and tunnel_remote_port in the host's record under ~/.config/lane-control/hosts/)")
    if state == "saved" and ports:  # paired before, the tunnel is down (a reboot, a locked card): fix the tunnel first
        if restart_tunnel(place, ports, tunnel_opts):
            say("tunnel", "restarted", f"lane-tunnel@{env_name(host)}.service, from the host's record")
            say("desktop lanes", "exists", f"{host} reaches this machine's Orca as environment {me} again; no new link")
            return me
        say("tunnel", "down", f"{host} has this machine's Orca as environment {me} but cannot reach it, and "
            f"restarting the tunnel from the record did not bring it back ({again}; journalctl --user -u "
            f"lane-tunnel@{env_name(host)}.service). A new link replaces that pairing (below): answer no, then Enter, "
            "to keep it and fix the tunnel instead")
    if state == "reachable":
        given = [f for f, v in (("--tunnel-auth-sock", tunnel_opts and "--auth-sock" in tunnel_opts),
                                ("--tunnel-ssh", tunnel_opts and "--ssh" in tunnel_opts),
                                ("--tunnel-no-enable", tunnel_opts and "--no-enable" in tunnel_opts),
                                ("--tunnel-remote-port", remote_port is not None)) if v]
        unused = (f"; {' '.join(given)} not used: the tunnel is already paired and running. To change its options "
                  f"run {again}; another port on the box needs pairing again (project-setup --remove-host {host}, "
                  "then a new link)") if given else ""
        say("desktop lanes", "exists", f"{host} has this machine's Orca as environment {me}{unused}")
        return me
    if not has_terminal():
        say("desktop lanes", "skipped", f"(the desktop's link is made or asked for only in a terminal: run "
            f"project-setup <repo> {host} in one to let {host}'s coordinator run lanes here; --no-desktop-lanes "
            "stops the question)")
        return None
    mint, link = False, ""
    if not by_hand:
        port = DESKTOP_PORT
        addrs, ours, pid = orca_listener(port)
        if not addrs:
            say("desktop lanes", "by hand", f"(this desktop's Orca does not listen on port {port}, so setup cannot "
                "make the link for it: LANE_DESKTOP_ORCA_PORT names the port it uses; the hand link names its own)")
        elif not ours:
            say("desktop lanes", "by hand", f"(something listens on port {port} here, but not this desktop's Orca "
                f"app ({'pid ' + str(pid) if pid else 'Orca did not say its pid'}), so setup does not make the link "
                "for it: the tunnel would lead elsewhere. LANE_DESKTOP_ORCA_PORT names Orca's port; the hand link "
                "names its own)")
        else:
            mint = ask_mint(host, me, remote_port or port, port, addrs, state == "saved")
            if not mint:
                print("Then the hand link, which keeps this desktop on loopback:", flush=True)
    if not mint:
        if state == "saved":
            print(REPLACES.format(host=host, me=me).strip(), flush=True)
        link = ask_link(host)
        if not link:
            say("desktop lanes", "skipped", f"(no link; run again to add it, or --no-desktop-lanes)")
            return None
        port = link_port(link)
    remote = remote_port or port
    if link:
        link = link_for_port(link, port, remote)  # the box dials its own end of the tunnel
    tunnel = tool_path("LANE_TUNNEL", "core/scripts/lane-tunnel")
    unit = f"lane-tunnel@{env_name(host)}.service"
    other = ("To pair by hand instead: run again with --pair-by-hand (the Share link, which also keeps this desktop "
             "on loopback). " if mint else "") + FALLBACK_HELP
    subprocess.run([tunnel, "stop", host], capture_output=True)  # an earlier tunnel of ours would hold the port
    # The box's end must be ours: whatever else listens there (the box's own Orca server, another user's program)
    # would get the code instead of this machine.
    if not wait_box_port(place, remote, "free"):
        raise Fail(f"port {remote} on {host} is in use (its own Orca server, or another program) or not open to your "
                   "user there, so the tunnel back "
                   f"here cannot open there; nothing was sent. Run again with --tunnel-remote-port <a free port on "
                   f"{host}> for the box's end, or move what listens there (Orca's server: orca-host-install {host} "
                   "--pair --port <another>)")
    t = subprocess.run([tunnel, "start", *(tunnel_opts or []), "--remote-port", str(remote), host, str(port)],
                       capture_output=True, text=True)
    if t.returncode != 0:
        # lane-tunnel leaves an always-on unit enabled and retrying after a failed start. Pairing failed here, so stop
        # it and forget its env file; a retry of this command starts it afresh.
        subprocess.run([tunnel, "stop", host], capture_output=True)
        raise Fail((t.stderr.strip() or "lane-tunnel failed") + f"; nothing was sent to {host}. For a host that "
                   "takes only a smartcard or an agent's key: unlock it, then pass --tunnel-auth-sock <agent socket> "
                   "(and --tunnel-ssh <wrapper>)")
    when = f"{today()}, at {time.strftime('%H:%M')}"
    asked = sent = added = False
    unavailable = False

    def record():
        hosts_dir().mkdir(parents=True, exist_ok=True)
        write_atomic(host_record(host), json.dumps({
            "host": host, "environment": place.env, "desktop_environment": me, "tunnel_port": port,
            "tunnel_remote_port": remote, "link": "orca pair" if mint else "by hand", "paired_at": when},
            indent=2).encode(), 0o600)

    try:
        up = wait_box_port(place, remote, "busy")
        for _ in range(2):  # and it is our unit that holds it, not another program after the unit died
            up = up and subprocess.run([tunnel, "status", host], capture_output=True).returncode == 0
            time.sleep(1)
        if not up:
            raise Fail(f"the tunnel {unit} did not come up on {host}, so nothing was sent (journalctl --user -u {unit}). "
                       "The unit's ssh runs without your ssh agent unless --tunnel-auth-sock names one: it needs a key "
                       "it can use alone, with no passphrase (IdentityFile in the ssh config it uses), or that agent")
        if box_pairing_remote(place, "exposed", str(remote)) != "no":
            raise Fail(f"on {host} the tunnel's port {remote} is open on more than 127.0.0.1 (sshd's GatewayPorts is on "
                       "there), which would put this desktop's Orca on that network; nothing was sent. Set "
                       "GatewayPorts no (or clientspecified) in the box's sshd_config, then run again")
        say("tunnel", "created", t.stdout.strip())
        if mint:  # only now: a check that failed above leaves this desktop's listener as it was
            asked = True
            try:
                link = mint_link(remote)
            except OfferUnavailable as e:
                unavailable = True
                raise Fail(f"{e}; nothing was sent to {host}. {other}") from None
            except Fail as e:
                raise Fail(f"{e}; nothing was sent to {host}. {other}") from None
        if state == "saved":  # saved there earlier but not reachable: removed only now, when a new link is ready
            box_pairing_remote(place, "rm", me)
        sent = True
        try:
            box_pairing_remote(place, "add", me, link)
        except Fail as e:
            raise Fail(f"{e}. If {host} has this desktop saved under another name, a second one is refused: on "
                       f"{host}, orca-ide environment list; remove the old one (orca-ide environment rm --environment "
                       f"<old>), then run again. {other}") from None
        added = True
        link = None
        end = time.time() + PAIR_WAIT
        while True:  # the proof: the same reads --check makes on the box (environment list, status --environment)
            try:
                state = box_pairing_remote(place, "status", me)
            except Fail:
                state = "unknown"  # the box is paired: a status that fails says pending, below
            if state == "reachable" or time.time() >= end:
                break
            time.sleep(2)
    except BaseException:
        if added:  # the box has the link: keep the tunnel and the record, so a re-run and --remove-host find them
            record()
        else:
            subprocess.run([tunnel, "stop", host], capture_output=True)
        if asked:
            retired = None if added or unavailable else retire_offer(remote)
            print(("The tunnel to " + host + " is stopped again. " if not added else "")
                  + after_mint(host, port, retired, when), file=sys.stderr)
        elif sent:
            print(f"The tunnel to {host} is stopped again. The link may have reached {host}: "
                  + REVOKE_HELP.format(host=host, when="the day you made it"), file=sys.stderr)
        raise
    finally:
        link = None  # noqa: F841 (dropped as soon as the box has it)
    record()
    if state == "reachable":
        say("desktop lanes", "created", f"{host} reaches this machine's Orca as environment {me} "
            f"(tunnel lane-tunnel@{env_name(host)}.service)")
    else:
        say("desktop lanes", "pending", f"saved on {host} as {me}, but not reachable yet: see systemctl --user status "
            f"lane-tunnel@{env_name(host)}.service")
    if mint:
        now = listen_addresses(port)
        say("desktop listener", "now", f"this desktop's Orca listens on {', '.join(now) or 'an address /proc does not show'}"
            f" (port {port})")
        print("To undo: " + MINT_REVOKE.format(host=host, when=when) + f" Until then {host} can run commands as you "
              "on this computer.")
    else:
        print(REVOKE_HELP.format(host=host, when="the day you made it"))
    return me


TUNNEL_WAIT = float(os.environ.get("LANE_TUNNEL_WAIT") or 20)  # seconds for the box's end of the tunnel to open


def wait_box_port(place: Place, port: int, want: str) -> bool:
    """Whether 127.0.0.1:<port> on the box becomes `want` (free or busy) within TUNNEL_WAIT."""
    end = time.time() + TUNNEL_WAIT
    while True:
        if box_pairing_remote(place, "port", str(port)) == want:
            return True
        if time.time() >= end:
            return False
        time.sleep(0.5)


def host_server(place: Place, port: "int | None", pin: "list | None" = None) -> None:
    """Direction 1: Orca's server on the host, paired here (orca-host-install), unless it already answers. `pin` is
    orca-host-install's --from/--bundle/--version for the server's source and version."""
    if place.reachable():
        unused = f"; {' '.join('--orca-' + x[2:] for x in pin[::2])} not used: the server is already there" if pin else ""
        say("orca server", "exists", f"{place.host} (environment {place.env} answers here{unused})")
        return
    if port is None:  # the desktop's own listener is 6768, and the tunnel uses one port at both ends
        import socket
        for port in range(6769, 6869):
            with socket.socket() as s:
                try:
                    s.bind(("127.0.0.1", port))
                    break
                except OSError:
                    continue
        else:
            raise Fail("no free port in 6769-6868 here for the tunnel to the host's Orca server; pass --orca-port")
    tool = tool_path("LANE_ORCA_HOST_INSTALL", "orchestrators/orca-cotal/scripts/orca-host-install")
    try:
        r = subprocess.run([tool, place.host, "--pair", "--port", str(port), *(pin or [])], stdin=subprocess.DEVNULL,
                           timeout=900)
    except subprocess.TimeoutExpired:
        raise Fail(f"orca-host-install {place.host} --pair took more than 15 minutes; stopped") from None
    if r.returncode != 0:
        raise Fail(f"orca-host-install {place.host} --pair failed (exit {r.returncode}); nothing else was done")
    if not place.reachable():
        raise Fail(f"Orca's server on {place.host} was installed but environment {place.env} does not answer here "
                   f"(orca-ide status --environment {place.env})")
    say("orca server", "created", f"{place.host} on port {port} (environment {place.env})")


def seen_here(place: Place, project: str) -> None:
    """Whether this machine's Orca shows the host's coordinator (through the paired environment)."""
    try:
        rows = place.jrun("terminal", "list")["result"]["terminals"]
    except (Fail, KeyError, TypeError) as e:
        return say("seen here", "unknown", f"(terminal list --environment {place.env}: {e})")
    want = session_title("coordinator", project)
    titles = sorted({bare_title(t.get("title")) for t in rows if not t.get("orphaned")})
    if want in titles:
        say("seen here", "ok", f"{want!r} on {place.host}, in this machine's Orca (environment {place.env})")
    else:
        say("seen here", "missing", f"no terminal {want!r} through environment {place.env}; it has: "
            + (", ".join(t for t in titles if t) or "none"))


def tunnel_options(a) -> list:
    """lane-tunnel start's options for what project-setup was given (the unit's agent socket, ssh wrapper, no enable)."""
    return [*(["--auth-sock", a.tunnel_auth_sock] if a.tunnel_auth_sock else []),
            *(["--ssh", a.tunnel_ssh] if a.tunnel_ssh else []),
            *(["--no-enable"] if a.tunnel_no_enable else [])]


def native_on_host(a, argv: list, host: str, value_flags: set) -> int:
    """project-setup <repo> <host> on native Orca: Orca's server there (direction 1), the host's own copy of
    project-setup for the phase 3 steps, the desktop lanes (direction 2), machine-setup there."""
    if not remote_target_ok(a.target):
        print("project-setup: with a host, give a URL or an absolute (or ~/) path on the host", file=sys.stderr)
        return 2
    global ORCA
    add_orca_cli_to_path()
    ORCA = orca_cli()
    place = Place(host)
    try:
        if not LOCAL.found():
            raise Fail("Orca CLI not found here (orca-ide; or set ORCA_CLI)")
        if not a.show:  # the copy and the question need no Orca server on the host yet; --show sends nothing
            copy_to_host(place)
        rest = host_argv(argv, value_flags, host)
        r = place.ssh(remote_cmd("scripts/project-setup", [*rest, "--via-host", "--which-orchestrator"]), timeout=120)
        which = (r.stdout.strip().splitlines() or [""])[-1]
        if r.returncode != 0 or which not in ORCHESTRATORS:
            raise Fail(f"{host}'s copy of project-setup did not say which orchestrator the project is on"
                       + (f": {r.stderr.strip().splitlines()[-1]}" if r.stderr.strip() else ""))
        if which == "orca-cotal":
            say("orchestrator", "orca-cotal", f"(the project is on Orca + Cotal on {host}; its own path runs there)")
            return reexec(place, rest)
        if a.show or a.refresh:  # the host's own --show or --refresh, and nothing else: no server, link or machine
            return reexec(place, rest)
        pairing_preview(place, not a.no_desktop_lanes, a.pair_by_hand)  # a native-Orca box project: before its server
        host_server(place, a.orca_port, [*(["--from", a.orca_from] if a.orca_from else []),
                                         *(["--bundle", a.orca_bundle] if a.orca_bundle else []),
                                         *(["--version", a.orca_version] if a.orca_version else [])])
        paired = None
        if a.no_desktop_lanes:
            say("desktop lanes", "skipped", "(--no-desktop-lanes)")
        else:
            paired = desktop_lanes(place, tunnel_options(a), a.tunnel_remote_port, a.pair_by_hand)
        rc = reexec(place, [*rest, *(["--desktop-environment", paired] if paired else [])])
        if rc != 0:
            return rc
        if a.no_machine_setup:
            say("machine setup", "skipped", "(--no-machine-setup)")
        else:
            tty = sys.stdin.isatty()  # with a terminal it may ask the owner, who takes their time
            try:
                ms = subprocess.run([tool_path("LANE_MACHINE_SETUP", "core/scripts/machine-setup"), "--host", host,
                                     *(["--no-start"] if a.no_start else []),
                                     *(["--no-model-check"] if a.no_model_check else []),
                                     *(["--trust-folder"] if a.trust_folder else [])],
                                    stdin=None if tty else subprocess.DEVNULL, timeout=None if tty else 1800)
            except subprocess.TimeoutExpired:
                raise Fail(f"machine-setup --host {host} took more than 30 minutes; stopped") from None
            if ms.returncode != 0:
                raise Fail(f"machine-setup --host {host} failed (exit {ms.returncode}); the project is set up there")
        if not a.no_start:
            base = a.name or re.sub(r"\.git$", "", a.target.rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1])
            seen_here(place, base)
        return 0
    except Fail as e:
        print(f"project-setup: {e}", file=sys.stderr)
        return 1


def remove_host(host: str) -> int:
    """--remove-host: the box forgets this machine's Orca, the tunnel stops, and the owner is told to revoke the link.
    Direction 1 (this machine driving the host) stays."""
    global ORCA
    add_orca_cli_to_path()
    ORCA = orca_cli()
    place, ok = Place(host), True
    try:
        rec = json.loads(host_record(host).read_text())
    except (OSError, ValueError):
        rec = {}
    me = rec.get("desktop_environment") if isinstance(rec, dict) else None
    if not (isinstance(me, str) and ENV_NAME.fullmatch(me)):
        me = this_machine()
    try:
        said = box_pairing_remote(place, "rm", me)
        say("box environment", said, f"{me} on {host}")
    except Fail as e:
        ok = False
        print(f"project-setup: {e}", file=sys.stderr)
        say("box environment", "left", f"on {host} run: orca-ide environment rm --environment {me}")
    t = subprocess.run([tool_path("LANE_TUNNEL", "core/scripts/lane-tunnel"), "stop", host], capture_output=True,
                       text=True)
    if t.returncode != 0:
        ok = False
        print(f"project-setup: {t.stderr.strip() or 'lane-tunnel stop failed'}", file=sys.stderr)
    else:
        say("tunnel", "removed", t.stdout.strip())
    if ok:  # kept when a step failed, so a retry finds the same environment name
        host_record(host).unlink(missing_ok=True)
    when = rec.get("paired_at") if isinstance(rec, dict) and isinstance(rec.get("paired_at"), str) else None
    if isinstance(rec, dict) and rec.get("link") == "orca pair":
        print(f"Revoke the link in Orca here: Settings > Servers, " + ENTRY.format(when=when or "the day setup made it")
              + " > revoke. " + NARROW.format(host=host))
    else:
        print(REVOKE_HELP.format(host=host, when=when or "the day you made it"))
    print(f"Kept: this machine driving {host} (direction 1). To drop that too: orca-ide environment rm --environment "
          f"{place.env}; systemctl --user disable --now orca-tunnel-{place.env}.service")
    return 0 if ok else 1


def listens_beyond_loopback(port: int) -> bool:
    """Whether a TCP listener on this port has an address other than 127.0.0.0/8 or ::1 (from /proc/net/tcp*)."""
    for f, loop in (("/proc/net/tcp", lambda a: a[6:8] == "7F"),  # little-endian IPv4: 127.x.x.x ends in 7F
                    ("/proc/net/tcp6", lambda a: a == "0" * 24 + "01000000" or a.startswith("0" * 16 + "FFFF0000")
                     and a[30:32] == "7F")):
        try:
            rows = Path(f).read_text().splitlines()[1:]
        except OSError:
            continue
        for row in rows:
            cols = row.split()
            if len(cols) < 4 or cols[3] != "0A":  # 0A = LISTEN
                continue
            addr, _, p = cols[1].partition(":")
            if int(p, 16) == port and not loop(addr.upper()):
                return True
    return False


LAUNCHER_CLI = 'CLI="$RESOURCES_DIR/app.asar.unpacked/out/cli/index.js"'  # Orca's packaged resources/bin/orca-ide
LAUNCHER_EXEC = 'ELECTRON_RUN_AS_NODE=1 exec "$ELECTRON" "$CLI" "$@"'


def cli_parts(cli: str, depth: int = 0, handoff: bool = True) -> tuple:
    """(program, cli.js, ORCA_USER_DATA_PATH or None, extra environment) to run Orca's CLI with a preload, from the
    launcher `cli` names, without running it. Three shapes: the one Orca writes on a host (~/.orca/cli/bin/orca:
    `exec '<node>' '<cli.js>' "$@"`), the desktop's shim (~/.config/orca/linux-orca-cli-shim/orca: `exec '<launcher>'
    "$@"`) and the packaged launcher (resources/bin/orca-ide: Electron as node on resources/app.asar.unpacked/out/cli/
    index.js, after handing off once to ORCA_CLI_COMMAND as it does itself). Anything else is refused."""
    no = Fail(f"{cli} is not an Orca CLI launcher setup knows, so the pairing code cannot reach it by stdin; nothing "
              "was saved")
    if depth > 4:
        raise no
    try:
        text = Path(cli).read_text()[:65536]
    except (OSError, UnicodeDecodeError):
        raise no from None
    m = re.search(r"""^exec '([^']+)' '([^']+)' "\$@"\s*$""", text, re.M)
    if m:
        u = re.search(r"^export ORCA_USER_DATA_PATH='([^']*)'\s*$", text, re.M)
        return m.group(1), m.group(2), u.group(1) if u else None, {}
    m = re.search(r"""^exec '([^']+)' "\$@"\s*$""", text, re.M)
    if m:
        return cli_parts(m.group(1), depth + 1, handoff)
    if LAUNCHER_CLI not in text or LAUNCHER_EXEC not in text:
        raise no
    real = Path(cli).resolve()
    session = os.environ.get("ORCA_CLI_COMMAND") or ""
    if (handoff and "ORCA_CLI_COMMAND" in text and os.path.isabs(session) and os.path.isfile(session)
            and os.access(session, os.X_OK) and Path(session).resolve() != real):
        return cli_parts(session, depth + 1, handoff=False)
    resources = real.parent.parent
    exe = next((resources.parent / n for n in ("orca-ide", "orca", "Orca")
                if (resources.parent / n).is_file() and os.access(resources.parent / n, os.X_OK)), None)
    js = resources / "app.asar.unpacked" / "out" / "cli" / "index.js"
    if exe is None or not js.is_file():
        raise no
    # as the launcher sets them: Node's own options moved aside (here: empty, since setup drops NODE_OPTIONS)
    return str(exe), str(js), None, {"ELECTRON_RUN_AS_NODE": "1", "ORCA_NODE_OPTIONS": "",
                                     "ORCA_NODE_REPL_EXTERNAL_MODULE": ""}


SECRETISH = re.compile(r"orca://\S*|[A-Za-z0-9+/_=-]{24,}")


def redact(text: str) -> str:
    """An Orca message with anything that could be a link, code or token in it replaced by <...>."""
    return SECRETISH.sub("<...>", str(text or ""))


def box_pairing(args: list) -> int:
    """On the box (from this machine's --host run): status|add|rm of the environment that is the desktop. add reads
    the pairing code on stdin and hands it to Orca's CLI the same way, so it is never on a command line."""
    if len(args) != 2 or args[0] not in ("status", "add", "rm", "port", "exposed") or not ENV_NAME.fullmatch(args[1]) or (
            args[0] in ("port", "exposed") and not (args[1].isdigit() and 1 <= int(args[1]) <= 65535)):
        print("project-setup: --box-pairing status|add|rm <environment name> | port|exposed <port>", file=sys.stderr)
        return 2
    op, name = args
    if op == "port":  # free, or busy (something listens on 127.0.0.1:<port> here)
        import socket
        with socket.socket() as s:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)  # a closed listener's TIME_WAIT is free
            try:
                s.bind(("127.0.0.1", int(name)))
                print("free")
            except OSError:
                print("busy")
        return 0
    if op == "exposed":  # yes when something listens on <port> on an address other than loopback (Linux /proc)
        print("yes" if listens_beyond_loopback(int(name)) else "no")
        return 0
    code = None
    if op == "add":  # read the code once, give it to node alone; every other child gets an empty stdin
        code = sys.stdin.read()
        fd = os.open(os.devnull, os.O_RDONLY)
        os.dup2(fd, 0)
        os.close(fd)
    global ORCA
    add_orca_cli_to_path()
    ORCA = orca_cli()
    try:
        envs = [e.get("name") for e in LOCAL.jrun("environment", "list")["result"]["environments"]]
        desktop = Place()
        desktop.env = name  # the desktop, as this box reaches it
        if op == "status":
            print("missing" if name not in envs else "reachable" if desktop.reachable() else "saved")
            return 0
        if op == "rm":
            if name in envs:
                LOCAL.jrun("environment", "rm", "--environment", name)
            for f in (config_home() / "lane-control" / "projects").glob("*/settings.json"):
                try:
                    st = json.loads(f.read_text())
                except (OSError, ValueError):
                    continue
                if isinstance(st, dict) and st.get("paired_environment") == name:
                    st.pop("paired_environment")
                    write_atomic(f, json.dumps(st, indent=2).encode() + b"\n", 0o600)
            print("removed" if name in envs else "missing")
            return 0
        if name in envs:
            LOCAL.jrun("environment", "rm", "--environment", name)
        node, js, data, extra = cli_parts(shutil.which(LOCAL.argv()[0]) or LOCAL.argv()[0])
        env = {k: v for k, v in os.environ.items() if k not in ("NODE_OPTIONS", "NODE_REPL_EXTERNAL_MODULE",
                                                                  "ELECTRON_RUN_AS_NODE")}
        env.update(extra)
        if data:
            env["ORCA_USER_DATA_PATH"] = data
        try:
            r = subprocess.run([node, "--require", str(PRELOAD), js, "environment", "add", "--name", name,
                                "--pairing-code", "-", "--json"], input=code, capture_output=True, text=True, env=env,
                               timeout=120)
        finally:
            code = None  # noqa: F841
        try:
            res = json.loads(r.stdout)
        except ValueError:
            res = {}
        if r.returncode != 0 or not res.get("ok"):
            err = res.get("error") or {}
            why = redact(err.get("message")) or f"exit {r.returncode}"
            raise Fail(f"environment add {name}: {err.get('code') or 'failed'}: {why}")
        print("paired")
        return 0
    except Fail as e:
        print(f"project-setup: {e}", file=sys.stderr)
        return 1


def main(argv=None) -> int:
    """_main, with every git command made safe (guard_git) and a refused onboarding write stopping it all: no handler
    on the way takes it for an ordinary failed run (Refusal is not a Fail)."""
    guard_git()
    REFUSED.clear()
    try:
        return _main(argv)
    except Refusal as e:
        print(f"project-setup: {e}", file=sys.stderr)
        return 1
    finally:  # in this process only for this run (tests call main() many times)
        subprocess.Popen = subprocess._lane_real_popen


def _main(argv=None) -> int:
    ap = argparse.ArgumentParser(allow_abbrev=False, prog="project-setup", description=__doc__.split("\n\n")[0])
    ap.add_argument("target", nargs="?")
    ap.add_argument("host_pos", nargs="?", metavar="host",
                    help="an SSH host (as ssh names it): set the project up there, driven from this machine's Orca")
    ap.add_argument("--orchestrator", choices=ORCHESTRATORS,
                    help="native-orca (the default for a new project) or orca-cotal; a project keeps the one it was "
                         "set up with unless this names another")
    ap.add_argument("--host", help="the same as the host after the repo")
    ap.add_argument("--via-host", action="store_true", help=argparse.SUPPRESS)  # added by --host for the host's copy
    ap.add_argument("--which-orchestrator", action="store_true", help=argparse.SUPPRESS)  # the host's copy answers
    ap.add_argument("--desktop-environment", help=argparse.SUPPRESS)  # the host's copy records it (direction 2)
    ap.add_argument("--remove-host", metavar="HOST",
                    help="the host forgets this machine's Orca (direction 2), its tunnel stops, and you are told where "
                         "to revoke the share link; nothing else is changed")
    ap.add_argument("--check", action="store_true",
                    help="with a host: list every prerequisite of project-setup <repo> <host> (ssh, Orca on both "
                         "sides and their versions, pairing both ways, the tunnel, the agent and gateway key on the "
                         "host) and change nothing; exit 1 when one is missing")
    ap.add_argument("--no-desktop-lanes", action="store_true",
                    help="with a host: do not pair the host with this desktop's Orca (no lanes from the host here)")
    ap.add_argument("--pair-by-hand", action="store_true",
                    help="with a host: ask for the share link you make in Orca here (Settings > Servers > \"Share this "
                         "computer\", 127.0.0.1) instead of making the link with orca pair, which makes this desktop's "
                         "Orca listen on every interface; the hand link keeps it on loopback")
    ap.add_argument("--no-machine-setup", action="store_true", help="with a host: do not run machine-setup there")
    ap.add_argument("--no-model-check", action="store_true",
                    help="write a model even when the gateway does not list it (core/modelenv.py)")
    ap.add_argument("--orca-from", metavar="DIR",
                    help="with a host: install Orca's server there from this slot folder or folder of slots instead of "
                         "this desktop's own (orca-host-install --from); pins a box to a known-good server")
    ap.add_argument("--orca-bundle", metavar="TAR",
                    help="with a host: the same from a tar (orca-host-install --bundle)")
    ap.add_argument("--orca-version", metavar="V",
                    help="with a host: install exactly this server version (a slot's name or the Orca app version it records, "
                         "such as 1.4.251), or fail (orca-host-install --version)")
    ap.add_argument("--tunnel-auth-sock", metavar="PATH",
                    help="with a host: the ssh agent socket the tunnel to it uses (lane-tunnel start --auth-sock), for "
                         "a host that takes only a smartcard: unlock the card in that agent first")
    ap.add_argument("--tunnel-ssh", metavar="PATH",
                    help="with a host: an executable the tunnel runs in place of ssh (lane-tunnel start --ssh)")
    ap.add_argument("--tunnel-no-enable", action="store_true",
                    help="with a host: start the tunnel without enabling it, so it does not come back at login "
                         "(lane-tunnel start --no-enable)")
    ap.add_argument("--tunnel-remote-port", type=int, metavar="N",
                    help="with a host: the port on the host its end of the tunnel opens and its Orca dials (default: "
                         "the share link's port); the link is rewritten for it before it is sent "
                         "(lane-tunnel start --remote-port)")
    ap.add_argument("--orca-port", type=int, metavar="N",
                    help="with a host: the port of Orca's server there and its tunnel here (default: the first free "
                         "one from 6769)")
    ap.add_argument("--name")
    ap.add_argument("--dest", default=str(Path.home() / "code"))
    ap.add_argument("--coordinator", help="harness/model (default claude/opus); kept in the project's settings store")
    ap.add_argument("--design-lead", help="refused: the design lead is retired (the design kit replaces it)")
    ap.add_argument("--trust-folder", action="store_true",
                    help="answer Claude Code's 'Do you trust this folder?' with yes for the repo, without asking "
                         "(for unattended runs)")
    ap.add_argument("--no-design-lead", action="store_true",
                    help="accepted and does nothing: the design lead is retired, so no project has one")
    ap.add_argument("--write-orca-yaml", action="store_true",
                    help="when orca.yaml is not committed, leave the drafted setup script as orca.yaml in the repo (uncommitted) "
                         "instead of .cotal/orca.yaml.proposed; never commits by itself")
    ap.add_argument("--reviewer",
                    help="default harness/model of the reviewer persona (default claude/opus); leads pick one per lane "
                         "from the tiers")
    ap.add_argument("--permission-mode", help="Claude permission mode (default auto); native-orca also takes "
                                              "acceptEdits, plan and dontAsk for Claude roles (plan leaves an "
                                              "unattended coordinator unable to act)")
    ap.add_argument("--port", type=int)
    ap.add_argument("--tiers", help="a full tier table to use as it is")
    ap.add_argument("--suggest-tiers", metavar="PROVIDER",
                    help="suggest the project's tier table from a gateway's model list, rows opencode/PROVIDER/<alias> "
                         "(PROVIDER: the gateway's provider id in OpenCode's config); writes it only on the owner's yes")
    ap.add_argument("--gateway-url", metavar="URL",
                    help="the self-hosted gateway: the one an OpenCode --adapter or --adapt-reviewer reaches (a "
                         "complete http(s) URL written out, e.g. http://127.0.0.1:4000/v1; its model is the <model> of "
                         "opencode/<provider>/<model>; kept per project, required for an OpenCode onboarding agent), "
                         "and the one --suggest-tiers reads (default: the project's stored gateway, else PROVIDER's "
                         "baseURL in OpenCode's config)")
    ap.add_argument("--gateway", dest="gateway_url", help=argparse.SUPPRESS)  # the old --suggest-tiers name
    ap.add_argument("--gateway-key-env", metavar="NAME",
                    help="the environment variable that holds the gateway key, for the gateway --gateway-url gives "
                         "(kept per project with it; '' for none; a new --gateway-url does not take a stored one along "
                         "unless you say yes); the key itself is never an argument")
    ap.add_argument("--trust-gateway", action="store_true",
                    help="run the OpenCode onboarding agents in the repo itself, with no filtered copy: the model sees "
                         "every file in the folder, ignored and private ones included. For a model on a gateway you "
                         "run; asks once in a terminal (without one, the flag is the yes). Writes stay limited to the "
                         "adapter's own files. Not kept")
    ap.add_argument("--beads-repo", metavar="OWNER/NAME",
                    help="the private GitHub repo that holds this project's beads (default: the project's origin owner "
                         "and `<repo name>-beads`). Kept in the settings store")
    ap.add_argument("--no-start", action="store_true")
    ap.add_argument("--with", action="append", default=[], dest="with_repos", metavar="DIR|GIT-URL",
                    help="attach a second repo to the project (repeatable): lanes from this project's coordinator, no "
                         "space, manager or coordinator of its own. Kept in the settings store; later runs cover it")
    ap.add_argument("--private", action="append", default=[], metavar="GLOB",
                    help="a tracked file or folder the onboarding agents must not read, relative to the repo root "
                         "(repeatable, e.g. 'shot*.png' or 'private/**'; applies to every repo of the project, attached ones too); git-ignored paths are always denied. Kept in "
                         "the settings store: a later run adds to the list, it never drops one")
    ap.add_argument("--adapter",
                    help="harness/model of the agent that adapts the project's files (claude/<model> or "
                         "opencode/<provider>/<model>; default claude/sonnet); kept in the project's settings store")
    ap.add_argument("--adapt-reviewer",
                    help="harness/model that reviews the adapted files; must be a different model from --adapter "
                         "(default claude/opus); kept in the project's settings store")
    again = ap.add_mutually_exclusive_group()
    again.add_argument("--readapt", action="store_true", help="adapt the project again although it was done before")
    again.add_argument("--refresh", action="store_true",
                       help="onboarded project: re-render the personas in .cotal/, reinstall the skill, say which "
                            "running agents need a restart; keeps the project's tier table, starts and commits nothing")
    again.add_argument("--show", action="store_true",
                       help="print the project's settings store (settings.json, lanes.tsv) and stop; "
                            "writes nothing")
    again.add_argument("--skip-adapt", action="store_true",
                       help="only the Orca setup: no adapting agent, no commit. The route for a new project on a "
                            "machine with no usable model yet: adapt it later with --readapt")
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["--box-pairing"]:  # on a box, from this machine's host run (direction 2)
        return box_pairing(argv[1:])
    a = ap.parse_args(argv)
    global TRUST_GATEWAY
    TRUST_GATEWAY = a.trust_gateway
    TRUSTED.clear()
    where = None
    if a.target and not (a.host or a.host_pos):  # the folder the run's git commands go to: checked before the first
        url = re.match(r"^(https?|ssh|git|file)://|^[\w.-]+@[\w.-]+:", a.target)
        where = (Path(a.dest).expanduser() / slug(a.name or re.sub(r"\.git$", "", a.target.rstrip("/").rsplit("/", 1)[-1]
                                                                     .rsplit(":", 1)[-1])) if url else Path(a.target))
    why = refusal_gate(where) if where is not None else None  # a refused --trust-gateway write (B3)
    if why:
        print(f"project-setup: {why}", file=sys.stderr)
        return 1
    value_flags = {s for act in ap._actions if act.option_strings and act.nargs is None for s in act.option_strings}

    if os.geteuid() == 0:
        print("project-setup: refusing to run as root; agents run as a normal user", file=sys.stderr)
        return 2
    for h in (a.host, a.host_pos, a.remove_host):
        why = host_refusal(h) if h is not None else None
        if why:
            print(f"project-setup: {why}", file=sys.stderr)
            return 2
    if a.check:  # --check changes nothing: never together with a flag that acts (some run before the check would)
        given = [f for f in CHECK_REFUSES if any(x == f or x.startswith(f + "=") for x in argv)]
        if given:
            print(f"project-setup: --check changes nothing, so it does not go with {' '.join(given)}", file=sys.stderr)
            return 2
    if a.via_host:  # a non-interactive ssh shell's PATH lacks the folders agents are often installed in; they go
        home = Path(os.environ.get("HOME", str(Path.home())))  # last, so nothing there shadows git or python3
        for d in (home / "bin", home / ".local" / "bin"):
            if d.is_dir() and str(d) not in os.environ.get("PATH", "").split(":"):
                os.environ["PATH"] = f"{os.environ.get('PATH', '')}:{d}"
    if a.remove_host:
        if a.target or a.host or a.host_pos:
            print("project-setup: --remove-host takes the host alone: project-setup --remove-host <host>", file=sys.stderr)
            return 2
        return remove_host(a.remove_host)
    if not a.target:
        ap.print_usage(sys.stderr)
        print("project-setup: a repo (git URL or folder) is required", file=sys.stderr)
        return 2
    if a.host and a.host_pos and a.host != a.host_pos:
        print(f"project-setup: two hosts given ({a.host_pos} and --host {a.host}); give one", file=sys.stderr)
        return 2
    host = a.host or a.host_pos
    why = (gateway_url_refusal(a.gateway_url) if a.gateway_url is not None else None) \
        or gateway_key_refusal(a.gateway_key_env)
    if why:
        print(f"project-setup: {why}", file=sys.stderr)
        return 2
    if a.trust_gateway and (a.skip_adapt or a.refresh or a.show or a.suggest_tiers is not None):
        print("project-setup: --trust-gateway is for the OpenCode onboarding agents, and no onboarding agent runs with "
              + ("--skip-adapt" if a.skip_adapt else "--refresh" if a.refresh else "--show" if a.show
                 else "--suggest-tiers"), file=sys.stderr)
        return 2
    if a.suggest_tiers is not None:
        if host:
            print("project-setup: --suggest-tiers runs where the project is: run it on the host", file=sys.stderr)
            return 2
        return suggest_tiers(a)
    if a.orca_from and a.orca_bundle:
        print("project-setup: --orca-from and --orca-bundle exclude each other: give one source", file=sys.stderr)
        return 2
    if a.tunnel_remote_port is not None and not 1024 <= a.tunnel_remote_port <= 65535:
        # ssh -R as a normal user (setup never runs as root there) cannot open a port below 1024 on the box
        print(f"project-setup: --tunnel-remote-port takes a port from 1024 to 65535 (a normal user's ssh -R cannot "
              f"open a lower one on the box), got {a.tunnel_remote_port}", file=sys.stderr)
        return 2
    if a.tunnel_auth_sock or a.tunnel_ssh:  # lane-tunnel's own rules, before anything runs on the host
        c = subprocess.run([tool_path("LANE_TUNNEL", "core/scripts/lane-tunnel"), "check", *tunnel_options(a)],
                           capture_output=True, text=True)
        if c.returncode != 0:
            why = (c.stderr.strip().splitlines() or ["lane-tunnel check failed"])[-1].replace("lane-tunnel: ", "")
            print("project-setup: " + why.replace("--auth-sock", "--tunnel-auth-sock").replace("--ssh", "--tunnel-ssh"),
                  file=sys.stderr)
            return 2
    if a.desktop_environment is not None and not ENV_NAME.fullmatch(a.desktop_environment):
        print("project-setup: --desktop-environment takes an environment name", file=sys.stderr)
        return 2
    global ORCHESTRATOR
    base = a.name or re.sub(r"\.git$", "", a.target.rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1])
    if host:  # the target is on the host: without a flag its own copy decides there, from its store and .cotal/
        ORCHESTRATOR = a.orchestrator or DEFAULT_ORCHESTRATOR
    else:
        try:
            peek = peek_repo(a.target, Path(a.dest).expanduser(), slug(base))
        except Fail:
            peek = None  # no usable git here: the run below says so
        # A project the store or a .cotal/ folder puts on a path keeps it, here or copied over by --host.
        ORCHESTRATOR = which_orchestrator(a.orchestrator, peek)
    if a.which_orchestrator:
        print(ORCHESTRATOR)
        return 0
    modes = NATIVE_MODES if ORCHESTRATOR == "native-orca" else MODES
    if a.permission_mode is not None and a.permission_mode not in modes:
        print(f"project-setup: --permission-mode must be one of {', '.join(modes)}", file=sys.stderr)
        return 2
    if a.design_lead:
        print(f"project-setup: --design-lead: {RETIRED}. Nothing was changed", file=sys.stderr)
        return 2
    for v in (a.coordinator, a.reviewer):  # any harness/model the owner gives; only the shape is checked
        if v:
            harness_model(v)
    for v in (a.adapter, a.adapt_reviewer):
        if v:
            harness_model(v)
    for g in a.private:
        if bad_glob(g):
            print(f"project-setup: --private takes {GLOB_RULE}, got {g!r}", file=sys.stderr)
            return 2
    if not a.skip_adapt and not a.refresh and a.adapter and a.adapt_reviewer \
            and harness_model(a.adapter)[1] == harness_model(a.adapt_reviewer)[1]:
        print(f"project-setup: --adapter and --adapt-reviewer must be different models, both are "
              f"{harness_model(a.adapter)[1]}", file=sys.stderr)
        return 2
    tiers = Path(a.tiers or OC / "templates" / "lanes.tsv").expanduser()
    if a.with_repos and (a.refresh or a.show):
        print("project-setup: --with attaches a repo and cannot go with --refresh or --show (they cover the repos "
              "already attached; run without them to attach another)", file=sys.stderr)
        return 2
    if a.refresh:
        ignored = [f for f in ("--coordinator", "--permission-mode")
                   if any(x == f or x.startswith(f + "=") for x in argv)]
        if ignored:
            print(f"project-setup: {' '.join(ignored)} has no effect with --refresh: each persona keeps what it "
                  "has (only --reviewer is used, for a reviewer persona that is missing)", file=sys.stderr)
            return 2
    if a.check:
        return check_host(a, host) if host else check_local(a)
    if not a.show:  # before the host copy and before anything is rendered; --show sends and switches nothing
        try:
            use_install("core/scripts/project-setup", argv)
        except Fail as e:
            print(f"project-setup: {e}", file=sys.stderr)
            return 1
    if host:
        if a.orchestrator == "orca-cotal":
            return on_host(host, argv, a.target, value_flags)
        return native_on_host(a, argv, host, value_flags)
    if not tiers.is_file():
        print(f"project-setup: tier table {tiers} not found", file=sys.stderr)
        return 2
    global ORCA
    if ORCHESTRATOR == "native-orca":
        return native_main(a, tiers)
    if a.show:
        try:
            d = Path(a.target).expanduser().resolve()
            top = run(["git", "rev-parse", "--show-toplevel"], cwd=d, check=False) if d.is_dir() else None
            if top is None or top.returncode != 0:
                raise Fail(f"{d} is not an existing git repository; --show only works on a set-up project")
            root = attached_to(Path(top.stdout.strip()))
            if root is not None:
                raise Fail(f"{top.stdout.strip()} is attached to the project at {root}, not a project of its own: "
                           f"run --show on {root}")
            return show(Path(top.stdout.strip()))
        except Fail as e:
            print(f"project-setup: {e}", file=sys.stderr)
            return 1
    if a.refresh:
        add_orca_cli_to_path()
        ORCA = orca_cli()
        try:
            host_hygiene()
            d = Path(a.target).expanduser().resolve()
            top = run(["git", "rev-parse", "--show-toplevel"], cwd=d, check=False) if d.is_dir() else None
            if top is None or top.returncode != 0:
                raise Fail(f"{d} is not an existing git repository; --refresh only works on a set-up project")
            say("repo", "exists", top.stdout.strip())
            repo = Path(top.stdout.strip())
            root = attached_to(repo)
            if root is not None:
                raise Fail(f"{repo} is attached to the project at {root}, not a project of its own: run --refresh on {root}")
            why = stale_checkout(repo, quick=True)
            if why:  # a refresh works on any checkout, but says so
                print(f"project-setup: warning: {why}", file=sys.stderr)
            migrate(repo)
            st = settings(repo)
            validate_settings(repo, st)
            stored_reviewer = (st.get("models") or {}).get("reviewer") if isinstance(st.get("models"), dict) else None
            rc = refresh(repo, a.name or "", st.get("permission_mode") or "auto", tiers,
                           harness_model(a.reviewer or stored_reviewer or DEFAULT_PINS["reviewer"]))
            for d in attached_of(st):  # the attached repos: looked at, never changed
                dp = Path(d)
                if not dp.is_dir():
                    print(f"project-setup: warning: attached repo {d} is not there any more", file=sys.stderr)
                    continue
                why = stale_checkout(dp, quick=True)
                say("attached", "exists", f"{d}" + (" (adapted)" if onboarded(dp) else " (not adapted: run project-setup without --refresh)"))
                if why:
                    print(f"project-setup: warning: attached repo {d}: {why}", file=sys.stderr)
            if rc == 0 and a.name:  # only once refresh has accepted the project
                settings(repo, name=a.name)
            return rc
        except Fail as e:
            print(f"project-setup: {e}", file=sys.stderr)
            return 1
    add_orca_cli_to_path()
    ORCA = orca_cli()
    # Cotal's Orca driver otherwise tries `orca-ide`, then whatever `orca` is on PATH.
    os.environ.setdefault("COTAL_ORCA_BIN", ORCA)
    base = a.name or re.sub(r"\.git$", "", a.target.rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1])
    try:
        preflight(set())  # the agents' harnesses are checked once the project's settings are known
        host_hygiene()
        repo = resolve_repo(a.target, Path(a.dest).expanduser(), slug(base))
        why = stale_checkout(repo, quick=a.skip_adapt)
        if why and a.skip_adapt:  # works on any checkout (project-pause start), but says so
            print(f"project-setup: warning: {why}", file=sys.stderr)
        elif why:  # anything that may commit does not
            raise Fail(f"{why}. Nothing was changed")
        beads_report(repo, a.beads_repo)
        migrate(repo)
        validate_settings(repo, settings(repo))
        drop_design_lead_settings(repo)
        root = attached_to(repo)
        if root is not None:  # before a project of its own is made out of it
            raise Fail(f"{repo} is attached to the project at {root}, so it is not a project of its own: it gets its "
                       "lanes from that project's coordinator. Nothing was changed")
        stored_attached = attached_of(settings(repo))
        attached = prepare_attached(repo, stored_attached, a.with_repos, Path(a.dest).expanduser(), a.skip_adapt)
        cfg = resolve_settings(repo, a)
        if attached:
            # a stored repo that is gone stays listed: only the owner takes it out
            settings(repo, attached=list(dict.fromkeys([*stored_attached, *(str(d) for d in attached)])))
        coord, reviewer = cfg["pins"]["coordinator"], cfg["pins"]["reviewer"]
        adapter, adapt_reviewer = cfg["onboarding"]["adapter"], cfg["onboarding"]["adapt-reviewer"]
        PRIVATE_GLOBS[:] = cfg["private"]
        mode = cfg["mode"]
        modes = {r: cfg["modes"].get(r, mode) for r in ("coordinator", "reviewer")}
        late = {coord[0]}
        for h in sorted(late):
            if not shutil.which(h):
                raise Fail(f"{h} not on PATH, but this project launches {h} agents")
        needed = late
        tier_text = choose_tiers(repo, a, tiers)
        tier_harnesses = {h for _, h, _ in check_tier_table(tier_text)} & set(HARNESSES)
        tier_harnesses.add(reviewer[0])  # started per lane, like a tier's harness
        missing_tier = sorted(h for h in tier_harnesses if not shutil.which(h))
        if missing_tier:
            print(f"project-setup: note: tier harness not on PATH: {' '.join(missing_tier)}", file=sys.stderr)
        # An agent tab can't answer Claude's first-start trust prompt, and the launch times out on it. Trusting the
        # folder is the owner's call, so it is never written for them.
        if "claude" in needed and not a.no_start:
            ensure_claude_trust(repo, record=a.trust_folder)
        project = cfg["name"] or repo.name
        if a.skip_adapt:
            skipped_adapt(repo)
        if not a.skip_adapt and not onboard(repo, project, adapter, adapt_reviewer, a.readapt):
            return STOPPED
        if not a.skip_adapt:  # also on a re-run: a declined or failed push is offered again
            publish_onboarding(repo)
        for d in attached:  # the same per-repo work; no space, personas or agents of their own
            if not a.skip_adapt:
                if not onboard_attached(d, project, adapter, adapt_reviewer, a.readapt):
                    return STOPPED
                publish_onboarding(d)
        space = slug(project)
        repo_id = orca_repo(repo)
        for d in attached:
            orca_repo(d)
            setup_script(d, a.write_orca_yaml)
        skill = skills()
        cotal_space(repo, space)
        if "claude" in needed | tier_harnesses:
            claude_wiring(repo, space)
        changed = personas_and_tiers(repo, project, coord, reviewer, modes, tier_text, tuple(str(d) for d in attached))
        retire_design_lead(repo, project, None)
        needs = {n: "persona changed" for n in changed}
        if skill == "updated":
            needs.setdefault("coordinator", "skill changed")
        setup_script(repo, a.write_orca_yaml)
        if a.no_start:
            if needs:
                restart_notice(repo, project, needs)
            say("start", "skipped", "--no-start")
            return 0
        start_stack(repo, space, a.port)
        if needs:  # before the spawns below, so only agents that were already running are named
            restart_notice(repo, project, needs)
        global LEFTOVER_DELIVERED
        LEFTOVER_DELIVERED = spawn(repo, space, "coordinator", *coord, modes["coordinator"], repo, coordinator_kickoff())
        if LEFTOVER_DELIVERED:  # a coordinator that was just started is awake: the guard sends it orders again
            guard_marker(space).unlink(missing_ok=True)
        verify(repo, space)
        print(f"summary: {project} · space {space} · broker 127.0.0.1:{settings(repo).get('port')} · orca repo {repo_id}")
        print(f"  open Orca: the project {repo.name}, its main checkout (coordinator)")
        return 0
    except Fail as e:
        print(f"project-setup: {e}", file=sys.stderr)
        return 1
    finally:
        if LEFTOVER and not LEFTOVER_DELIVERED:  # the file is gone: nothing the owner left open may vanish silently
            print("\nLeft open at the commit and not given to a coordinator in this run (it was not started now). "
                  "Bring it to the coordinator yourself:\n" + plain(LEFTOVER), file=sys.stderr)
        if agent_spent:
            print(f"agent time used: {minutes(agent_spent)} of {minutes(AGENT_LIMIT)}")


if __name__ == "__main__":
    sys.exit(main())
