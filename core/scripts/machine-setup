#!/usr/bin/env python3
"""machine-setup: set a machine up once for native Orca (spec sections 8 and 11): the machine coordinator, the night
manager, lane sweep and machine check automations, the presence-based CI limits and the usage feed check.

  machine-setup [--host H] [--folder DIR] [--machine-coordinator HARNESS/MODEL] [--permission-mode MODE]
                [--automation-provider claude|opencode] [--trust-folder] [--no-start]
  machine-setup --check [--folder DIR]

Runs as a normal user on the machine whose coordinators it watches; with --host it copies what it needs to H over
SSH (~/.local/share/lane-control, as project-setup does) and runs there with the same arguments, so a box gets its own
machine coordinator, night manager and sweep. Every step is skipped when already done and says `exists`; nothing is
started twice. An existing machine.conf is never changed; an automation of ours is changed only to repair its
precheck and prompt, and never from a lane worktree.

1. ~/.config/lane-control/machine.conf (LANE_MACHINE_CONF) from core/templates/machine.conf.example, mode 0600, if
   missing: fill in COORDINATORS and RUNNER_REPOS by hand.
2. The usage feed (~/.claude/usage-history.jsonl, written by Claude's status line) must exist and be written in the
   last hour; if not it says so and how to turn it on, and budget steps are unknown until it is.
3. The machine coordinator's private folder (--folder, default ~/machine-coordinator; never push it to a public
   remote) with notes.md, added to Orca as a folder project. Its persona (orchestrators/native-orca/personas/) is
   rendered to <folder>/.lane-control/machine-coordinator.md, with <folder>/.lane-control/additions/
   machine-coordinator.md appended when that exists; the harness's persona hook is installed. <folder>/CLAUDE.md
   gets a persona anchor (core/anchor.py): a few lines that tell a session the owner started by hand there to read
   the persona, and an automation's or worker's session to ignore them. The rest of that file is kept.
4. Unless --no-start, the machine coordinator starts in an Orca terminal titled `machine coordinator` (skipped when a
   terminal with that title exists): `env LANE_ROLE=machine-coordinator LANE_PERSONA=... claude --model sonnet
   --permission-mode auto --name "machine coordinator"` (default claude/sonnet; Claude's --name keeps the session
   and terminal title, so peers find it by SendMessage). Claude's first-start folder question: --trust-folder answers
   yes; otherwise it is asked in a terminal, as project-setup does.
5. Orca automations in that folder (fresh sessions, each precheck runs first and costs nothing; Claude Sonnet, or on a
   machine without Claude --automation-provider opencode, the default when the machine coordinator runs on OpenCode:
   OpenCode v2 on OpenCode's own default model, since Orca takes no model or other extra arguments for it):
   `night manager` hourly at :37 (night-precheck), `lane sweep` every 3 hours (lane-sweep --precheck: new findings
   only, report only) and `machine check` every 30 minutes (machine-check: budget step, memory or runner state
   changed). The machine check's session passes the change on to the machine coordinator, since an automation
   cannot wake a session it did not start. An automation of ours whose precheck or prompt points elsewhere (a moved
   checkout) is repaired in place. One an earlier hand-made setup made (`night-manager`, `lane-sweep`) is reported
   with the command to remove it, and no second one is added.
6. Workspace cleanup, report only: whether Orca's cleanup rules would remove a merged lane's worktree (`orca-ide
   workspace cleanup preview`, which removes nothing). When no rule is on, or a project has cleanup off, it says
   where in Orca's Settings to turn on "Delete merged workspaces". It also reports the recommended "Delete released
   orchestration worker workspaces" (`off`, `exists`, or `check`: the preview cannot always tell). Orca's settings are
   never edited, and an Orca without the command is skipped.
7. The ci-presence user timer (every 15 minutes and at boot), if systemd --user works; otherwise a warning and the
   CI limits stay the slice unit's own. An older timer that sets the CI slice (ci-cpu) is reported with the command
   to stop it, and ci-presence is not installed beside it.
--check only reads: whether --folder has the rendered persona and the anchor as setup writes it (exit 1 if not).
Exit: 0 done (warnings included); 1 a step failed, or --check found something; 2 usage or an unknown harness.
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent.parent
sys.path.insert(0, str(ROOT / "core"))
import harnesses  # noqa: E402
import machineconf  # noqa: E402
import anchor  # noqa: E402
import beads  # noqa: E402
import cleanup  # noqa: E402
import install  # noqa: E402

ROLE = "machine-coordinator"
TITLE = "machine coordinator"
PERSONA = ROOT / "orchestrators" / "native-orca" / "personas" / f"{ROLE}.md"
LC = ROOT  # the path the persona, automations and timer name: .../lane-control/current once main() installed it


def ask(question: str):
    """The owner's yes in a terminal (install.use asks before it moves the machine's lane-control), else None."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return None
    try:
        return input(question).strip().lower() in ("y", "yes")
    except EOFError:
        return False
NOTES_STUB = ("# Machine coordinator notes\n\n"
              "Private: owner decisions, caps, priorities. Never push this folder to a public remote.\n")
FEED_MAX_AGE_MIN = 60
AUTOMATION_MODEL = "sonnet"
AUTOMATION_PROVIDERS = ("claude", "opencode")  # harness -> the agent id Orca starts: harnesses' ORCA_AGENT_ID


class Fail(Exception):
    pass


def say(step: str, what: str, detail: str = ""):
    print(f"{step}: {what}" + (f" {detail}" if detail else ""), flush=True)


def project_setup():
    """project-setup as a module, for its folder-trust step (one implementation of Claude's trust question)."""
    path = ROOT / "orchestrators" / "orca-cotal" / "scripts" / "project-setup"
    loader = importlib.machinery.SourceFileLoader("project_setup", str(path))
    spec = importlib.util.spec_from_loader("project_setup", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def orca(*args) -> dict:
    cmd = [machineconf.orca_cli(), *args, "--json"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
        data = json.loads(r.stdout or "{}")
    except (OSError, subprocess.TimeoutExpired, ValueError) as e:
        raise Fail(f"orca-ide {' '.join(args[:2])}: {e}") from None
    if r.returncode != 0 or not data.get("ok", False):
        msg = (data.get("error") or {}).get("message") or r.stderr.strip() or f"exit {r.returncode}"
        raise Fail(f"orca-ide {' '.join(args[:2])}: {msg}")
    return data.get("result") or {}


def harness_model(spec: str) -> tuple:
    """claude/<model> or opencode/<provider>/<model>, any provider (owner 2026-11-24: no refusal by model)."""
    harness, _, model = spec.partition("/")
    if harness not in harnesses.harnesses_names() or not model:
        raise SystemExit2(f"--machine-coordinator: expected claude/<model> or opencode/<model>, got {spec!r}")
    return harness, model


class SystemExit2(Exception):
    pass


# --- steps -----------------------------------------------------------------------------------------------------------

def machine_conf():
    p = machineconf.path()
    if p.exists():
        say("machine.conf", "exists", str(p))
    else:
        p.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(machineconf.EXAMPLE.read_text())
        say("machine.conf", "created", f"{p} (fill in COORDINATORS and RUNNER_REPOS)")
    try:
        conf = machineconf.load(p)
        for w in conf["warnings"]:
            say("machine.conf", "warning", w)
        if not machineconf.coordinators(conf):
            say("machine.conf", "warning", f"{p} lists no coordinators yet (still the example?): fill in "
                                           "COORDINATORS, or the night manager has nobody to check in on")
    except machineconf.ConfError as e:
        say("machine.conf", "warning", str(e))


def usage_feed():
    f = Path.home() / ".claude" / "usage-history.jsonl"
    how = ("a metered budget's steps stay unknown, and night check-ins stay off, until it is: Claude Code's status "
           "line must append each sample to it (core/machine.md, \"Usage feeds\"); a machine with no metered budget "
           "needs none (every feed empty in the config, e.g. only a self-hosted gateway: the caps are the limit)")
    try:
        mins = int((time.time() - f.stat().st_mtime) // 60)
    except FileNotFoundError:
        return say("usage feed", "missing", f"{f}: {how}")
    if mins > FEED_MAX_AGE_MIN:
        return say("usage feed", "stale", f"{f} was last written {mins} min ago: {how}")
    say("usage feed", "ok", f"{f} ({mins} min old)")


def bd_version_step():
    """bd on PATH and at the floor. Says how to install; never installs it."""
    floor = ".".join(map(str, beads.BD_FLOOR))
    have = beads.bd_version()
    if have is None:
        return say("bd", "missing", f"(`bd` is not on PATH, or its version could not be read; lane-control needs bd {floor} "
                                    "or newer for issues, handovers and memories. Install it from the beads project's "
                                    "releases or your package manager, then re-run. Nothing was installed)")
    if have < beads.BD_FLOOR:
        return say("bd", "too old", f"(bd {'.'.join(map(str, have))} is older than the {floor} lane-control needs; "
                                    "update it the way you installed it. Nothing was changed)")
    say("bd", "exists", f"({'.'.join(map(str, have))}, floor {floor})")


def cleanup_step():
    """Whether Orca's workspace cleanup has the merged rule, and the recommended released-workers rule, on for lane
    worktrees, machine-wide. Report only: Orca's settings are never changed (core/cleanup.py)."""
    for step, what, detail in cleanup.orca_report(machineconf.orca_cli()):
        say(step, what, detail)


def folder_step(folder: Path):
    folder.mkdir(parents=True, exist_ok=True)
    notes = folder / "notes.md"
    if not notes.exists():
        notes.write_text(NOTES_STUB)
    repos = orca("repo", "list").get("repos", [])
    if any(os.path.realpath(r.get("path", "")) == str(folder) for r in repos):
        return say("orca folder", "exists", str(folder))
    orca("repo", "add", "--path", str(folder), "--kind", "folder")
    say("orca folder", "created", str(folder))


def render(harness: str, model: str, folder: Path) -> str:
    text = (PERSONA.read_text().replace("{{HARNESS}}", harness).replace("{{MODEL}}", model)
            .replace("{{NOTES}}", str(folder / "notes.md")).replace("{{LANE_CONTROL}}", str(LC)))
    left = sorted(set(re.findall(r"\{\{[A-Z_]+\}\}", text)))
    if left:
        raise Fail(f"{PERSONA}: placeholders machine-setup does not fill: {', '.join(left)}")
    add = folder / ".lane-control" / "additions" / f"{ROLE}.md"
    if add.is_file():
        text = text.rstrip("\n") + "\n\n" + add.read_text()
    return text


def persona_step(harness: str, model: str, folder: Path) -> Path:
    dest = folder / ".lane-control" / f"{ROLE}.md"
    text = render(harness, model, folder)
    if dest.is_file() and dest.read_text() == text:
        say("persona", "exists", str(dest))
    else:
        what = "updated" if dest.exists() else "created"
        dest.parent.mkdir(parents=True, exist_ok=True)
        tmp = dest.with_name(dest.name + ".tmp")
        tmp.write_text(text)
        tmp.replace(dest)
        say("persona", what, str(dest))
    changes = harnesses.load_harness(harness).install_persona_hook(folder)
    for c in changes:
        say("persona hook", "created", c)
    if not changes:
        say("persona hook", "exists", harness)
    return dest


def anchor_block(folder: Path) -> str:
    return anchor.machine_block(folder, folder / ".lane-control" / f"{ROLE}.md", TITLE)


def anchor_step(folder: Path):
    """The folder's persona anchor (core/anchor.py): a session started by hand there is told to read the persona."""
    f = folder / anchor.MACHINE_FILE
    try:
        state = anchor.apply(f, anchor_block(folder))
    except (anchor.AnchorError, OSError) as e:
        return say("persona anchor", "skipped", f"({e})")
    say("persona anchor", state, str(f))


def check(folder: Path) -> int:
    """--check: the machine coordinator's persona and its anchor. Reads only. 0 when both are there and as setup
    writes them, 1 otherwise."""
    persona = folder / ".lane-control" / f"{ROLE}.md"
    has = persona.is_file()
    say("check persona", "ok" if has else "missing", f"({persona})" if has else f"(no {persona}: run machine-setup)")
    f = folder / anchor.MACHINE_FILE
    try:
        state, why = anchor.check(f, anchor_block(folder)), ""
    except anchor.AnchorError as e:
        state, why = "stale", str(e)
    say("check persona anchor", state, f"({f})" if state == "ok" else f"({why or f}: run machine-setup)")
    ok = has and state == "ok"
    say("check", "ok" if ok else "missing", "(nothing was changed)")
    return 0 if ok else 1


def start_step(harness: str, model: str, mode: str, folder: Path, persona: Path, trust: bool):
    terms = orca("terminal", "list").get("terminals", []) or []
    if any(t.get("title") == TITLE for t in terms):
        return say(TITLE, "exists", "(a terminal with that title is open; not started again)")
    if harness == "claude":
        ps = project_setup()
        try:
            ps.ensure_claude_trust(folder, record=trust)
        except ps.Fail as e:
            raise Fail(str(e)) from None
    cmd = harnesses.load_harness(harness).start_command(ROLE, persona, model, mode)
    if harness == "claude":
        cmd += ["--name", TITLE]
    orca("terminal", "create", "--worktree", f"path:{folder}", "--title", TITLE, "--command", shlex.join(cmd))
    say(TITLE, "created", f"{harness}/{model} in {folder}")


def automation_specs() -> list:
    s = LC / "core" / "scripts"
    q = shlex.quote
    NIGHT_DOC = LC / "orchestrators" / "native-orca" / "night-manager.md"
    night = (f"You are this machine's night manager. Follow {NIGHT_DOC} exactly; lane-control is {LC}. "
             "Be brief: you spend budget nobody is watching.")
    sweep = (f"Run {q(str(s / 'lane-sweep'))} --changes: the lane findings that are new since the last sweep "
             f"(it removes nothing). Send each line to the coordinator its owner= names, the way the Messages "
             f"section of {NIGHT_DOC} says; a line without an owner goes to the machine coordinator. Then end.")
    check = (f"Run {q(str(s / 'machine-check'))} --last and send its lines, unchanged, to the machine coordinator "
             f"(session `{TITLE}`), the way the Messages section of {NIGHT_DOC} says. Do nothing else. Then end.")
    # Orca's default precheck timeout is 60 s and a timeout skips the run; the sweep asks gh about every lane.
    return [("night manager", "37 * * * *", q(str(s / "night-precheck")), 120, night),
            ("lane sweep", "17 */3 * * *", q(str(s / "lane-sweep")) + " --precheck", 600, sweep),
            ("machine check", "*/30 * * * *", q(str(s / "machine-check")), 120, check)]


# Names an earlier hand-made setup used: found, reported with the commands to switch, never doubled.
OLDER_AUTOMATIONS = {"night manager": ("night-manager",), "lane sweep": ("lane-sweep",),
                     "machine check": ("machine-check",)}
OLDER_CI_TIMERS = ("ci-cpu.timer", "ci-cpu-mode.timer")


def automation_agent(provider: str) -> list:
    """The agent part of `automations create`: Claude with its model, or OpenCode v2 on its own default model (Orca
    1.4.268 allows extra agent args for Claude and not for OpenCode, lc-mrz)."""
    if provider == "claude":
        return ["--provider", "claude", f"--extra-agent-args=--model {AUTOMATION_MODEL}"]
    return ["--provider", harnesses.load_harness(provider).ORCA_AGENT_ID]


def automations_step(folder: Path, from_lane: bool = False, provider: str = "claude") -> int:
    """How many automations it created. The first create that Orca refuses stops the step before a second one: Orca
    checks the provider id before anything is sent, so a wrong id creates nothing (said as failed, the run goes on)."""
    created = 0
    have = {a.get("name"): a for a in orca("automations", "list").get("automations", []) or []}
    for name, trigger, precheck, timeout, prompt in automation_specs():
        if name in have:
            a = have[name]
            pc = a.get("precheck") or {}
            if pc.get("command") == precheck and pc.get("timeoutSeconds") == timeout and a.get("prompt") == prompt:
                say(name, "exists", "(automation)")
                continue
            if from_lane:
                say(name, "left as it is", f"(automation {a['id']} points at {pc.get('command') or 'no precheck'}; "
                                           "this run is from a lane worktree, which would be removed with its lane: "
                                           "run machine-setup from the main checkout to repair it)")
                continue
            orca("automations", "edit", a["id"], "--precheck", precheck, "--precheck-timeout", str(timeout),
                 "--prompt", prompt)
            say(name, "repaired", f"(automation {a['id']}: precheck and prompt now point at {LC}; was "
                                  f"{pc.get('command') or 'no precheck'})")
            continue
        older = [have[o] for o in OLDER_AUTOMATIONS[name] if o in have]
        if older:
            o = older[0]
            say(name, "found older", f"automation {o.get('name')!r} ({o['id']}) does this job; not adding a second. "
                                     f"To switch: orca-ide automations remove {o['id']}  then run machine-setup again")
            continue
        try:
            orca("automations", "create", "--name", name, "--trigger", trigger, "--prompt", prompt,
                 *automation_agent(provider), "--precheck", precheck,
                 "--precheck-timeout", str(timeout),
                 "--workspace", f"path:{folder}", "--workspace-mode", "existing", "--enabled")
        except Fail as e:
            if provider == "claude" or created:
                raise
            agent = automation_agent(provider)[1]
            raise AutomationFail(f"{e} (the agent id {agent} for OpenCode is unverified: it is read from Orca 1.4.268's "
                                 "own code, its agent catalog, not from a live create; no automation was created. "
                                 "Use the id `orca-ide automations create --help` or Orca's docs give for OpenCode v2, "
                                 "or --automation-provider claude)") from None
        created += 1
        say(name, "created", f"(automation, {trigger}, precheck {precheck})")
    return created


class AutomationFail(Exception):
    """The automations could not be made; the steps after them still run, and the run exits 1."""


def systemctl(*args) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        return subprocess.CompletedProcess(args, 1, "", str(e))


def timer_step():
    step = "ci-presence timer"
    if not shutil.which("systemctl") or systemctl("show-environment").returncode != 0:
        return say(step, "skipped", "(warning: no systemd user manager here; the CI slice keeps its unit's own "
                                    "limits, the rest works)")
    for old in OLDER_CI_TIMERS:
        r = systemctl("show", old, "-p", "LoadState", "--value")
        if r.returncode == 0 and r.stdout.strip() not in ("", "not-found"):
            return say(step, "found older", f"{old} also sets the CI slice's limits; two would fight, so ci-presence "
                                            f"is not installed. To switch: systemctl --user disable --now {old}  "
                                            "(and drop it from wherever it is defined), then run machine-setup again")
    v = os.environ.get("XDG_CONFIG_HOME")
    units = (Path(v) if v and os.path.isabs(v) else Path.home() / ".config") / "systemd" / "user"
    units.mkdir(parents=True, exist_ok=True)
    changed = False

    def no_path(text):  # the PATH a unit was written with is the caller's; another shell's is no change
        return re.sub(r'(?m)^Environment="PATH=.*"$', "", text)
    for name in ("ci-presence.service", "ci-presence.timer"):
        text = (ROOT / "core" / "templates" / name).read_text()
        text = text.replace("@REPO@", str(LC)).replace("@PATH@", os.environ.get("PATH", "").replace("%", "%%"))
        dest = units / name
        if not (dest.is_file() and no_path(dest.read_text()) == no_path(text)):
            dest.write_text(text)
            changed = True
    if changed and systemctl("daemon-reload").returncode != 0:
        raise Fail("systemctl --user daemon-reload failed")
    if not changed and systemctl("is-enabled", "ci-presence.timer").returncode == 0:
        return say(step, "exists", str(units / "ci-presence.timer"))
    r = systemctl("enable", "--now", "ci-presence.timer")
    if r.returncode != 0:
        raise Fail(f"systemctl --user enable --now ci-presence.timer failed: {r.stderr.strip()}")
    say(step, "created", f"{units / 'ci-presence.timer'} (to keep it without a login session: loginctl "
                         "enable-linger $USER)")


def lane_worktree_warning(root: Path, installed: bool = False) -> "str | None":
    """A warning when lane-control runs from a linked worktree (a lane): the automations and the timer call scripts by
    this path, and a lane is removed when its PR merges. None for a main checkout or a copy that is not git."""
    def rev(*a):
        r = subprocess.run(["git", "-C", str(root), "rev-parse", "--path-format=absolute", *a], capture_output=True,
                           text=True)
        return r.stdout.strip() if r.returncode == 0 else ""
    git_dir, common = rev("--git-dir"), rev("--git-common-dir")
    if not git_dir or os.path.realpath(git_dir) == os.path.realpath(common):
        return None
    main = os.path.dirname(os.path.realpath(common))
    if installed:  # the paths are .../lane-control/current, but its commit is now the lane's
        return (f"{root} is a lane worktree: its commit is now this machine's installed lane-control, and existing "
                f"automations are left as they are. Run machine-setup from the main checkout ({main}) to go back")
    return (f"{root} is a lane worktree; the automations and the timer will call scripts there, and it goes when the "
            f"lane does. Run machine-setup from the main checkout ({main}) instead")


# --- host ------------------------------------------------------------------------------------------------------------

def ssh_base() -> list:
    cfg = os.environ.get("LANE_SSH_CONFIG")
    return ["ssh", "-F", os.path.expanduser(cfg)] if cfg else ["ssh"]


def on_host(host: str, argv: list) -> int:
    """Copy what machine-setup needs to the host and run it there with the same arguments minus --host."""
    try:
        u = install.use(ROOT, ask=ask)
    except install.InstallError as e:
        print(f"machine-setup: {e}; nothing was changed", file=sys.stderr)
        return 1
    if not u.sha:
        print(f"machine-setup: {ROOT} is neither a git checkout nor an install: no versioned tree to send to {host}",
              file=sys.stderr)
        return 1
    pack = subprocess.Popen(install.tar_tree(u.tree), stdout=subprocess.PIPE)
    copy = subprocess.run([*ssh_base(), host, install.box_script(u.sha, install.tree_count(u.tree))], stdin=pack.stdout, stdout=subprocess.PIPE,
                          text=True)
    pack.stdout.close()
    if pack.wait() != 0 or copy.returncode != 0:
        print(f"machine-setup: copying lane-control to {host} failed", file=sys.stderr)
        return 1
    say("lane-control", "exists" if (copy.stdout or "").startswith("exists") else "copied", f"{u.sha} on {host}")
    rec = install.config_home() / "lane-control" / "boxes" / (re.sub(r"[^A-Za-z0-9._-]", "-", host) + ".json")
    rec.parent.mkdir(parents=True, exist_ok=True)  # for lane-control doctor, as project-setup's copy writes it
    rec.write_text(json.dumps({"host": host, "lane_control": u.sha}, indent=2) + "\n")
    args, skip = [], False
    for x in argv:
        if skip:
            skip = False
        elif x == "--host":
            skip = True
        elif not x.startswith("--host="):
            args.append(x)

    def q(x):  # keep a leading ~/ for the remote shell to expand
        return "~/" + shlex.quote(x[2:]) if x.startswith("~/") else shlex.quote(x)
    cmd = install.box_run("core/scripts/machine-setup", " ".join(q(x) for x in args))
    tty = sys.stdin.isatty()
    return subprocess.run([*ssh_base(), *(["-t"] if tty else []), host, cmd.rstrip()],
                          stdin=None if tty else subprocess.DEVNULL).returncode


def main(argv) -> int:
    ap = argparse.ArgumentParser(prog="machine-setup", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--host")
    ap.add_argument("--folder", default="~/machine-coordinator")
    ap.add_argument("--machine-coordinator", default="claude/sonnet", metavar="HARNESS/MODEL")
    ap.add_argument("--permission-mode", default="auto")
    ap.add_argument("--automation-provider", choices=AUTOMATION_PROVIDERS,
                    help="the harness the three automations run on (default: the machine coordinator's)")
    ap.add_argument("--trust-folder", action="store_true")
    ap.add_argument("--no-start", action="store_true")
    ap.add_argument("--check", action="store_true",
                    help="say whether the machine coordinator's persona and its anchor are in --folder; changes nothing")
    a = ap.parse_args(argv)
    if os.geteuid() == 0:
        print("machine-setup: refusing to run as root; agents run as a normal user", file=sys.stderr)
        return 2
    try:
        harness, model = harness_model(a.machine_coordinator)
        harnesses.load_harness(harness).start_command(ROLE, Path("/x"), model, a.permission_mode)
    except (SystemExit2, ValueError) as e:
        print(f"machine-setup: {e}", file=sys.stderr)
        return 2
    if a.check:
        if a.host:
            print("machine-setup: --check reads this machine only; for a box's anchors run project-setup --check "
                  "<repo> <host>", file=sys.stderr)
            return 2
        return check(Path(os.path.expanduser(a.folder)).resolve())
    if a.host:
        return on_host(a.host, argv)
    folder = Path(os.path.expanduser(a.folder)).resolve()
    global LC
    try:
        u = install.use(ROOT, ask=ask)
    except install.InstallError as e:
        print(f"machine-setup: {e}; nothing was changed", file=sys.stderr)
        return 1
    if u.state == "kept":  # the kept tree's own machine-setup renders the persona, never this checkout's (review M7)
        print(f"machine-setup: note: running {u.tree / 'core/scripts/machine-setup'} (the kept install) instead",
              file=sys.stderr, flush=True)
        sys.stdout.flush()
        os.execv(sys.executable, [sys.executable, str(u.tree / "core" / "scripts" / "machine-setup"), *argv])
    LC = u.stable
    harnesses.PERSONA_HOOK = LC / "core" / "harnesses" / "persona-hook.sh"  # never the checkout (INST-1 review B1)
    say("lane-control", u.state, f"{u.sha or ''} at {u.stable}".strip())
    for n in u.notes:
        print(f"machine-setup: note: {n}", file=sys.stderr)
    warning = lane_worktree_warning(ROOT, installed=bool(u.sha))
    if warning:
        say("lane-control", "warning", warning)
    try:
        machine_conf()
        usage_feed()
        bd_version_step()
        cleanup_step()
        folder_step(folder)
        persona = persona_step(harness, model, folder)
        anchor_step(folder)
        if a.no_start:
            say(TITLE, "skipped", "(--no-start)")
        else:
            start_step(harness, model, a.permission_mode, folder, persona, a.trust_folder)
        provider = a.automation_provider or harness
        failed = None
        try:
            created = automations_step(folder, from_lane=bool(warning), provider=provider)
        except AutomationFail as e:
            created, failed = 0, str(e)
            say("automations", "failed", failed)
        if provider == "opencode" and created:
            say("automations", "note", "they run on OpenCode's own default model (Orca passes no model to OpenCode): "
                "set \"model\" in OpenCode's config to a <provider>/<model>"
                + (f", such as {model}, the machine coordinator's" if harness == "opencode" else "")
                + "; without one OpenCode picks a model itself")
        timer_step()
        if failed:
            print(f"machine-setup: the automations were not made: {failed}", file=sys.stderr)
            return 1
    except (Fail, ValueError, OSError) as e:
        print(f"machine-setup: {e}", file=sys.stderr)
        return 1
    print(f"summary: machine coordinator folder {folder} · {harness}/{model} · automations night manager, lane sweep, "
          f"machine check on {provider}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
