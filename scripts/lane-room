#!/usr/bin/env bash
# lane-room: is there room on this machine to open another lane? Run it before opening one; on a non-zero exit hold
# the lane and tell the owner.
#
#   lane-room       Prints available memory, CPU contention against cores, the lane agents running, and a verdict line.
#
# Too busy when: available memory is under LANE_ROOM_MIN_MEM_GB, CPU contention is over LANE_ROOM_MAX_LOAD, or
# LANE_ROOM_MAX_AGENTS lane agents are running. Idle agents cost little, so this limit is looser than the heavy-work
# gate (lane-heavy).
#
# CPU contention is the number of runnable tasks (threads in state R, from <pid>/task/<tid>/stat), counted
# LANE_ROOM_SAMPLES times LANE_ROOM_SAMPLE_SECS apart and averaged, so one instant does not decide. Left out: tasks
# under SCHED_IDLE (policy 5) and at nice 19; they only run when nothing else wants the core. Idle-priority CI does
# that, and it must not hold a lane. Nice-17 tasks (the Claude sessions) are counted. Not the 5-minute load average
# (it counts uninterruptible I/O waits and lags a burst by minutes) and not /proc/pressure/cpu (a stalled idle-priority
# task raises that as well). The name LANE_ROOM_MAX_LOAD is kept from the load-average rule.
#
# Lane agents are the Cotal agents of role lane or reviewer run by this user, counted once each however many processes
# they have, from process environments. Only those two variables are read; nothing else in an environment is kept.
#
# Limits: lane-limits.sh and limits.example.sh. Exit: 0 room; 1 too busy; 2 could not read the machine's state.
set -u
self=$(readlink -f "$0")
# shellcheck source=lane-limits.sh
. "${self%/*}/lane-limits.sh"

avail_mb=$(awk '/^MemAvailable:/ { print int($2 / 1024) }' "$LANE_PROC_DIR/meminfo" 2>/dev/null)

# One sample: "runnable idle nice19" counts. A thread that exits while we read it is skipped, never an error.
sample() {
  local stat line rest runnable=0 idle=0 nice19=0 seen=0 f
  for stat in "$LANE_PROC_DIR"/[0-9]*/task/[0-9]*/stat; do
    line=
    { IFS= read -r line <"$stat"; } 2>/dev/null || [ -n "$line" ] || continue   # the braces catch the open error too
    # comm (field 2) may hold spaces and parentheses: everything up to the last ')' is the pid and comm.
    case $line in *')'*) ;; *) continue ;; esac
    rest=${line##*)}
    read -ra f <<<"$rest"
    [ "${#f[@]}" -ge 39 ] || continue      # cut off mid-write; policy is field 41, 39th after comm
    seen=1
    [ "${f[0]}" = R ] || continue
    if [ "${f[38]}" = 5 ]; then idle=$((idle + 1))
    elif [ "${f[16]}" = 19 ]; then nice19=$((nice19 + 1))
    else runnable=$((runnable + 1)); fi
  done
  echo "$runnable $idle $nice19 $seen"
}

sum_run=0 sum_idle=0 sum_nice=0 any=0
for ((i = 0; i < LANE_ROOM_SAMPLES; i++)); do
  [ "$i" -eq 0 ] || sleep "$LANE_ROOM_SAMPLE_SECS"
  read -r r n d s < <(sample)
  sum_run=$((sum_run + r)) sum_idle=$((sum_idle + n)) sum_nice=$((sum_nice + d)) any=$((any + s))
done
if [ -z "$avail_mb" ] || [ "$any" -eq 0 ]; then
  echo "lane-room: cannot read memory or tasks from $LANE_PROC_DIR; hold the lane" >&2
  exit 2
fi
avg() { awk -v t="$1" -v n="$LANE_ROOM_SAMPLES" 'BEGIN { printf "%.1f", t / n }'; }
contention=$(avg "$sum_run")

declare -A lane_agents=()
for environ in "$LANE_PROC_DIR"/[0-9]*/environ; do
  role= id=
  {
    while IFS= read -r -d '' entry; do
      case $entry in
        COTAL_ROLE=*) role=${entry#*=} ;;
        COTAL_LIFECYCLE_UID=*) id=${entry#*=} ;;
      esac
    done <"$environ"
  } 2>/dev/null
  case $role in lane | reviewer) lane_agents[${id:-$environ}]=1 ;; esac
done
agents=${#lane_agents[@]}

avail_gb=$(awk -v m="$avail_mb" 'BEGIN { printf "%.1f", m / 1024 }')
echo "memory  ${avail_gb}G available of ${LANE_MEM_GB}G (hold under ${LANE_ROOM_MIN_MEM_GB}G)"
echo "load    $contention runnable tasks on $LANE_CORES cores (hold over $LANE_ROOM_MAX_LOAD); average of $LANE_ROOM_SAMPLES samples $LANE_ROOM_SAMPLE_SECS s apart; left out $(avg "$sum_idle") SCHED_IDLE, $(avg "$sum_nice") nice 19"
echo "lanes   $agents lane agents running (hold at $LANE_ROOM_MAX_AGENTS)"

busy=
[ "$avail_mb" -ge $((LANE_ROOM_MIN_MEM_GB * 1024)) ] || busy="$busy; memory ${avail_gb}G"
awk -v l="$contention" -v m="$LANE_ROOM_MAX_LOAD" 'BEGIN { exit !(l <= m) }' || busy="$busy; load $contention runnable"
[ "$agents" -lt "$LANE_ROOM_MAX_AGENTS" ] || busy="$busy; $agents lane agents"

if [ -n "$busy" ]; then
  echo "TOO BUSY: ${busy#; }. Hold this lane and tell the owner."
  exit 1
fi
echo "room for another lane"
