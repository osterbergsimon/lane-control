#!/usr/bin/env python3
"""`systemctl --user` (and `journalctl --user -u`) for the testbed's unprivileged containers, which have no systemd.

Runs the user units that lane-control writes (orca-tunnel-<host>.service, orcad.service, lane-tunnel@<host>.service)
from ~/.config/systemd/user well enough for its scripts: template instances (%i, %h, %%), EnvironmentFile=,
Environment=, WorkingDirectory=, ExecStart= (`$$` is `$`), Restart=always|on-failure with RestartSec= (held to at most
TESTBED_MAX_RESTART_SEC, default 5). Each started unit gets a small supervisor process; state is in
~/.local/state/testbed-systemd/. `__boot` (the container's entrypoint) starts every enabled unit. Without --user it
says there is no system manager, as in a container. Only for the testbed image: never install it on a real machine.
"""
import os
import re
import shlex
import signal
import subprocess
import sys
import time
from pathlib import Path

HOME = Path(os.environ.get("HOME", "/home/lc"))
UNITS = HOME / ".config" / "systemd" / "user"
STATE = HOME / ".local" / "state" / "testbed-systemd"
MAX_RESTART = float(os.environ.get("TESTBED_MAX_RESTART_SEC", "5"))


def unit_file(unit):
    f = UNITS / unit
    if f.exists():
        return f, ""
    m = re.match(r"^(.+@)([^.]*)(\.\w+)$", unit)
    if m and (UNITS / f"{m.group(1)}{m.group(3)}").exists():
        return UNITS / f"{m.group(1)}{m.group(3)}", m.group(2)
    return None, ""


def parse(unit):
    f, inst = unit_file(unit)
    if f is None:
        return None
    cfg = {"env": {}, "envfiles": [], "Restart": "no", "RestartSec": "0.1"}
    text = f.read_text().replace("\\\n", " ")
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith(("#", ";", "[")) or "=" not in line:
            continue
        k, v = line.split("=", 1)
        v = v.replace("%%", "\0").replace("%i", inst).replace("%I", inst).replace("%h", str(HOME)).replace("\0", "%")
        if k == "Environment":
            for item in shlex.split(v):
                ek, _, ev = item.partition("=")
                cfg["env"][ek] = ev
        elif k == "EnvironmentFile":
            cfg["envfiles"].append(v)
        else:
            cfg[k] = v
    return cfg


def env_of(cfg):
    env = dict(os.environ)
    for ef in cfg["envfiles"]:
        opt = ef.startswith("-")
        p = Path(ef.lstrip("-"))
        if not p.exists():
            if opt:
                continue
            raise FileNotFoundError(ef)
        for line in p.read_text().splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                env[k.strip()] = v
    env.update(cfg["env"])
    return env


def seconds(v):
    m = re.match(r"^([\d.]+)\s*(ms|s|min|m)?$", v.strip())
    if not m:
        return 1.0
    n = float(m.group(1))
    return {"ms": n / 1000, "min": n * 60, "m": n * 60}.get(m.group(2) or "s", n)


def alive(pid):
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:  # a zombie is not alive
        return Path(f"/proc/{pid}/stat").read_text().split(") ", 1)[1][0] != "Z"
    except OSError:
        return False


def pid_of(unit, kind="sup"):
    try:
        pid = int((STATE / f"{unit}.{kind}").read_text())
    except (OSError, ValueError):
        return None
    return pid if alive(pid) else None


def supervise(unit):
    """The unit's own process: run ExecStart, restart it as the unit says, until stopped."""
    os.setsid()
    log = open(STATE / f"{unit}.log", "a")
    child = None

    def stop(*_):
        if child and child.poll() is None:
            try:
                os.killpg(child.pid, signal.SIGTERM)
            except OSError:
                pass
            try:
                child.wait(5)
            except subprocess.TimeoutExpired:
                os.killpg(child.pid, signal.SIGKILL)
        (STATE / f"{unit}.main").unlink(missing_ok=True)
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    while True:
        cfg = parse(unit)
        if cfg is None or "ExecStart" not in cfg:
            log.write(f"{time.ctime()} {unit}: no unit file or no ExecStart\n")
            sys.exit(1)
        cmd = cfg["ExecStart"].lstrip("@-:+!").replace("$$", "\0")
        argv = [a.replace("\0", "$") for a in shlex.split(cmd)]
        try:
            env = env_of(cfg)
        except FileNotFoundError as e:
            log.write(f"{time.ctime()} {unit}: EnvironmentFile {e} missing\n")
            sys.exit(1)
        log.write(f"{time.ctime()} {unit}: starting {argv[0]}\n")
        log.flush()
        child = subprocess.Popen(argv, cwd=cfg.get("WorkingDirectory") or str(HOME), env=env, stdout=log,
                                 stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)
        (STATE / f"{unit}.main").write_text(str(child.pid))
        code = child.wait()
        (STATE / f"{unit}.main").unlink(missing_ok=True)
        log.write(f"{time.ctime()} {unit}: exited {code}\n")
        log.flush()
        if cfg["Restart"] == "always" or (cfg["Restart"] == "on-failure" and code != 0):
            time.sleep(min(seconds(cfg.get("RestartSec", "0.1")), MAX_RESTART))
            continue
        (STATE / f"{unit}.failed").write_text(str(code)) if code else None
        sys.exit(0)


def start(unit):
    if parse(unit) is None:
        print(f"Failed to start {unit}: Unit {unit} not found.", file=sys.stderr)
        return 5
    if pid_of(unit):
        return 0
    (STATE / f"{unit}.failed").unlink(missing_ok=True)
    p = subprocess.Popen([sys.executable, __file__, "__supervise", unit], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, close_fds=True)
    (STATE / f"{unit}.sup").write_text(str(p.pid))
    time.sleep(0.3)
    return 0


def stop(unit):
    pid = pid_of(unit)
    if pid:
        os.kill(pid, signal.SIGTERM)
        for _ in range(60):
            if not alive(pid):
                break
            time.sleep(0.1)
    (STATE / f"{unit}.sup").unlink(missing_ok=True)
    return 0


def active(unit):
    return bool(pid_of(unit) and pid_of(unit, "main"))


def main(argv):
    args = [a for a in argv if a not in ("--user", "--quiet", "-q", "--no-pager", "--now", "--no-block", "--full")]
    if "--user" not in argv and args[:1] != ["__boot"] and args[:1] != ["__supervise"] and args[:1] != ["--version"]:
        print("System has not been booted with systemd as init system (PID 1). Can't operate. (testbed)",
              file=sys.stderr)
        return 1
    quiet = "--quiet" in argv or "-q" in argv
    now = "--now" in argv
    STATE.mkdir(parents=True, exist_ok=True)
    UNITS.mkdir(parents=True, exist_ok=True)
    if not args:
        return 0
    op, units = args[0], [u if "." in u else u + ".service" for u in args[1:] if not u.startswith("-")]
    if op == "--version":
        print("systemd 255 (testbed shim)")
        return 0
    if op == "__supervise":
        supervise(units[0])
        return 0
    if op == "__boot":
        for f in sorted(STATE.glob("*.enabled")):
            start(f.name[:-len(".enabled")])
        return 0
    if op in ("show-environment",):
        for k in ("HOME", "PATH", "USER"):
            if k in os.environ:
                print(f"{k}={os.environ[k]}")
        return 0
    if op in ("daemon-reload", "reset-failed", "import-environment"):
        return 0
    rc = 0
    for u in units:
        if op == "enable":
            (STATE / f"{u}.enabled").write_text("")
            rc = rc or (start(u) if now else 0)
        elif op == "disable":
            (STATE / f"{u}.enabled").unlink(missing_ok=True)
            if now:
                stop(u)
        elif op == "start":
            rc = rc or start(u)
        elif op == "stop":
            stop(u)
        elif op == "restart":
            stop(u)
            rc = rc or start(u)
        elif op == "is-active":
            a = active(u)
            if not quiet:
                print("active" if a else "activating" if pid_of(u) else "inactive")
            rc = rc or (0 if a else 3)
        elif op == "is-enabled":
            e = (STATE / f"{u}.enabled").exists()
            if not quiet:
                print("enabled" if e else "disabled")
            rc = rc or (0 if e else 1)
        elif op == "status":
            a = active(u)
            print(f"● {u} - {'active (running)' if a else 'inactive (dead)'} (testbed)")
            rc = rc or (0 if a else 3)
        elif op == "cat":
            f, _ = unit_file(u)
            print(f.read_text() if f else "")
        else:
            print(f"systemctl (testbed): {op} is not modelled", file=sys.stderr)
            return 1
    return rc


def journal(argv):
    if "-u" in argv:
        u = argv[argv.index("-u") + 1]
        u = u if "." in u else u + ".service"
        p = STATE / f"{u}.log"
        print(p.read_text()[-20000:] if p.exists() else "-- No entries --")
    return 0


if __name__ == "__main__":
    if Path(sys.argv[0]).name == "journalctl":
        sys.exit(journal(sys.argv[1:]))
    sys.exit(main(sys.argv[1:]))
