# lane-control machine config: ~/.config/lane-control/machine.conf, one per machine, outside any repo. machine-setup
# writes it from this example; fill it in by hand. Shell-sourceable KEY=value. Read by night-precheck, machine-check,
# lane-sweep and lane-limits.sh (night hours and the away file's life; only plain KEY=<number> lines there).

# Coordinators on this machine, one per line: <name> <checkout path>
#   name      a stable project key, used in check-ins and stamps (letters, digits, . _ -)
#   checkout  the project's main checkout, where its coordinator runs (no spaces)
# This list is the owner's choice of whom the night manager may wake; the rest comes from Orca when it is needed.
# A coordinator's harness (claude or opencode: whose session store gives the idle time) and address (its Orca terminal:
# handle and title, also its session name for SendMessage) are its agent terminal, the single one in Orca whose folder is
# the checkout. None, or more than one: the output says which project and why, and nobody is woken for it; Orca not
# answering is said once. Nothing is guessed.
# To pick them yourself, add the third and fourth column: <name> <checkout path> <harness> <Orca terminal title>
# (the title may have spaces; a line with both never asks Orca).
# Example:
#   myproject ~/code/myproject
#   other ~/code/other claude other coordinator
COORDINATORS="
"

# owner/repo of each repo whose self-hosted runners the night manager and the machine check watch (space separated)
RUNNER_REPOS=""

# Models are open by default. The one optional restriction is about where code is sent. Owner only, by hand: no tool and
# no agent writes or edits these lines (they ship commented out; model-routing.md, "Sandbox per tier").
# The owner's own gateway (LiteLLM or similar), the provider prefix(es) its model ids use in OpenCode or LiteLLM, space
# separated. Any model reached through it, whatever model is behind it, counts as self-hosted and is never restricted
# (its base URL lives in the gateway's own config, not here).
# OWN_GATEWAY="<prefix>"
# Hosted China-region routes (OpenCode's opencode/ and opencode-go/, and vendors' own APIs such as deepseek/, moonshot/,
# zhipu/, qwen/, minimax/) run only in the one project named here, a COORDINATORS name; code sent to them may go to
# China-served servers. Empty or missing: no restriction, they run anywhere. A name nobody has: nobody.
# CHINA_REGION_MODELS_PROJECT=<name>

# Night, in local hours: from NIGHT_START to NIGHT_END (23-07 wraps past midnight).
NIGHT_START=23
NIGHT_END=7
# A coordinator is due a check-in after IDLE_MIN minutes idle, at most once every RECHECK_MIN minutes.
IDLE_MIN=45
RECHECK_MIN=120
# While improve mode is on (lane-improve on), a coordinator idle this many minutes is due a `DUE <name> improve`
# check-in to resume its cycle: a fallback for a lost wake, day or night. A coordinator that stays idle is nudged
# less often (the wait doubles, at most 8 h); after the mode ends, one that has not wrapped up gets `DUE <name> wrapup`.
IMPROVE_IDLE_MIN=30
# `lane-away on` counts for this many hours (`lane-away on --until-back` has no limit).
AWAY_HOURS=14
